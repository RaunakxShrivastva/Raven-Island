                                background: @linear-gradient(145deg, rgba(22, 22, 26, root.widgets-opacity * 0.82) 0%, rgba(5, 5, 8, root.widgets-opacity * 0.88) 100%);
                                border-width: 1px;
                                border-color: rgba(255, 255, 255, 0.13);
                                clip: true;

                                VerticalLayout {
                                    padding-left: 16px; padding-right: 16px;
                                    alignment: center;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        
                                        // Left side: Text percentage and state
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: "85%";
                                                font-size: 32px;
                                                font-weight: 760;
                                                color: white;
                                            }
                                            Text {
                                                text: "Discharging";
                                                font-size: 11px;
                                                font-weight: 600;
                                                color: rgba(255, 255, 255, 0.5);
                                            }
                                        }

                                        // Right side: Progress ring and battery graphic
                                        Rectangle {
                                            width: 56px;
                                            height: 56px;
                                            
                                            // Outer progress ring track
                                            Rectangle {
                                                width: 100%; height: 100%; border-radius: 28px;
                                                border-width: 4px; border-color: rgba(255, 255, 255, 0.08);
                                            }
                                            // Colored progress active indicator
                                            Rectangle {
                                                width: 100%; height: 100%; border-radius: 28px;
                                                border-width: 4px; border-color: #34C759;
                                            }
                                            
                                            // Battery outline inside
                                            Rectangle {
                                                width: 24px; height: 16px; border-width: 2px; border-radius: 3px; border-color: rgba(255,255,255,0.85);
                                                x: 16px; y: 20px;
                                                Rectangle {
                                                    x: 3px; y: 3px; width: 14px; height: 6px; border-radius: 1px; background: #34C759;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.selected-widget-id == "calendar_focus" : Rectangle {
                                height: 120px;
                                border-radius: root.widgets-stats-border-radius * 1px;
                                background: @linear-gradient(145deg, rgba(22, 22, 26, root.widgets-opacity * 0.82) 0%, rgba(5, 5, 8, root.widgets-opacity * 0.88) 100%);
                                border-width: 1px;
                                border-color: rgba(255, 255, 255, 0.13);
                                clip: true;

                                VerticalLayout {
                                    padding-left: 16px; padding-right: 16px;
                                    alignment: center;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        
                                        // Left side: Date info
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            
                                            HorizontalLayout {
                                                spacing: 4px;
                                                Text { text: "Thu"; font-size: 14px; font-weight: 800; color: #FF453A; }
                                                Text { text: "Sep"; font-size: 14px; font-weight: 700; color: rgba(255,255,255,0.4); }
                                            }
                                            
                                            Text {
                                                text: "11";
                                                font-size: 36px;
                                                font-weight: 720;
                                                color: white;
                                            }
                                        }
                                        
                                        // Right side: Timer ring and button
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            
                                            Rectangle {
                                                width: 56px;
                                                height: 56px;
                                                
                                                // Progress ring track
                                                Rectangle {
                                                    width: 100%; height: 100%; border-radius: 28px;
                                                    border-width: 4px; border-color: rgba(255, 255, 255, 0.08);
                                                }
                                                Rectangle {
                                                    width: 100%; height: 100%; border-radius: 28px;
                                                    border-width: 4px; border-color: #FF453A;
                                                }
                                                
                                                Text {
                                                    text: root.focus-timer-minutes + ":00";
                                                    font-size: 12px;
                                                    font-weight: 760;
                                                    color: white;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            
                                            // Focus button
                                            Rectangle {
                                                width: 48px; height: 16px; border-radius: 4px;
                                                background: rgba(10, 132, 255, 0.18);
                                                x: (parent.width - self.width) / 2;
                                                Text {
                                                    text: "FOCUS";
                                                    color: #3DA5FF;
                                                    font-size: 8px;
                                                    font-weight: 850;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.selected-widget-id == "apps_container" : Rectangle {
                                height: 120px;
                                border-radius: root.widgets-stats-border-radius * 1px;
                                background: @linear-gradient(145deg, rgba(22, 22, 26, root.widgets-opacity * 0.82) 0%, rgba(5, 5, 8, root.widgets-opacity * 0.88) 100%);
                                border-width: 1px;
                                border-color: rgba(255, 255, 255, 0.13);
                                clip: true;

                                VerticalLayout {
                                    padding-left: 16px; padding-right: 16px;
                                    alignment: center;
                                    spacing: 12px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "APPS CONTAINER"; font-size: 10px; font-weight: 950; color: #B000FF; vertical-alignment: center; }
                                        Text { text: root.widgets-locked ? "LOCKED" : "DRAG"; font-size: 9px; font-weight: 950; color: rgba(255,255,255,0.28); vertical-alignment: center; }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 12px;
                                        Rectangle { width: 32px; height: 32px; border-radius: 8px; background: #FF3B30; }
                                        Rectangle { width: 32px; height: 32px; border-radius: 8px; background: #007AFF; }
                                        Rectangle { width: 32px; height: 32px; border-radius: 8px; background: #34C759; }
                                        Rectangle { width: 32px; height: 32px; border-radius: 8px; background: #FF9500; }
                                    }
                                }
                            }

                            if root.selected-widget-id == "streak" : Rectangle {
                                height: 120px;
                                border-radius: root.widgets-stats-border-radius * 1px;
                                background: @linear-gradient(145deg, rgba(22, 22, 26, root.widgets-opacity * 0.82) 0%, rgba(5, 5, 8, root.widgets-opacity * 0.88) 100%);
                                border-width: 1px;
                                border-color: rgba(255, 255, 255, 0.13);
                                clip: true;

                                VerticalLayout {
                                    padding-left: 16px; padding-right: 16px;
                                    alignment: center;
                                    
                                    HorizontalLayout {
                                        alignment: space-between;
                                        
                                        // Left side: Mini calendar sheet icon/date
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: "MONDAY"; font-size: 12px; font-weight: 800; color: #007AFF; }
                                            Text { text: "September"; font-size: 10px; font-weight: 600; color: rgba(255,255,255,0.7); }
                                            Text { text: "07"; font-size: 36px; font-weight: 700; color: white; }
                                        }
                                        
                                        // Right side: Simulated calendar grid
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            
                                            // Header: S M T W T F S
                                            HorizontalLayout {
                                                spacing: 6px;
                                                for day in ["S", "M", "T", "W", "T", "F", "S"]: Text {
                                                    text: day; font-size: 8px; font-weight: 800; color: rgba(255,255,255,0.4); width: 10px; horizontal-alignment: center;
                                                }
                                            }
                                            
                                            // Grid row 1
                                            HorizontalLayout {
                                                spacing: 6px;
                                                for val in [1, 2, 3, 4, 5, 6, 7]: Rectangle {
                                                    width: 10px; height: 10px; border-radius: 5px;
                                                    background: val == 7 ? #007AFF : rgba(255, 255, 255, 0.05);
                                                }
                                            }
                                            
                                            // Grid row 2
                                            HorizontalLayout {
                                                spacing: 6px;
                                                for val in [8, 9, 10, 11, 12, 13, 14]: Rectangle {
                                                    width: 10px; height: 10px; border-radius: 5px;
                                                    background: rgba(255, 255, 255, 0.05);
                                                }
                                            }
                                            
                                            // Grid row 3
                                            HorizontalLayout {
                                                spacing: 6px;
                                                for val in [15, 16, 17, 18, 19, 20, 21]: Rectangle {
                                                    width: 10px; height: 10px; border-radius: 5px;
                                                    background: rgba(255, 255, 255, 0.05);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.selected-widget-id == "focus_score" : Rectangle {
                                height: 120px;
                                border-radius: root.widgets-stats-border-radius * 1px;
                                background: @linear-gradient(145deg, rgba(22, 22, 26, root.widgets-opacity * 0.82) 0%, rgba(5, 5, 8, root.widgets-opacity * 0.88) 100%);
                                border-width: 1px;
                                border-color: rgba(255, 255, 255, 0.13);
                                clip: true;

                                VerticalLayout {
                                    padding-left: 16px; padding-right: 16px;
                                    alignment: center;
                                    
                                    HorizontalLayout {
                                        alignment: space-between;
                                        
                                        // Left side: Total Focus score/label
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: "FOCUS SCORE"; font-size: 10px; font-weight: 900; color: rgba(255,255,255,0.6); }
                                            Text { text: "120m"; font-size: 28px; font-weight: 950; color: white; }
                                            Text { text: "Total Focus"; font-size: 10px; color: rgba(255,255,255,0.4); }
                                        }
                                        
                                        // Right side: Score ring
                                        VerticalLayout {
                                            alignment: center;
                                            
                                            Rectangle {
                                                width: 56px;
                                                height: 56px;
                                                
                                                // Progress ring track
                                                Rectangle {
                                                    width: 100%; height: 100%; border-radius: 28px;
                                                    border-width: 4px; border-color: rgba(255, 255, 255, 0.08);
                                                }
                                                Rectangle {
                                                    width: 100%; height: 100%; border-radius: 28px;
                                                    border-width: 4px; border-color: #a855f7;
                                                }
                                                
                                                Text {
                                                    text: "85";
                                                    font-size: 16px;
                                                    font-weight: 950;
                                                    color: white;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Switcher (General / Appearance)
                            Rectangle {
                                background: rgba(255,255,255,0.03);
                                border-radius: 8px;
                                height: 32px;
                                HorizontalLayout {
                                    padding: 2px;
                                    Rectangle {
                                        height: 28px; horizontal-stretch: 1; border-radius: 6px;
                                        background: root.widget-tab-select == "general" ? rgba(255,255,255,0.06) : transparent;
                                        Text { text: "General"; color: white; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.widget-tab-select = "general"; } }
                                    }
                                    Rectangle {
                                        height: 28px; horizontal-stretch: 1; border-radius: 6px;
                                        background: root.widget-tab-select == "appearance" ? rgba(255,255,255,0.06) : transparent;
                                        Text { text: "Appearance"; color: white; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.widget-tab-select = "appearance"; } }
                                    }
                                }
                            }
                            
                            // Scrollable Controls taking all remaining vertical space
                            ScrollView {
                                vertical-stretch: 1;
                                width: 100%;
                                
                                VerticalLayout {
                                    spacing: 14px;
                                    alignment: start;
                                    width: 100%;
                                    
                                    if root.widget-tab-select == "general": VerticalLayout {
                                        spacing: 14px;
                                        width: 100%;
                                        
                                        // Enable Widget Instance
                                        CompactToggleRow {
                                            label: "Enable Widget Instance";
                                            checked: root.selected-widget-id == "year_progress" ? 
                                                (root.widgets-enabled && root.widgets-year-progress-enabled) : (
                                                root.selected-widget-id == "day_progress" ? 
                                                (root.widgets-enabled && root.widgets-day-progress-enabled) : (
                                                root.selected-widget-id == "month_progress" ? 
                                                (root.widgets-enabled && root.widgets-month-progress-enabled) : (
                                                root.selected-widget-id == "media" ? 
                                                (root.widgets-enabled && root.widgets-media-enabled) : (
                                                root.selected-widget-id == "notes" ? 
                                                (root.widgets-enabled && root.widgets-notes-enabled) : (
                                                root.selected-widget-id == "todo" ? 
                                                (root.widgets-enabled && root.widgets-todo-enabled) : (
                                                root.selected-widget-id == "quotes" ? 
                                                (root.widgets-enabled && root.widgets-quotes-enabled) : (
                                                root.selected-widget-id == "picture" ? 
                                                (root.widgets-enabled && root.widgets-picture-enabled) : (
                                                root.selected-widget-id == "video" ? 
                                                (root.widgets-enabled && root.widgets-video-enabled) : (
                                                root.selected-widget-id == "battery" ? 
                                                (root.widgets-enabled && root.widgets-battery-enabled) : (
                                                root.selected-widget-id == "calendar_focus" ? 
                                                (root.widgets-enabled && root.widgets-calendar-focus-enabled) : 
                                                (root.widgets-enabled && root.widgets-stats-enabled)
                                                ))))))))));
                                            toggled(v) => {
                                                if root.selected-widget-id == "year_progress" {
                                                    if v {
                                                        root.widgets-enabled = true;
                                                        root.widgets-year-progress-enabled = true;
                                                        root.bool_setting_changed("widgets-enabled", true);
                                                        root.bool_setting_changed("widgets-year-progress-enabled", true);
                                                    } else {
                                                        root.widgets-year-progress-enabled = false;
                                                        root.bool_setting_changed("widgets-year-progress-enabled", false);
                                                    }
                                                } else if root.selected-widget-id == "day_progress" {
                                                    if v {
                                                        root.widgets-enabled = true;
                                                        root.widgets-day-progress-enabled = true;
                                                        root.bool_setting_changed("widgets-enabled", true);
                                                        root.bool_setting_changed("widgets-day-progress-enabled", true);
                                                    } else {
                                                        root.widgets-day-progress-enabled = false;
                                                        root.bool_setting_changed("widgets-day-progress-enabled", false);
                                                    }
                                                } else if root.selected-widget-id == "month_progress" {
                                                    if v {
                                                        root.widgets-enabled = true;
                                                        root.widgets-month-progress-enabled = true;
                                                        root.bool_setting_changed("widgets-enabled", true);
                                                        root.bool_setting_changed("widgets-month-progress-enabled", true);
                                                    } else {
                                                        root.widgets-month-progress-enabled = false;
                                                        root.bool_setting_changed("widgets-month-progress-enabled", false);
                                                    }
                                                } else if root.selected-widget-id == "media" {
                                                    if v {
                                                        root.widgets-enabled = true;
                                                        root.widgets-media-enabled = true;
                                                        root.bool_setting_changed("widgets-enabled", true);
                                                        root.bool_setting_changed("widgets-media-enabled", true);
                                                    } else {
                                                        root.widgets-media-enabled = false;
                                                        root.bool_setting_changed("widgets-media-enabled", false);
                                                    }
                                                } else if root.selected-widget-id == "notes" {
                                                    if v {
                                                        root.widgets-enabled = true;
                                                        root.widgets-notes-enabled = true;
                                                        root.bool_setting_changed("widgets-enabled", true);
                                                        root.bool_setting_changed("widgets-notes-enabled", true);
                                                    } else {
                                                        root.widgets-notes-enabled = false;
                                                        root.bool_setting_changed("widgets-notes-enabled", false);
                                                    }
                                                } else if root.selected-widget-id == "todo" {
                                                    if v {
                                                        root.widgets-enabled = true;
                                                        root.widgets-todo-enabled = true;
                                                        root.bool_setting_changed("widgets-enabled", true);
                                                        root.bool_setting_changed("widgets-todo-enabled", true);
                                                    } else {
                                                        root.widgets-todo-enabled = false;
                                                        root.bool_setting_changed("widgets-todo-enabled", false);
                                                    }
                                                } else if root.selected-widget-id == "quotes" {
                                                    if v {
                                                        root.widgets-enabled = true;
                                                        root.widgets-quotes-enabled = true;
                                                        root.bool_setting_changed("widgets-enabled", true);
                                                        root.bool_setting_changed("widgets-quotes-enabled", true);
                                                    } else {
                                                        root.widgets-quotes-enabled = false;
                                                        root.bool_setting_changed("widgets-quotes-enabled", false);
                                                    }
                                                } else if root.selected-widget-id == "picture" {
                                                    if v {
                                                        root.widgets-enabled = true;
                                                        root.widgets-picture-enabled = true;
                                                        root.bool_setting_changed("widgets-enabled", true);
                                                        root.bool_setting_changed("widgets-picture-enabled", true);
                                                    } else {
                                                        root.widgets-picture-enabled = false;
                                                        root.bool_setting_changed("widgets-picture-enabled", false);
                                                    }
                                                } else if root.selected-widget-id == "video" {
                                                    if v {
                                                        root.widgets-enabled = true;
                                                        root.widgets-video-enabled = true;
                                                        root.bool_setting_changed("widgets-enabled", true);
                                                        root.bool_setting_changed("widgets-video-enabled", true);
                                                    } else {
                                                        root.widgets-video-enabled = false;
                                                        root.bool_setting_changed("widgets-video-enabled", false);
                                                     }
                                                 } else if root.selected-widget-id == "battery" {
                                                    if v {
                                                        root.widgets-enabled = true;
                                                        root.widgets-battery-enabled = true;
                                                        root.bool_setting_changed("widgets-enabled", true);
                                                        root.bool_setting_changed("widgets-battery-enabled", true);
                                                    } else {
                                                        root.widgets-battery-enabled = false;
                                                        root.bool_setting_changed("widgets-battery-enabled", false);
                                                    }
                                                } else if root.selected-widget-id == "calendar_focus" {
                                                    if v {
                                                        root.widgets-enabled = true;
                                                        root.widgets-calendar-focus-enabled = true;
                                                        root.bool_setting_changed("widgets-enabled", true);
                                                        root.bool_setting_changed("widgets-calendar-focus-enabled", true);
                                                    } else {
                                                        root.widgets-calendar-focus-enabled = false;
                                                        root.bool_setting_changed("widgets-calendar-focus-enabled", false);
                                                    }
                                                } else {
                                                    if v {
                                                        root.widgets-enabled = true;
                                                        root.widgets-stats-enabled = true;
                                                        root.bool_setting_changed("widgets-enabled", true);
                                                        root.bool_setting_changed("widgets-stats-enabled", true);
                                                    } else {
                                                        root.widgets-stats-enabled = false;
                                                        root.bool_setting_changed("widgets-stats-enabled", false);
                                                    }
                                                }
                                            }
                                        }
                                        
                                        Divider {}
                                        
                                        CompactToggleRow {
                                            label: "Enable Master Widgets Engine";
                                            checked <=> root.widgets-enabled;
                                            toggled(v) => { root.bool_setting_changed("widgets-enabled", v); }
                                        }
                                        
                                        Divider {}
                                        
                                        CompactToggleRow {
                                            label: "Lock Position";
                                            checked <=> root.widgets-locked;
                                            toggled(v) => { root.bool_setting_changed("widgets-locked", v); }
                                        }
                                        
                                        Divider {}
                                        
                                        CompactToggleRow {
                                            label: "Click-Through (Ignore Mouse Clicks)";
                                            checked <=> root.widgets-click-through;
                                            toggled(v) => { root.bool_setting_changed("widgets-click-through", v); }
                                        }
                                        
                                        if root.selected-widget-id == "stats" : VerticalLayout {
                                            spacing: 14px;
                                            
                                            Divider {}

                                            // Dynamic Column Customizations
                                            CompactToggleRow {
                                                label: "Use 24-Hour Format";
                                                checked <=> root.widgets-stats-show-cpu;
                                                toggled(v) => { root.bool_setting_changed("widgets-stats-show-cpu", v); }
                                            }
                                            
                                            CompactToggleRow {
                                                label: "Show Seconds";
                                                checked <=> root.widgets-stats-show-ram;
                                                toggled(v) => { root.bool_setting_changed("widgets-stats-show-ram", v); }
                                            }
                                            
                                            CompactToggleRow {
                                                label: "Show AM/PM Label";
                                                checked <=> root.widgets-stats-show-battery;
                                                toggled(v) => { root.bool_setting_changed("widgets-stats-show-battery", v); }
                                            }
                                            
                                            Divider {}
                                            
                                            // Color Customizations
                                            Text { text: "CLOCK TEXT ACCENT COLOR"; font-size: 10px; font-weight: 800; color: rgba(255,255,255,0.4); }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: start;
                                                Rectangle {
                                                    width: 18px; height: 18px; border-radius: 9px; background: #FFFFFF;
                                                    border-color: root.widgets-stats-cpu-color == #FFFFFF ? white : transparent; border-width: 2px;
                                                    TouchArea { clicked => { root.widgets-stats-cpu-color = #FFFFFF; root.string_setting_changed("widgets-stats-cpu-color", "#FFFFFF"); } }
                                                }
                                                Rectangle {
                                                    width: 18px; height: 18px; border-radius: 9px; background: #FF2D55;
                                                    border-color: root.widgets-stats-cpu-color == #FF2D55 ? white : transparent; border-width: 2px;
                                                    TouchArea { clicked => { root.widgets-stats-cpu-color = #FF2D55; root.string_setting_changed("widgets-stats-cpu-color", "#FF2D55"); } }
                                                }
                                                Rectangle {
                                                    width: 18px; height: 18px; border-radius: 9px; background: #00E5FF;
                                                    border-color: root.widgets-stats-cpu-color == #00E5FF ? white : transparent; border-width: 2px;
                                                    TouchArea { clicked => { root.widgets-stats-cpu-color = #00E5FF; root.string_setting_changed("widgets-stats-cpu-color", "#00E5FF"); } }
                                                }
                                                Rectangle {
                                                    width: 18px; height: 18px; border-radius: 9px; background: #FFCC00;
                                                    border-color: root.widgets-stats-cpu-color == #FFCC00 ? white : transparent; border-width: 2px;
                                                    TouchArea { clicked => { root.widgets-stats-cpu-color = #FFCC00; root.string_setting_changed("widgets-stats-cpu-color", "#FFCC00"); } }
                                                }
                                                Rectangle {
                                                    width: 18px; height: 18px; border-radius: 9px; background: #A000FF;
                                                    border-color: root.widgets-stats-cpu-color == #A000FF ? white : transparent; border-width: 2px;
                                                    TouchArea { clicked => { root.widgets-stats-cpu-color = #A000FF; root.string_setting_changed("widgets-stats-cpu-color", "#A000FF"); } }
                                                }
                                                Rectangle {
                                                    width: 18px; height: 18px; border-radius: 9px; background: #34C759;
                                                    border-color: root.widgets-stats-cpu-color == #34C759 ? white : transparent; border-width: 2px;
                                                    TouchArea { clicked => { root.widgets-stats-cpu-color = #34C759; root.string_setting_changed("widgets-stats-cpu-color", "#34C759"); } }
                                                }
                                            }
                                        }

                                        if root.selected-widget-id == "notes" : VerticalLayout {
                                            spacing: 14px;
                                            
                                            Divider {}
                                            
                                            Text { text: "NOTE ACTIONS"; font-size: 10px; font-weight: 800; color: rgba(255,255,255,0.4); }
                                            
                                            Rectangle {
                                                width: 100%; height: 34px; border-radius: 6px; background: rgba(255, 255, 255, 0.05);
                                                Text { text: "Clear Notepad Content"; color: white; font-size: 11px; font-weight: 700; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea {
                                                    clicked => {
                                                        root.string_setting_changed("widgets-notes-text", "");
                                                    }
                                                }
                                            }
                                        }

                                        if root.selected-widget-id == "todo" : VerticalLayout {
                                            spacing: 14px;
                                            
                                            Divider {}
                                            
                                            CompactToggleRow {
                                                label: "Hide Completed Tasks";
                                                checked <=> root.todo-hide-completed;
                                                toggled(v) => { root.bool_setting_changed("todo-hide-completed", v); }
                                            }
                                            
                                            Divider {}
                                            
                                            Text { text: "ACCENT THEME COLOR"; font-size: 10px; font-weight: 800; color: rgba(255,255,255,0.4); }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: start;
                                                Rectangle {
                                                    width: 18px; height: 18px; border-radius: 9px; background: #FF9500;
                                                    border-color: root.todo-accent-color-str == "#FF9500" ? white : transparent; border-width: 2px;
                                                    TouchArea { clicked => { root.todo-accent-color-str = "#FF9500"; root.string_setting_changed("todo-accent-color-str", "#FF9500"); } }
                                                }
                                                Rectangle {
                                                    width: 18px; height: 18px; border-radius: 9px; background: #FF2D55;
                                                    border-color: root.todo-accent-color-str == "#FF2D55" ? white : transparent; border-width: 2px;
                                                    TouchArea { clicked => { root.todo-accent-color-str = "#FF2D55"; root.string_setting_changed("todo-accent-color-str", "#FF2D55"); } }
                                                }
                                                Rectangle {
                                                    width: 18px; height: 18px; border-radius: 9px; background: #00E5FF;
                                                    border-color: root.todo-accent-color-str == "#00E5FF" ? white : transparent; border-width: 2px;
                                                    TouchArea { clicked => { root.todo-accent-color-str = "#00E5FF"; root.string_setting_changed("todo-accent-color-str", "#00E5FF"); } }
                                                }
                                                Rectangle {
                                                    width: 18px; height: 18px; border-radius: 9px; background: #FFCC00;
                                                    border-color: root.todo-accent-color-str == "#FFCC00" ? white : transparent; border-width: 2px;
                                                    TouchArea { clicked => { root.todo-accent-color-str = "#FFCC00"; root.string_setting_changed("todo-accent-color-str", "#FFCC00"); } }
                                                }
                                            }
                                            
                                            Divider {}
                                            
                                            Text { text: "TASK ACTIONS"; font-size: 10px; font-weight: 800; color: rgba(255,255,255,0.4); }
                                            Rectangle {
                                                width: 100%; height: 34px; border-radius: 6px; background: rgba(255, 69, 58, 0.15);
                                                Text { text: "Clear All Completed Tasks"; color: #FF453A; font-size: 11px; font-weight: 700; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea {
                                                    clicked => {
                                                        root.settings_todo_clear_completed();
                                                    }
                                                }
                                            }
                                        }

                                        if root.selected-widget-id == "quotes" : VerticalLayout {
                                            spacing: 14px;
                                            
                                            Divider {}
                                            
                                            CompactToggleRow {
                                                label: "Enable Default Cycle";
                                                checked <=> root.quotes-cycle-enabled;
                                                toggled(v) => { root.bool_setting_changed("quotes-cycle-enabled", v); }
                                            }
                                            
                                            Divider {}
                                            
                                            CompactSliderRow {
                                                label: "Quotes Cycle Interval";
                                                value <=> root.quotes-interval-mins;
                                                min-value: 1; max-value: 120; unit: "m";
                                                value_changed(v) => { root.int_setting_changed("quotes-interval-mins", v); }
                                            }
                                            
                                            Divider {}
                                            
                                            Text { text: "ADD CUSTOM QUOTE"; font-size: 10px; font-weight: 800; color: rgba(255,255,255,0.4); }
                                            
                                            Text { text: "Quote Text"; font-size: 9px; font-weight: 700; color: rgba(255,255,255,0.5); }
                                            Rectangle {
                                                width: 100%; height: 36px;
                                                background: rgba(255,255,255,0.03);
                                                border-color: rgba(255,255,255,0.06);
                                                border-width: 1px;
                                                border-radius: 8px;
                                                TextInput {
                                                    text <=> root.quotes-new-text;
                                                    color: white;
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    single-line: true;
                                                }
                                            }
                                            
                                            Text { text: "Author"; font-size: 9px; font-weight: 700; color: rgba(255,255,255,0.5); }
                                            Rectangle {
                                                width: 100%; height: 30px;
                                                background: rgba(255,255,255,0.03);
                                                border-color: rgba(255,255,255,0.06);
                                                border-width: 1px;
                                                border-radius: 8px;
                                                TextInput {
                                                    text <=> root.quotes-new-author;
                                                    color: white;
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    single-line: true;
                                                }
                                            }
                                            
                                            Rectangle {
                                                width: 100%; height: 34px; border-radius: 6px; background: rgba(255, 255, 255, 0.05);
                                                Text { text: "Add Custom Quote"; color: white; font-size: 11px; font-weight: 700; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea {
                                                    clicked => {
                                                        if root.quotes-new-text != "" {
                                                            root.settings_quotes_add_custom(root.quotes-new-text, root.quotes-new-author);
                                                            root.quotes-new-text = "";
                                                            root.quotes-new-author = "";
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        if root.selected-widget-id == "picture" : VerticalLayout {
                                            spacing: 14px;
                                            
                                            Divider {}
                                            
                                            Text { text: "SELECTED PICTURE PATH"; font-size: 10px; font-weight: 800; color: rgba(255,255,255,0.4); }
                                            
                                            Rectangle {
                                                width: 100%; height: 36px;
                                                background: rgba(255,255,255,0.02);
                                                border-color: rgba(255,255,255,0.05);
                                                border-width: 1px;
                                                border-radius: 8px;
                                                
                                                Text {
                                                    text: root.picture-selected-path == "" ? "No image selected" : root.picture-selected-path;
                                                    color: rgba(255, 255, 255, 0.7);
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                    x: 8px;
                                                    width: parent.width - 16px;
                                                    overflow: elide;
                                                }
                                            }
                                            
                                            Rectangle {
                                                width: 100%; height: 34px; border-radius: 6px; background: rgba(255, 255, 255, 0.05);
                                                Text { text: "Browse Image..."; color: white; font-size: 11px; font-weight: 700; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea {
                                                    clicked => {
                                                        root.settings_picture_select_image();
                                                    }
                                                }
                                            }
                                        }

                                        if root.selected-widget-id == "video" : VerticalLayout {
                                            spacing: 14px;
                                            
                                            Divider {}
                                            
                                            Text { text: "SELECTED VIDEO OR GIF PATH"; font-size: 10px; font-weight: 800; color: rgba(255,255,255,0.4); }
                                            
                                            Rectangle {
                                                width: 100%; height: 36px;
                                                background: rgba(255,255,255,0.02);
                                                border-color: rgba(255,255,255,0.05);
                                                border-width: 1px;
                                                border-radius: 8px;
                                                
                                                Text {
                                                    text: root.video-selected-path == "" ? "No media selected" : root.video-selected-path;
                                                    color: rgba(255, 255, 255, 0.7);
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                    x: 8px;
                                                    width: parent.width - 16px;
                                                    overflow: elide;
                                                }
                                            }
                                            
                                            Rectangle {
                                                width: 100%; height: 34px; border-radius: 6px; background: rgba(255, 255, 255, 0.05);
                                                Text { text: "Browse GIF or Video..."; color: white; font-size: 11px; font-weight: 700; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea {
                                                    clicked => {
                                                        root.settings_video_select_media();
                                                    }
                                                }
                                            }
                                        }

                                        if root.selected-widget-id == "battery" : VerticalLayout {
                                            spacing: 14px;
                                            
                                            Divider {}
                                            
                                            Text {
                                                text: "Battery widget displays real-time battery status and charging state of your device.";
                                                font-size: 11px;
                                                color: rgba(255, 255, 255, 0.6);
                                                wrap: word-wrap;
                                            }
                                        }

                                        if root.selected-widget-id == "calendar_focus" : VerticalLayout {
                                            spacing: 14px;
                                            
                                            Divider {}
                                            
                                            CompactSliderRow {
                                                label: "Focus Timer Duration";
                                                value <=> root.focus-timer-minutes;
                                                min-value: 1; max-value: 60; unit: "m";
                                                value_changed(v) => { root.int_setting_changed("focus-timer-minutes", v); }
                                            }
                                        }
                                    }
                                    
                                    if root.widget-tab-select == "appearance": VerticalLayout {
                                        spacing: 14px;
                                        width: 100%;
                                        
                                        CompactSliderRow {
                                            label: "Widget Background Opacity";
                                            value: round(root.widgets-opacity * 100);
                                            min-value: 10; max-value: 100; unit: "%";
                                            value_changed(v) => { root.widgets-opacity = v / 100.0; root.int_setting_changed("widgets-opacity", v); }
                                        }
                                        
                                        Divider {}
                                        
                                        CompactSliderRow {
                                            label: "Widget Corner Radius";
                                            value <=> root.widgets-stats-border-radius;
                                            min-value: 0; max-value: 40; unit: "px";
                                            value_changed(v) => { root.int_setting_changed("widgets-stats-border-radius", v); }
                                        }
                                    }
                                }
                            }
                            
                            // Bottom Action Buttons
                            VerticalLayout {
                                spacing: 10px;
                                width: 100%;
                                
                                Rectangle {
                                    width: 100%; height: 38px; border-radius: 8px; background: rgba(255,255,255,0.04);
                                    Text { text: "Reset to Default"; color: rgba(255,255,255,0.6); font-size: 11px; font-weight: 700; width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => {
                                        root.widgets-stats-show-cpu = false; root.bool_setting_changed("widgets-stats-show-cpu", false);
                                        root.widgets-stats-show-ram = false; root.bool_setting_changed("widgets-stats-show-ram", false);
                                        root.widgets-stats-show-battery = true; root.bool_setting_changed("widgets-stats-show-battery", true);
                                        root.widgets-stats-show-percentage = true; root.bool_setting_changed("widgets-stats-show-percentage", true);
                                        root.widgets-stats-cpu-color = #FFFFFF; root.string_setting_changed("widgets-stats-cpu-color", "#FFFFFF");
                                        root.widgets-stats-ram-color = #AF52DE; root.string_setting_changed("widgets-stats-ram-color", "#AF52DE");
                                        root.widgets-stats-battery-color = #34C759; root.string_setting_changed("widgets-stats-battery-color", "#34C759");
                                        root.widgets-stats-border-radius = 24; root.int_setting_changed("widgets-stats-border-radius", 24);
                                        root.widgets-opacity = 0.85; root.int_setting_changed("widgets-opacity", 85);
                                        root.settings_widgets_apply_changes();
                                    } }
                                }
                                
                                Rectangle {
                                    width: 100%; height: 38px; border-radius: 8px;
                                    background: #A000FF;
                                    
                                    Text { text: "Apply Changes"; color: white; font-size: 11px; font-weight: 800; width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => {
                                        root.settings_widgets_apply_changes();
                                    } }
                                }
                            }
                        }
                    }
                }



                // -- 9. ADVANCED ----------------------
                if root.active-tab == "advanced": VerticalLayout {
                    spacing: 20px;
                    alignment: start;

                    Text { text: "Advanced"; font-size: 38px; font-weight: 900; color: white; }

                    SectionIntro {
                        tag: "WINDOW RESERVATION & SYSTEM";
                        tag-color: #00E5FF;
                        description: "Configure workspace reservation, horizontal bar layout, and startup settings.";
                    }

                    SettingGroup {
                        label: "Window Reservation";
                        
                        ToggleRow {
                            label: "Keep apps below Raven Notch";
                            checked <=> root.advanced-reserve-top-area;
                            toggled(v) => { root.bool_setting_changed("advanced-reserve-top-area", v); }
                        }
                        
                        Divider {}
                        
                        ToggleRow {
                            label: "Full horizontal bar";
                            checked <=> root.advanced-full-width-bar;
                            toggled(v) => { root.bool_setting_changed("advanced-full-width-bar", v); }
                        }
                        
                        Divider {}
                        
                        ToggleRow {
                            label: "Show top bar widgets";
                            checked <=> root.advanced-top-bar-widgets;
                            enabled: root.advanced-full-width-bar;
                            toggled(v) => { root.bool_setting_changed("advanced-top-bar-widgets", v); }
                        }
                        
                        if root.advanced-full-width-bar: Divider {}
                        
                        if root.advanced-full-width-bar: SliderRow {
                            label: "Bezel Transparency";
                            value: round((1.0 - root.advanced-bezel-opacity) * 100);
                            min-value: 0;
                            max-value: 90;
                            unit: "%";
                            value_changed(v) => {
                                root.advanced-bezel-opacity = (100.0 - v) / 100.0;
                                root.int_setting_changed("advanced-bezel-opacity", round(100.0 - v));
                            }
                        }
                    }

                    if root.advanced-top-bar-widgets && root.advanced-full-width-bar: SettingGroup {
                        label: "Top Bar Widgets";

                        ToggleRow {
                            label: "Raven Button";
                            checked <=> root.advanced-top-bar-widget-raven;
                            toggled(v) => { root.bool_setting_changed("advanced-top-bar-widget-raven", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Media Player";
                            checked <=> root.advanced-top-bar-widget-media;
                            toggled(v) => { root.bool_setting_changed("advanced-top-bar-widget-media", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Active Apps";
                            checked <=> root.advanced-top-bar-widget-apps;
                            toggled(v) => { root.bool_setting_changed("advanced-top-bar-widget-apps", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "System Stats";
                            checked <=> root.advanced-top-bar-widget-stats;
                            toggled(v) => { root.bool_setting_changed("advanced-top-bar-widget-stats", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Clipboard";
                            checked <=> root.advanced-top-bar-widget-clipboard;
                            toggled(v) => { root.bool_setting_changed("advanced-top-bar-widget-clipboard", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Volume";
                            checked <=> root.advanced-top-bar-widget-volume;
                            toggled(v) => { root.bool_setting_changed("advanced-top-bar-widget-volume", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "WiFi";
                            checked <=> root.advanced-top-bar-widget-wifi;
                            toggled(v) => { root.bool_setting_changed("advanced-top-bar-widget-wifi", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Battery";
                            checked <=> root.advanced-top-bar-widget-battery;
                            toggled(v) => { root.bool_setting_changed("advanced-top-bar-widget-battery", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Timer / Stopwatch";
                            checked <=> root.advanced-top-bar-widget-timer;
                            toggled(v) => { root.bool_setting_changed("advanced-top-bar-widget-timer", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Calendar / Date";
                            checked <=> root.advanced-top-bar-widget-calendar;
                            toggled(v) => { root.bool_setting_changed("advanced-top-bar-widget-calendar", v); }
                        }
                    }
                }

                // -- 10. ABOUT ----------------------
                if root.active-tab == "system": VerticalLayout {
                    spacing: 20px;
                    alignment: start;

                    Text { text: "About"; font-size: 38px; font-weight: 900; color: white; }

                    SectionIntro {
                        tag: "ABOUT RAVEN";
                        tag-color: #00E5FF;
                        description: "Learn more about Raven Notch and access community links.";
                    }

                    // Logo + Version + Copyright block
                    VerticalLayout {
                        alignment: center;
                        spacing: 12px;
                        padding-top: 24px;
                        padding-bottom: 24px;

                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("assets/app_logo.png");
                                width: 96px;
                                height: 96px;
                            }
                        }

                        Text {
                            text: "Raven Notch";
                            font-size: 24px;
                            font-weight: 900;
                            color: white;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.app-version-string + " (Beta)";
                            font-size: 13px;
                            font-weight: 700;
                            color: rgba(255, 255, 255, 0.5);
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "© 2026 Raven. All Rights Reserved.";
                            font-size: 11px;
                            font-weight: 500;
                            color: rgba(255, 255, 255, 0.35);
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Made with love by Raunak Shrivastava!";
                            font-size: 11px;
                            font-weight: 500;
                            color: rgba(255, 255, 255, 0.35);
                            horizontal-alignment: center;
                        }
                    }

                    // Updates Card
                    SettingGroup {
                        label: "Raven Updates";

                        HorizontalLayout {
                            padding-left: 30px;
                            padding-right: 30px;
                            padding-top: 18px;
                            padding-bottom: 18px;
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: root.update-available ? #ff453a : #34c759;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: root.app-version-string;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: white;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                if root.about-update-status != "": Text {
                                    text: root.about-update-status;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: root.update-available ? #ff9500 : #34c759;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    width: root.update-available ? 125px : 100px;
                                    height: 30px;
                                    border-radius: 15px;
                                    background: rgba(255,255,255,0.05);
                                    border-color: rgba(255,255,255,0.1);
                                    border-width: 1px;

                                    Text {
                                        text: root.update-button-text != "" ? root.update-button-text : (root.update-available ? "Download update" : (root.about-update-status == "Checking..." ? "Checking..." : "Check now"));
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: white;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.check-updates();
                                        }
                                    }
                                }
                            }
                        }
                    }


                    // Changelog Card
                    SettingGroup {
                        label: "Changelog";

                        Rectangle {
                            height: 60px;
                            background: parent-touch-changelog.has-hover ? rgba(255,255,255,0.03) : transparent;

                            HorizontalLayout {
                                padding-left: 30px;
                                padding-right: 30px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    Text {
                                        text: "📑";
                                        font-size: 16px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Open Changelog";
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: white;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "→";
                                    font-size: 14px;
                                    color: rgba(255,255,255,0.3);
                                    vertical-alignment: center;
                                }
                            }

                            parent-touch-changelog := TouchArea {
                                clicked => {
                                    root.open-url("https://ravennotch.me#changelog");
                                }
                            }
                        }
                    }

                    // Links Card
                    SettingGroup {
                        label: "Links";

                        VerticalLayout {
                            // Link 1: Website
                            Rectangle {
                                height: 50px;
                                background: parent-touch-web.has-hover ? rgba(255,255,255,0.03) : transparent;
                                HorizontalLayout {
                                    padding-left: 30px; padding-right: 30px; alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 12px; alignment: start;
                                        Text { text: "🌐"; font-size: 15px; vertical-alignment: center; }
                                        Text { text: "Website"; font-size: 13px; font-weight: 600; color: white; vertical-alignment: center; }
                                    }
                                    Text { text: "↗"; font-size: 12px; color: rgba(255,255,255,0.3); vertical-alignment: center; }
                                }
                                parent-touch-web := TouchArea { clicked => { root.open-url("https://ravennotch.me"); } }
                            }
                            Divider {}
                            // Link 2: Send Feedback
                            Rectangle {
                                height: 50px;
                                background: parent-touch-fb.has-hover ? rgba(255,255,255,0.03) : transparent;
                                HorizontalLayout {
                                    padding-left: 30px; padding-right: 30px; alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 12px; alignment: start;
                                        Text { text: "💬"; font-size: 15px; vertical-alignment: center; }
                                        Text { text: "Send Feedback"; font-size: 13px; font-weight: 600; color: white; vertical-alignment: center; }
                                    }
                                    Text { text: "↗"; font-size: 12px; color: rgba(255,255,255,0.3); vertical-alignment: center; }
                                }
                                parent-touch-fb := TouchArea { clicked => { root.open-url("https://ravennotch.me/#feedback"); } }
                            }

                        }
                    }
                }
                } // close empty-search conditional block
                
                // --- SEARCH RESULTS VIEW ---
                if root.search-query != "": VerticalLayout {
                    spacing: 20px;
                    alignment: start;
                    
                    Text { text: "Search Results"; font-size: 38px; font-weight: 900; color: white; }
                    Text { text: "Found " + root.search-results.length + " matching setting(s)"; font-size: 13px; color: rgba(255,255,255,0.4); }
                    
                    Rectangle { height: 8px; }
                    
                    if root.search-results.length == 0: VerticalLayout {
                        alignment: center;
                        spacing: 12px;
                        Text { text: "No settings found matching \"" + root.search-query + "\""; color: rgba(255,255,255,0.4); font-size: 14px; font-weight: 500; horizontal-alignment: center; }
                        Text { text: "Try searching for terms like 'transparency', 'opacity', 'volume', 'accent', 'auto-hide', etc."; color: rgba(255,255,255,0.25); font-size: 11px; horizontal-alignment: center; }
                    }
                    
                    if root.search-results.length > 0: ScrollView {
                        height: 480px;
                        VerticalLayout {
                            spacing: 10px;
                            alignment: start;
                            
                            for res in root.search-results: Rectangle {
                                height: 72px;
                                border-radius: 14px;
                                background: parent-touch.has-hover ? rgba(255,255,255,0.06) : rgba(255,255,255,0.02);
                                border-color: parent-touch.has-hover ? rgba(255,255,255,0.1) : rgba(255,255,255,0.04);
                                border-width: 1px;
                                
                                HorizontalLayout {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    alignment: space-between;
                                    
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text { text: res.category; color: #0066FF; font-size: 10px; font-weight: 900; letter-spacing: 1px; vertical-alignment: center; }
                                            Text { text: "›"; color: rgba(255,255,255,0.3); font-size: 10px; vertical-alignment: center; }
                                            Text { text: res.label; color: white; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        Text { text: res.description; color: rgba(255,255,255,0.5); font-size: 11px; }
                                    }
                                    
                                    // Go to setting arrow
                                    Text {
                                        text: "→";
                                        font-size: 18px;
                                        color: rgba(255,255,255,0.4);
                                        vertical-alignment: center;
                                    }
                                }
                                
                                parent-touch := TouchArea {
                                    clicked => {
                                        root.active-tab = res.tab_id;
                                        root.search-query = "";
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    } // close inner HorizontalLayout (sidebar + content)
    } // close outer VerticalLayout (titlebar + content)
}




