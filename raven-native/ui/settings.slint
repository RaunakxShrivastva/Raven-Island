                                                        Rectangle { width: 6px; height: 6px; border-radius: 1px; background: #FF9500; y: 1px; }
                                                        Text { text: "Task checklist..."; font-size: 7px; color: rgba(255,255,255,0.4); }
                                                    }
                                                }
                                            }

                                            if active_widget.kind == "quotes": Rectangle {
                                                width: 100%; height: 100%; border-radius: parent.border-radius;
                                                background: @linear-gradient(135deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.0) 40%);
                                                VerticalLayout {
                                                    padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 6px; spacing: 0px;
                                                    HorizontalLayout { height: 20px; alignment: space-between;
                                                        Text { text: "DAILY WISDOM"; font-size: 7px; font-weight: 950; color: #FF2D55; vertical-alignment: center; }
                                                        Text { text: root.widgets-locked ? "LOCKED" : "LIVE"; font-size: 7px; font-weight: 950; color: rgba(255,255,255,0.25); vertical-alignment: center; }
                                                    }
