import { ScrollView } from "std-widgets.slint";
import { SlintGoogleCalendarEntry } from "types.slint";

export struct SearchResult {
    category: string,
    label: string,
    description: string,
    tab_id: string,
}

export struct ActiveWidgetRow {
    id: string,
    kind: string,
    title: string,
}

// --- REUSABLE COMPONENTS ---

component NavItem inherits Rectangle {
    in property <image> nav-icon;
    in property <string> label;
    in property <bool> active;
    in property <bool> use-colorize: true;
    callback clicked <=> touch.clicked;

    height: 38px;
    border-radius: 10px;
    background: active
        ? @linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%)
        : transparent;
    animate background { duration: 200ms; easing: ease-in-out; }

    touch := TouchArea { }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: start;
        spacing: 10px;

        // Icon box — dark rounded square with SVG icon
        Rectangle {
            width: 26px;
            height: 26px;
            border-radius: 7px;
            background: active ? rgba(255,255,255,0.15) : rgba(255,255,255,0.06);
            y: (parent.height - self.height) / 2;

            Image {
                source: root.nav-icon;
                width: 14px;
                height: 14px;
                colorize: root.use-colorize ? (active ? #ffffff : rgba(255,255,255,0.65)) : transparent;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: label;
            color: active ? white : rgba(255,255,255,0.6);
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            animate color { duration: 200ms; easing: ease-in-out; }
        }
    }
}

// --- GROUP CARD ---
component SettingGroup inherits Rectangle {
    in property <string> label;

    border-width: 1px;
    border-color: rgba(255,255,255,0.05);
    border-radius: 20px;
    background: rgba(255,255,255,0.02);

    VerticalLayout {
        VerticalLayout {
            padding-left: 30px;
            padding-right: 30px;
            padding-top: 28px;
            padding-bottom: 18px;
            Text {
                text: root.label;
                font-size: 11px;
                font-weight: 900;
                color: white;
            }
        }
        @children
    }
}

// --- SECTION INTRO CARD ---
component SectionIntro inherits Rectangle {
    in property <string> tag;
    in property <color>  tag-color: #00E5FF;
    in property <string> description;

    background: rgba(255,255,255,0.03);
    border-radius: 48px;

    VerticalLayout {
        padding-left: 28px;
        padding-right: 28px;
        padding-top: 24px;
        padding-bottom: 24px;
        spacing: 9px;

        Text {
            text: root.tag;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: 1.3px;
            color: root.tag-color;
        }
        Text {
            text: root.description;
            font-size: 15px;
            font-weight: 800;
            color: white;
        }
    }
}

// --- SLIDER ROW ---
component SliderRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <int> value;
    in property <int> min-value;
    in property <int> max-value;
    in property <string> unit: "";
    in property <bool> enabled: true;
    callback value_changed(int);

    padding-left: 30px;
    padding-right: 30px;
    padding-top: 22px;
    padding-bottom: 22px;
    height: 76px;
    alignment: space-between;

    Text { text: root.label; color: root.enabled ? white : rgba(255,255,255,0.3); font-weight: 600; font-size: 13px; vertical-alignment: center; }

    HorizontalLayout {
        width: 300px;
        spacing: 14px;
        alignment: end;

        Rectangle {
            width: 200px;
            height: 5px;
            border-radius: 2.5px;
            background: rgba(255,255,255,0.06);
            y: (parent.height - self.height) / 2;

            Rectangle {
                x: 0;
                width: parent.width * ((root.value - root.min-value) / (root.max-value - root.min-value));
                height: 100%;
                background: root.enabled ? #00E5FF : rgba(0, 229, 255, 0.25);
                border-radius: 2.5px;
            }

            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: root.enabled ? white : rgba(255, 255, 255, 0.4);
                x: parent.width * ((root.value - root.min-value) / (root.max-value - root.min-value)) - 6px;
                y: (parent.height - self.height) / 2;
                drop-shadow-blur: 4px;
                drop-shadow-color: rgba(0, 0, 0, 0.5);
            }

            TouchArea {
                enabled: root.enabled;
                moved => {
                    root.value = min(root.max-value, max(root.min-value, round(root.min-value + (self.mouse-x / parent.width * (root.max-value - root.min-value)))));
                    root.value_changed(root.value);
                }
            }
        }

        Text { text: root.value + root.unit; color: root.enabled ? white : rgba(255,255,255,0.3); font-weight: 600; font-size: 13px; vertical-alignment: center; }
    }
}

// --- COMPACT SLIDER ROW ---
component CompactSliderRow inherits VerticalLayout {
    in property <string> label;
    in-out property <int> value;
    in property <int> min-value;
    in property <int> max-value;
    in property <string> unit: "";
    callback value_changed(int);

    spacing: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
    width: 100%;

    HorizontalLayout {
        alignment: space-between;
        Text { text: root.label; color: white; font-weight: 700; font-size: 11px; overflow: elide; horizontal-stretch: 1; }
        Text { text: root.value + root.unit; color: #A000FF; font-weight: 800; font-size: 11px; }
    }

    HorizontalLayout {
        alignment: stretch;
        height: 18px;
        
        Rectangle {
            horizontal-stretch: 1;
            height: 6px;
            border-radius: 3px;
            background: rgba(255,255,255,0.06);
            y: (parent.height - self.height) / 2;

            Rectangle {
                x: 0;
                width: parent.width * ((root.value - root.min-value) / (root.max-value - root.min-value));
                height: 100%;
                background: #A000FF;
                border-radius: 3px;
            }

            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: white;
                x: parent.width * ((root.value - root.min-value) / (root.max-value - root.min-value)) - 6px;
                y: (parent.height - self.height) / 2;
            }

            TouchArea {
                moved => {
                    root.value = min(root.max-value, max(root.min-value, root.min-value + round(self.mouse-x / parent.width * (root.max-value - root.min-value))));
                    root.value_changed(root.value);
                }
                clicked => {
                    root.value = min(root.max-value, max(root.min-value, root.min-value + round(self.mouse-x / parent.width * (root.max-value - root.min-value))));
                    root.value_changed(root.value);
                }
            }
        }
    }
}

// --- COMPACT TOGGLE ROW ---
component CompactToggleRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    padding-top: 8px;
    padding-bottom: 8px;
    height: 36px;
    width: 100%;
    alignment: space-between;

    Text {
        text: root.label;
        color: root.enabled ? white : rgba(255,255,255,0.3);
        font-weight: 600;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }

    Rectangle {
        width: 36px;
        height: 20px;
        border-radius: 10px;
        background: root.checked && root.enabled ? #A000FF : rgba(255,255,255,0.06);
        y: (parent.height - self.height) / 2;
        opacity: root.enabled ? 1.0 : 0.4;
        animate background { duration: 150ms; easing: ease-in-out; }

        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: white;
            x: root.checked ? 18px : 2px;
            y: 2px;
            animate x { duration: 150ms; easing: cubic-bezier(0.32, 0.72, 0.0, 1.0); }
        }

        TouchArea {
            enabled: root.enabled;
            clicked => {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}

// --- TOGGLE ROW ---
component ToggleRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    padding-left: 30px;
    padding-right: 30px;
    padding-top: 22px;
    padding-bottom: 22px;
    height: 76px;
    alignment: space-between;

    Text { text: root.label; color: root.enabled ? white : rgba(255,255,255,0.3); font-weight: 600; font-size: 13px; vertical-alignment: center; }

    Rectangle {
        width: 40px;
        height: 24px;
        border-radius: 12px;
        background: root.checked && root.enabled ? #00E5FF : rgba(255,255,255,0.06);
        y: (parent.height - self.height) / 2;
        opacity: root.enabled ? 1.0 : 0.4;
        animate background { duration: 200ms; easing: ease-in-out; }

        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: white;
            x: root.checked ? 18px : 2px;
            y: 2px;
            animate x { duration: 200ms; easing: cubic-bezier(0.32, 0.72, 0.0, 1.0); }
        }

        TouchArea {
            enabled: root.enabled;
            clicked => {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}

// --- SOUND ROW ---
component SoundRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> description;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    
    // Custom Upload parameters
    in property <string> custom-path: "";
    
    callback toggled(bool);
    callback preview();
    callback upload();
    callback reset();

    padding-left: 30px;
    padding-right: 30px;
    padding-top: 16px;
    padding-bottom: 16px;
    height: 80px;
    alignment: space-between;

    VerticalLayout {
        alignment: center;
        spacing: 4px;
        Text { text: root.label; color: root.enabled ? white : rgba(255,255,255,0.4); font-weight: 600; font-size: 13px; }
        Text { 
            text: root.custom-path != "" ? "Custom sound: " + root.custom-path : root.description; 
            color: root.enabled ? (root.custom-path != "" ? #00E5FF : rgba(255,255,255,0.5)) : rgba(255,255,255,0.25); 
            font-weight: 400; 
            font-size: 11px; 
            overflow: elide;
            max-width: 450px;
        }
    }

    HorizontalLayout {
        alignment: end;
        spacing: 12px;
        y: (parent.height - self.height) / 2;

        // Preview button
        Rectangle {
            width: 72px;
            height: 28px;
            border-radius: 14px;
            background: root.enabled ? rgba(255,255,255,0.08) : rgba(255,255,255,0.02);
            border-color: root.enabled ? rgba(255,255,255,0.15) : rgba(255,255,255,0.05);
            border-width: 1px;
            
            Text {
                text: "Preview";
                color: root.enabled ? white : rgba(255,255,255,0.3);
                font-weight: 600;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                enabled: root.enabled;
                clicked => {
                    root.preview();
                }
            }
        }

        // Upload Button (for all sounds)
        Rectangle {
            width: root.custom-path != "" ? 72px : 64px;
            height: 28px;
            border-radius: 14px;
            background: root.enabled ? rgba(255,255,255,0.08) : rgba(255,255,255,0.02);
            border-color: root.enabled ? rgba(255,255,255,0.15) : rgba(255,255,255,0.05);
            border-width: 1px;
            
            Text {
                text: root.custom-path != "" ? "Replace" : "Upload";
                color: root.enabled ? white : rgba(255,255,255,0.3);
                font-weight: 600;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                enabled: root.enabled;
                clicked => {
                    root.upload();
                }
            }
        }

        // Reset Button (for all sounds if custom path is set)
        if root.custom-path != "": Rectangle {
            width: 54px;
            height: 28px;
            border-radius: 14px;
            background: root.enabled ? rgba(255,69,58,0.1) : rgba(255,255,255,0.02);
            border-color: root.enabled ? rgba(255,69,58,0.2) : rgba(255,255,255,0.05);
            border-width: 1px;
            
            Text {
                text: "Reset";
                color: root.enabled ? #ff453a : rgba(255,255,255,0.3);
                font-weight: 600;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                enabled: root.enabled;
                clicked => {
                    root.reset();
                }
            }
        }

        // Toggle Switch
        Rectangle {
            width: 40px;
            height: 24px;
            border-radius: 12px;
            background: !root.enabled ? rgba(255,255,255,0.03) : (root.checked ? #00E5FF : rgba(255,255,255,0.06));
            animate background { duration: 200ms; easing: ease-in-out; }

            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: root.enabled ? white : rgba(255,255,255,0.2);
                x: root.checked ? 18px : 2px;
                y: 2px;
                animate x { duration: 200ms; easing: cubic-bezier(0.32, 0.72, 0.0, 1.0); }
            }

            TouchArea {
                enabled: root.enabled;
                clicked => {
                    root.checked = !root.checked;
                    root.toggled(root.checked);
                }
            }
        }
    }
}

// --- COLOR ROW ---
component ColorRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> value;
    callback text_changed(string);

    padding-left: 30px;
    padding-right: 30px;
    padding-top: 22px;
    padding-bottom: 22px;
    height: 76px;
    alignment: space-between;

    Text { text: root.label; color: white; font-weight: 600; font-size: 13px; vertical-alignment: center; }

    HorizontalLayout {
        width: 150px;
        spacing: 12px;
        alignment: end;
        
        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 12px;
            background: rgba(255,255,255,0.06);
            y: (parent.height - self.height) / 2;
        }

        TextInput {
            text <=> root.value;
            color: white;
            font-size: 13px;
            vertical-alignment: center;
            width: 80px;
            single-line: true;
            edited => { root.text_changed(self.text); }
        }
    }
}

// --- MODE BTN ---
component ModeBtn inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked <=> touch.clicked;

    horizontal-stretch: 1;
    height: 34px;
    border-radius: 8px;
    background: selected ? (enabled ? #0066FF : rgba(0, 102, 255, 0.4)) : rgba(255,255,255,0.04);
    opacity: enabled ? 1.0 : 0.4;
    
    Text {
        text: root.label;
        font-size: 10px;
        font-weight: 700;
        color: white;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    
    touch := TouchArea {
        enabled: root.enabled;
    }
}

// --- DIVIDER ---
component Divider inherits HorizontalLayout {
    padding-left: 30px;
    padding-right: 30px;
    Rectangle {
        height: 1px;
        background: rgba(255,255,255,0.05);
    }
}

component PremiumLockNotice inherits Rectangle {
    in property <string> title: "Your Raven trial period is over";
    in property <string> message: "Please buy Raven Notch to unlock this premium feature.";
    callback buy();

    height: 96px;
    border-width: 1px;
    border-color: rgba(52, 199, 89, 0.34);
    border-radius: 20px;
    background: @linear-gradient(135deg, rgba(15, 18, 16, 0.94) 0%, rgba(6, 8, 7, 0.96) 100%);

    VerticalLayout {
        x: 24px;
        y: 22px;
        width: parent.width - 150px;
        height: 52px;
        spacing: 7px;

        Text { text: root.title; height: 23px; font-size: 16px; font-weight: 900; color: white; overflow: elide; vertical-alignment: center; }
        Text { text: root.message; height: 18px; font-size: 12px; font-weight: 600; color: rgba(255, 255, 255, 0.58); overflow: elide; vertical-alignment: center; }
    }

    Rectangle {
        width: 92px;
        height: 34px;
        x: parent.width - self.width - 18px;
        y: (parent.height - self.height) / 2;
        border-radius: 17px;
        background: buy-touch.has-hover ? #41df68 : #34C759;
        animate background { duration: 140ms; easing: ease-in-out; }
        Text { text: "Buy Now"; font-size: 11px; font-weight: 900; color: #061008; horizontal-alignment: center; vertical-alignment: center; }
        buy-touch := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.buy(); }
        }
    }
}

// --- WIDGET CARD ---
component WidgetCard inherits Rectangle {
    in property <string> title;
    in property <string> size-label: "Medium";
    in property <bool> is-active;
    in property <bool> is-selected;
    callback clicked;
    callback add_clicked;
    
    border-radius: 16px;
    background: is-selected ? rgba(160, 0, 255, 0.08) : rgba(255, 255, 255, 0.02);
    border-color: is-selected ? #A000FF : rgba(255, 255, 255, 0.05);
    border-width: 1.5px;
    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }
    
    TouchArea {
        clicked => { root.clicked(); }
    }
    
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        
        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 1px;
                Text { text: root.title; font-size: 11px; font-weight: 700; color: white; }
                if root.size-label != "": Text { text: root.size-label; font-size: 8px; color: rgba(255,255,255,0.4); }
            }
            
            // Add Button (always "+", allows multiple instances)
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: rgba(160, 0, 255, 0.18);
                border-color: rgba(160, 0, 255, 0.5);
                border-width: 1px;
                animate background { duration: 120ms; }
                
                Text {
                    text: "+";
                    font-size: 12px;
                    font-weight: 800;
                    color: #A000FF;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                
                TouchArea {
                    clicked => { root.add_clicked(); }
                }
            }
        }
        
        // Children for card content
        @children
    }
}

// --- GRID SELECTION BUTTON ---
component GridSelectionButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked;

    height: 38px;
    border-radius: 19px;
    background: root.selected ? rgba(0, 255, 136, 0.08) : rgba(255, 255, 255, 0.02);
    border-color: root.selected ? rgba(0, 255, 136, 0.2) : rgba(255, 255, 255, 0.05);
    border-width: 1px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        alignment: start;

        // circular indicator
        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 8px;
            y: (parent.height - self.height) / 2;
            background: root.selected ? #00FF88 : transparent;
            border-color: root.selected ? #00FF88 : rgba(255, 255, 255, 0.2);
            border-width: root.selected ? 0px : 1.5px;
            
            if root.selected : Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: black;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.label;
            color: root.selected ? white : rgba(255,255,255,0.6);
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// --- SHORTCUT RECORDER ROW ---
component ShortcutRecorderRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    in property <string> value;
    in property <bool> is-recording;
    in property <bool> enabled: true;
    
    callback start-recording();
    callback clear-shortcut();

    padding-left: 30px;
    padding-right: 30px;
    padding-top: 14px;
    padding-bottom: 14px;
    height: 72px;
    alignment: space-between;

    VerticalLayout {
        alignment: center;
        spacing: 4px;
        Text { text: root.label; color: root.enabled ? white : rgba(255,255,255,0.4); font-weight: 600; font-size: 13px; }
        Text { text: root.hint; color: rgba(255,255,255,0.45); font-weight: 400; font-size: 11px; }
    }

    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        y: (parent.height - self.height) / 2;

        // Recorder box
        Rectangle {
            width: 140px;
            height: 30px;
            border-radius: 15px;
            background: root.is-recording ? rgba(0,229,255,0.15) : (root.value != "" ? rgba(255,255,255,0.06) : rgba(255,255,255,0.02));
            border-color: root.is-recording ? #00E5FF : (root.value != "" ? rgba(255,255,255,0.15) : rgba(255,255,255,0.05));
            border-width: 1px;

            Text {
                text: root.is-recording ? "Press keys..." : (root.value != "" ? root.value : "None");
                color: root.is-recording ? #00E5FF : (root.value != "" ? white : rgba(255,255,255,0.3));
                font-weight: 700;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                enabled: root.enabled;
                clicked => { root.start-recording(); }
            }
        }

        // Clear button
        if root.value != "": Rectangle {
            width: 48px;
            height: 30px;
            border-radius: 15px;
            background: rgba(255,69,58,0.1);
            border-color: rgba(255,69,58,0.2);
            border-width: 1px;

            Text {
                text: "Clear";
                color: #ff453a;
                font-weight: 600;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                enabled: root.enabled;
                clicked => { root.clear-shortcut(); }
            }
        }
    }
}


// =====================================================================
// MAIN WINDOW
// =====================================================================
export component SettingsWindow inherits Window {
    title: "Raven Settings";
    icon: @image-url("assets/app_logo.png");
    min-width: 680px;
    min-height: 480px;
    preferred-width: 1000px;
    preferred-height: 700px;
    background: #080808;
    default-font-family: "Inter, sans-serif";

    in-out property <string> active-tab: "appearance";

    // Appearance
    in-out property <string> notch-color: "#000000";
    in-out property <string> accent-color: "#0066FF";
    in-out property <string> idle-pill-mode: "all";
    in-out property <string> idle-custom-name: "";
    in-out property <string> shape: "floating";
    in-out property <int> notch-border-radius: 20;
    in-out property <int> idle-border-radius: 9;
    in-out property <bool> auto-hide: false;
    in-out property <bool> auto-hide-on-fullscreen: false;
    in-out property <string> current-time: "07:47";
    in-out property <string> current-date: "SUN 7";
    in-out property <string> appearance-mode: "transparent";
    in-out property <float> appearance-opacity: 0.95;
    in-out property <string> search-query: "";
    in property <[SearchResult]> search-results: [];
    callback search_changed(string);
    
    // Layout
    in-out property <int> idle-width: 260;
    in-out property <int> idle-height: 38;
    in-out property <bool> reserve-top-area: false;
    in-out property <bool> full-width-bar: false;
    in-out property <bool> top-bar-widgets: true;

    // Hover
    in-out property <bool> hover-enabled: true;

    // Capture
    in-out property <bool> capture-enabled: true;
    in-out property <bool> include-cursor: false;
    in-out property <bool> show-recording-indicator: true;
    in-out property <bool> mic-enabled: false;
    in-out property <bool> system-audio-enabled: false;

    // Tab Visibility
    in-out property <bool> tab-home: true;
    in-out property <bool> tab-media: true;
    in-out property <bool> tab-calendar: true;
    in-out property <bool> tab-clock: true;
    in-out property <bool> tab-drop: true;
    in-out property <bool> tab-capture: true;
    in-out property <bool> tab-notifications: true;
    in-out property <bool> tab-stats: true;
    in-out property <bool> tab-caffeine: true;
    in-out property <bool> tab-settings: true;
    in-out property <bool> tab-battery: true;

    // Media Player
    in-out property <bool> media-show-waveform: true;
    in-out property <bool> media-pill-waveform: false;
    in-out property <bool> media-show-source: true;
    in-out property <bool> media-auto-expand: false;
    in-out property <bool> media-adaptive-accent: true;
    in-out property <bool> media-full-calendar-on-no-media: false;

    // Clock Engine
    in-out property <bool> clock-24h: false;
    in-out property <bool> clock-show-seconds: true;
    in-out property <bool> clock-show-ampm: true;
    in-out property <bool> clock-blink-colon: true;
    in-out property <bool> clock-show-weekday: true;
    in-out property <bool> clock-show-date: true;
    in-out property <bool> clock-show-utc: false;
    in-out property <bool> clock-show-timer: true;
    in-out property <bool> clock-show-stopwatch: true;

    // Desktop Widget Engine
    in-out property <bool> widgets-enabled: true;
    in-out property <bool> widgets-click-through: false;
    in-out property <bool> widgets-locked: true;
    in-out property <float> widgets-opacity: 0.85;
    in-out property <bool> widgets-clock-enabled: true;
    in-out property <bool> widgets-system-stats-enabled: false;
    
    // Premium/License settings
    in-out property <bool> premium-locked: false;
    in-out property <bool> force-trial-expired-preview: false;
    in-out property <string> license-status-label: "";
    in-out property <string> license-trial-countdown-label: "";
    in-out property <string> license-key-input: "";
    in-out property <string> license-action-message: "";
    in-out property <string> account-email-label: "";
    in-out property <string> account-name-label: "";
    in-out property <string> account-username-label: "";
    in-out property <string> account-picture-label: "";
    in-out property <image> account-picture-image;
    in-out property <bool> account-has-picture-image: false;
    callback toggle_trial_expired_preview();
    callback activate_license(string);
    callback paste_license_key();
    callback sign_in_account();
    callback sign_out_account();
    in-out property <bool> widgets-year-progress-enabled: false;
    in-out property <bool> widgets-day-progress-enabled: false;
    in-out property <bool> widgets-month-progress-enabled: false;
    in-out property <bool> widgets-media-enabled: false;
    in-out property <bool> widgets-notes-enabled: false;
    in-out property <bool> widgets-todo-enabled: false;
    in-out property <bool> widgets-quotes-enabled: false;
    in-out property <bool> widgets-picture-enabled: false;
    in-out property <bool> widgets-video-enabled: false;
    in-out property <bool> widgets-battery-enabled: false;
    in-out property <bool> widgets-calendar-focus-enabled: false;
    in-out property <bool> widgets-apps-container-enabled: false;
    in-out property <bool> widgets-streak-enabled: false;
    in-out property <bool> widgets-focus-score-enabled: false;
    in-out property <int> focus-timer-minutes: 25;
    in-out property <[string]> widgets-active-order: [];
    in-out property <[ActiveWidgetRow]> widgets-active-rows: [];
    callback remove_active_widget(string);

    // Custom widget customization settings
    in-out property <bool> todo-hide-completed: false;
    in-out property <string> todo-accent-color-str: "#FF9500";
    in-out property <bool> quotes-cycle-enabled: true;
    in-out property <int> quotes-interval-mins: 15;
    in-out property <string> quotes-new-text: "";
    in-out property <string> quotes-new-author: "";
    in-out property <string> picture-selected-path: "";
    in-out property <string> video-selected-path: "";

    in-out property <bool> widgets-stats-enabled: true;
    in-out property <int> widgets-clock-count: 0;
    in-out property <bool> widgets-actions-enabled: false;
    in-out property <bool> widgets-weather-enabled: false;
    in-out property <bool> widgets-calendar-enabled: false;
    in-out property <bool> widgets-note-enabled: false;
    in-out property <bool> widgets-focus-enabled: false;
    in-out property <bool> widgets-storage-enabled: false;
    in-out property <bool> widgets-network-enabled: false;
    in-out property <bool> widgets-ai-enabled: false;

    // Interactive Widget Studio Properties
    in-out property <string> selected-widget-id: "stats";
    in-out property <int> selected-clock-index: 0;
    in-out property <string> widget-size-select: "M";
    in-out property <string> widget-tab-select: "general";
    in-out property <string> widget-clock-style: "analog";
    
    // System Stats Customizations
    in-out property <bool> widgets-stats-show-cpu: true;
    in-out property <bool> widgets-stats-show-ram: true;
    in-out property <bool> widgets-stats-show-battery: true;
    in-out property <bool> widgets-stats-show-percentage: true;
    in-out property <color> widgets-stats-cpu-color: #FF2D55;
    in-out property <color> widgets-stats-ram-color: #AF52DE;
    in-out property <color> widgets-stats-battery-color: #34C759;
    in-out property <int> widgets-stats-border-radius: 24;

    // Instance-specific clock chip styles (Clock 0, 1, 2)
    in-out property <int> clock-0-border-radius: 24;
    in-out property <color> clock-0-cpu-color: #FFFFFF;
    in-out property <bool> clock-0-show-battery: true;
    in-out property <string> clock-0-size: "M";

    in-out property <int> clock-1-border-radius: 24;
    in-out property <color> clock-1-cpu-color: #FFFFFF;
    in-out property <bool> clock-1-show-battery: true;
    in-out property <string> clock-1-size: "M";

    in-out property <int> clock-2-border-radius: 24;
    in-out property <color> clock-2-cpu-color: #FFFFFF;
    in-out property <bool> clock-2-show-battery: true;
    in-out property <string> clock-2-size: "M";

    in-out property <int> clock-3-border-radius: 24;
    in-out property <color> clock-3-cpu-color: #FFFFFF;
    in-out property <bool> clock-3-show-battery: true;
    in-out property <string> clock-3-size: "M";

    in-out property <int> clock-4-border-radius: 24;
    in-out property <color> clock-4-cpu-color: #FFFFFF;
    in-out property <bool> clock-4-show-battery: true;
    in-out property <string> clock-4-size: "M";


    // Sounds
    in-out property <bool> sounds-enabled: true;
    in-out property <bool> sound-timer-complete: true;
    in-out property <bool> sound-stopwatch: true;
    in-out property <bool> sound-battery-low: true;
    in-out property <bool> sound-charger-connected: true;
    in-out property <bool> sound-charger-disconnected: true;
    in-out property <bool> sound-capslock-on: true;
    in-out property <bool> sound-capslock-off: true;
    in-out property <bool> sound-unlock: true;
    
    in-out property <string> sound-timer-complete-custom-path: "";
    in-out property <string> sound-stopwatch-custom-path: "";
    in-out property <string> sound-battery-low-custom-path: "";
    in-out property <string> sound-charger-connected-custom-path: "";
    in-out property <string> sound-charger-disconnected-custom-path: "";
    in-out property <string> sound-capslock-on-custom-path: "";
    in-out property <string> sound-capslock-off-custom-path: "";
    in-out property <string> sound-unlock-custom-path: "";

    // Live Calendar Tab Geometry & ICS Fallback
    in-out property <int> cal-width: 900;
    in-out property <int> cal-height: 480;
    in-out property <string> media-calendar-url: "";

    // Drop Shelf Settings
    in-out property <bool> drop-enabled: true;
    in-out property <bool> drop-auto-expand: true;
    in-out property <bool> drop-open-after-drop: true;
    in-out property <int> drop-keep-max: 10;
    in-out property <string> drop-default-provider: "localsend";

    // Keyboard Shortcuts (17 keys)
    in-out property <string> shortcut-toggle-raven: "";
    in-out property <string> shortcut-tab-home: "";
    in-out property <string> shortcut-tab-media: "";
    in-out property <string> shortcut-tab-calendar: "";
    in-out property <string> shortcut-tab-clock: "";
    in-out property <string> shortcut-tab-drop: "";
    in-out property <string> shortcut-tab-capture: "";
    in-out property <string> shortcut-tab-stats: "";
    in-out property <string> shortcut-media-play: "";
    in-out property <string> shortcut-media-next: "";
    in-out property <string> shortcut-media-prev: "";
    in-out property <string> shortcut-toggle-freeze: "";
    in-out property <string> shortcut-quick-screenshot: "";
    in-out property <string> shortcut-quick-record-toggle: "";
    in-out property <string> shortcut-open-settings: "";
    in-out property <string> shortcut-restart-raven: "";
    in-out property <string> shortcut-quit-raven: "";
    in-out property <string> shortcut-clipboard-history: "";
    in-out property <string> shortcut-topbar-stats: "";
    in-out property <string> shortcut-topbar-volume: "";
    in-out property <string> shortcut-topbar-wifi: "";
    in-out property <string> shortcut-topbar-timer: "";
    in-out property <string> shortcut-topbar-calendar: "";
    in-out property <string> recording-shortcut-key: ""; // holds current recording shortcut ID, or ""

    // Intelligence & Alerts
    in-out property <bool> alert-enabled: true;
    in-out property <bool> alert-monitor-charger-in: true;
    in-out property <bool> alert-monitor-charger-out: true;
    in-out property <bool> alert-monitor-low-battery: true;
    in-out property <bool> alert-monitor-unlock: true;
    in-out property <bool> alert-monitor-bluetooth: true;
    in-out property <bool> alert-monitor-keys: true;
    in-out property <bool> alert-volume-hud: true;
    in-out property <bool> alert-brightness-hud: true;
    in-out property <bool> alert-monitor-camera: true;
    in-out property <bool> alert-monitor-caffeine: true;
    in-out property <bool> intelligence-always-on-charging: false;
    in-out property <bool> intelligence-always-on-low-battery: true;
    in-out property <string> intelligence-always-on-charging-mode: "bolt";

    // Advanced reservation settings
    in-out property <bool> advanced-reserve-top-area: false;
    in-out property <bool> advanced-full-width-bar: false;
    in-out property <bool> advanced-top-bar-widgets: true;
    in-out property <bool> advanced-top-bar-widget-raven: true;
    in-out property <bool> advanced-top-bar-widget-media: true;
    in-out property <bool> advanced-top-bar-widget-apps: true;
    in-out property <bool> advanced-top-bar-widget-stats: true;
    in-out property <bool> advanced-top-bar-widget-clipboard: true;
    in-out property <bool> advanced-top-bar-widget-volume: true;
    in-out property <bool> advanced-top-bar-widget-wifi: true;
    in-out property <bool> advanced-top-bar-widget-battery: true;
    in-out property <bool> advanced-top-bar-widget-timer: true;
    in-out property <bool> advanced-top-bar-widget-calendar: true;
    in-out property <int> advanced-reserve-top-height: 67;
    in-out property <float> advanced-bezel-opacity: 0.95;
    in-out property <bool> advanced-run-on-startup: false;

    // Google Calendar connection state
    in-out property <bool>   google-connected: false;
    in-out property <string> google-email: "";
    in-out property <bool>   google-busy: false;
    in-out property <string> google-message: "";
    in-out property <[SlintGoogleCalendarEntry]> google-calendars: [];
    in-out property <int> google-selected-calendars-count: 0;

    callback int_setting_changed(string, int);
    callback bool_setting_changed(string, bool);
    callback string_setting_changed(string, string);
    callback play_sound(string);
    callback upload_sound(string);
    callback reset_sound(string);

    // Google Calendar callbacks
    callback google_sign_in();
    callback disconnect_google();
    callback toggle_google_calendar(string);
    
    // Shortcuts recorder callbacks
    callback record_shortcut(string);
    callback clear_shortcut(string);
    callback reset_shortcuts_group(string); // resets "shortcuts" to default
    callback selected_clock_changed(int);
    callback remove_clock_at(int);
    
    // Custom widget callbacks
    callback settings_todo_clear_completed();
    callback settings_quotes_add_custom(string, string);
    callback settings_picture_select_image();
    callback settings_video_select_media();
    callback settings_widgets_apply_changes();
    
    // About callbacks & properties
    in-out property <string> about-update-status: "";
    in-out property <string> app-version-string: "v0.1.0";
    in-out property <string> check-btn-label: "Check now";
    in-out property <bool> update-available: false;
    in-out property <string> update-url: "";
    in-out property <string> update-button-text: "";
    callback check_updates();
    callback open_url(string);
    
    out property <length> root-layout-width: root-layout.width;
    out property <length> root-layout-height: root-layout.height;
    out property <length> content-width: content-scroll.width;
    out property <length> content-height: content-scroll.height;
    out property <length> scroll-viewport-width: content-container.width;
    out property <length> scroll-viewport-height: content-container.height;

    callback close_clicked();
    callback minimize_clicked();
    callback maximize_clicked();
    callback drag_window();

    root-layout := VerticalLayout {
    HorizontalLayout {
        vertical-stretch: 1;

        // ── SIDEBAR ──────────────────────────────────────────────────
        Rectangle {
            width: 220px;
            height: 100%;
            background: #050505;
            border-color: rgba(255,255,255,0.05);
            border-width: 1px;

            VerticalLayout {

                // Search Box
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 24px;
                    padding-bottom: 10px;
 
                    search-rect := Rectangle {
                        height: 40px;
                        background: search-input.has-focus ? rgba(255,255,255,0.06) : rgba(255,255,255,0.03);
                        border-color: search-input.has-focus ? #0066FF : rgba(255,255,255,0.06);
                        border-width: 1px;
                        border-radius: 20px;
 
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;
                            alignment: start;
                            
                            // Magnifying glass icon
                            Text {
                                text: "🔍";
                                font-size: 14px;
                                color: rgba(255,255,255,0.4);
                                vertical-alignment: center;
                            }
 
                            search-input := TextInput {
                                text <=> root.search-query;
                                color: white;
                                font-size: 13px;
                                font-weight: 500;
                                vertical-alignment: center;
                                single-line: true;
                                width: search-rect.width - 50px;
                                edited => { root.search_changed(self.text); }
                                
                                // Placeholder emulation
                                if self.text == "": Text {
                                    text: "Search Settings...";
                                    color: rgba(255,255,255,0.3);
                                    font-size: 13px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                    x: 0;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 58px;
                    border-radius: 10px;
                    background: root.active-tab == "account" ? rgba(255,255,255,0.12) : (account-nav-touch.has-hover ? rgba(255,255,255,0.08) : rgba(255,255,255,0.035));
                    border-width: 1px;
                    border-color: root.active-tab == "account" ? rgba(255,255,255,0.12) : transparent;
                    x: 12px;
                    width: parent.width - 24px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        alignment: start;

                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 17px;
                            background: rgba(255,255,255,0.08);
                            y: (parent.height - self.height) / 2;
                            clip: true;

                            if root.account-email-label != "" && root.account-has-picture-image: Image {
                                source: root.account-picture-image;
                                width: parent.width;
                                height: parent.height;
                                image-fit: cover;
                            }

                            if root.account-email-label == "" || !root.account-has-picture-image: Image {
                                source: @image-url("assets/user-profile.svg");
                                width: 26px;
                                height: 26px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: rgba(255,255,255,0.72);
                            }
                        }

                        VerticalLayout {
                            width: parent.width - 58px;
                            spacing: 2px;
                            alignment: center;

                            Text {
                                text: root.account-email-label == "" ? "Not Signed In" : (root.account-name-label == "" ? root.account-email-label : root.account-name-label);
                                color: white;
                                font-size: 13px;
                                font-weight: 750;
                                overflow: elide;
                            }

                            Text {
                                text: "Account";
                                color: rgba(255,255,255,0.52);
                                font-size: 11px;
                                font-weight: 600;
                            }
                        }
                    }

                    account-nav-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.active-tab = "account"; }
                    }
                }

                Rectangle { height: 12px; }
                // Nav Scroll — vertical-stretch:1 keeps Premium card/footer always visible
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 20px;

                        // APPEARANCE
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "APPEARANCE"; font-size: 9px; font-weight: 900; color: rgba(255,255,255,0.35); letter-spacing: 2px; height: 22px; vertical-alignment: center; }
                            NavItem { nav-icon: @image-url("assets/gear.svg");       label: "General";        active: root.active-tab == "appearance"; clicked => { root.active-tab = "appearance"; } }

                            NavItem { nav-icon: @image-url("assets/nav-tabs.svg");   label: "Tab Visibility";  active: root.active-tab == "tabs";       clicked => { root.active-tab = "tabs"; } }
                            NavItem { nav-icon: @image-url("assets/nav-sounds.svg"); label: "Sounds";          active: root.active-tab == "sounds";     clicked => { root.active-tab = "sounds"; } }
                        }

                        // PANELS
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "PANELS"; font-size: 9px; font-weight: 900; color: rgba(255,255,255,0.35); letter-spacing: 2px; height: 22px; vertical-alignment: center; }
                            NavItem { nav-icon: @image-url("assets/nav-media.svg");   label: "Media Player";    active: root.active-tab == "media";    clicked => { root.active-tab = "media"; } }
                            NavItem { nav-icon: @image-url("assets/calendar.svg");    label: "Live Calendar";   active: root.active-tab == "calendar"; clicked => { root.active-tab = "calendar"; } }
                            NavItem { nav-icon: @image-url("assets/nav-shelf.svg");   label: "Shelf & Share";   active: root.active-tab == "shelf";    clicked => { root.active-tab = "shelf"; } }
                            NavItem { nav-icon: @image-url("assets/nav-widgets.svg"); label: "Desktop Widgets"; active: root.active-tab == "widgets";  clicked => { root.active-tab = "widgets"; } }
                        }

                        // TOOLS
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "TOOLS"; font-size: 9px; font-weight: 900; color: rgba(255,255,255,0.35); letter-spacing: 2px; height: 22px; vertical-alignment: center; }
                            NavItem { nav-icon: @image-url("assets/nav-shortcuts.svg");    label: "Keyboard Shortcuts";   active: root.active-tab == "shortcuts";    clicked => { root.active-tab = "shortcuts"; } }
                            NavItem { nav-icon: @image-url("assets/nav-intelligence.svg"); label: "Intelligence & Alerts"; active: root.active-tab == "intelligence"; clicked => { root.active-tab = "intelligence"; } }
                            NavItem { nav-icon: @image-url("assets/nav-advanced.svg");     label: "Advanced";             active: root.active-tab == "advanced";     clicked => { root.active-tab = "advanced"; } }
                            NavItem { nav-icon: @image-url("assets/app_logo.png"); use-colorize: false; label: "About"; active: root.active-tab == "system"; clicked => { root.active-tab = "system"; } }
                        }
                    }
                }




                // ── SIDEBAR FOOTER ───────────────────────────────────────
                Rectangle {
                    height: 48px;
                    border-color: rgba(255,255,255,0.06);
                    border-width: 1px;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 14px;
                        alignment: start;
                        spacing: 10px;

                        // Raven app icon
                        Image {
                            source: @image-url("assets/app_logo.png");
                            width: 18px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                        }

                        // Version text
                        Text {
                            text: root.app-version-string;
                            color: rgba(255,255,255,0.3);
                            font-size: 11.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        // Check for Updates button
                        Rectangle {
                            width: 125px;
                            height: 26px;
                            border-radius: 13px;
                            background: check-touch.has-hover ? rgba(255,255,255,0.08) : rgba(255,255,255,0.04);
                            border-color: check-touch.has-hover ? rgba(255,255,255,0.15) : rgba(255,255,255,0.08);
                            border-width: 1px;
                            y: (parent.height - self.height) / 2;
                            animate background { duration: 150ms; }
                            animate border-color { duration: 150ms; }

                            Text {
                                text: root.update-button-text != "" ? root.update-button-text : (root.update-available ? "Download update" : (root.about-update-status == "Checking..." ? "Checking..." : (root.about-update-status == "Up to date!" ? "Up to date" : "Check for updates")));
                                font-size: 10px;
                                font-weight: 700;
                                color: check-touch.has-hover ? white : rgba(255,255,255,0.7);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                animate color { duration: 150ms; }
                            }

                            check-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.check-updates();
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── MAIN CONTENT ─────────────────────────────────────────────
        content-scroll := ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            content-container := VerticalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-top: 26px;
                padding-bottom: 34px;
                alignment: start;

                if root.search-query == "": VerticalLayout {
                    spacing: 16px;
                    alignment: start;

                    // ── 0. ACCOUNT ─────────────────────────────────────
                    if root.active-tab == "account": VerticalLayout {
                        spacing: 22px;
                        alignment: start;

                        VerticalLayout {
                            height: 170px;
                            alignment: center;
                            spacing: 14px;

                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                width: 82px;
                                height: 82px;
                                border-radius: 41px;
                                background: rgba(255,255,255,0.08);
                                border-width: 0px;
                                clip: true;

                                if root.account-email-label != "" && root.account-has-picture-image: Image {
                                    source: root.account-picture-image;
                                    width: parent.width;
                                    height: parent.height;
                                    image-fit: cover;
                                }

                                if root.account-email-label == "" || !root.account-has-picture-image: Image {
                                    source: @image-url("assets/user-profile.svg");
                                    width: 64px;
                                    height: 64px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: rgba(255,255,255,0.78);
                                }
                            }

                            Text {
                                text: root.account-name-label == "" ? (root.account-email-label == "" ? "Not Signed In" : root.account-email-label) : root.account-name-label;
                                font-size: 20px;
                                font-weight: 750;
                                color: white;
                                horizontal-alignment: center;
                            }

                            if root.account-email-label != "": Text {
                                text: root.account-username-label == "" ? root.account-email-label : (root.account-username-label + " · " + root.account-email-label);
                                font-size: 12px;
                                font-weight: 600;
                                color: rgba(255,255,255,0.48);
                                horizontal-alignment: center;
                            }
                        }

                        if root.account-email-label == "": VerticalLayout {
                            spacing: 24px;
                            
                            VerticalLayout {
                                spacing: 12px;
                                Text { text: "Account"; font-size: 14px; font-weight: 750; color: white; }
                                
                                Rectangle {
                                    height: 50px;
                                    border-radius: 8px;
                                    background: sign-in-row-touch.has-hover ? rgba(255,255,255,0.08) : rgba(255,255,255,0.045);
                                    border-width: 1px;
                                    border-color: rgba(255,255,255,0.04);

                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        alignment: space-between;
                                        Text { text: "Sign In"; font-size: 14px; font-weight: 650; color: white; vertical-alignment: center; }
                                        Text { text: "↗"; font-size: 13px; color: rgba(255,255,255,0.45); vertical-alignment: center; }
                                    }

                                    sign-in-row-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.sign-in-account(); }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 12px;
                                Text { text: "Trial Status"; font-size: 14px; font-weight: 750; color: white; }
                                
                                Rectangle {
                                    border-radius: 8px;
                                    background: rgba(255,255,255,0.04);
                                    border-width: 1px;
                                    border-color: rgba(255,255,255,0.035);
                                    height: 58px;

                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        alignment: space-between;
                                        VerticalLayout {
                                            spacing: 3px;
                                            alignment: center;
                                            Text { text: "Trial"; font-size: 14px; font-weight: 750; color: white; }
                                            Text { text: root.license-trial-countdown-label == "" ? "Trial countdown will appear here." : root.license-trial-countdown-label; font-size: 12px; font-weight: 550; color: rgba(255,255,255,0.48); }
                                        }
                                        Text {
                                            text: root.premium-locked ? "Expired" : "Available";
                                            font-size: 13px;
                                            font-weight: 750;
                                            color: root.premium-locked ? #ff453a : rgba(255,255,255,0.52);
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            
                            if root.license-action-message != "": Text {
                                text: root.license-action-message;
                                font-size: 12px;
                                font-weight: 650;
                                color: rgba(255,255,255,0.48);
                            }
                        }

                        if root.account-email-label != "": VerticalLayout {
                            spacing: 24px;

                            VerticalLayout {
                                spacing: 12px;
                                Text { text: "Subscriptions"; font-size: 14px; font-weight: 750; color: white; }
                                
                                Rectangle {
                                    border-radius: 8px;
                                    background: rgba(255,255,255,0.04);
                                    border-width: 1px;
                                    border-color: rgba(255,255,255,0.035);
                                    
                                    VerticalLayout {
                                        Rectangle {
                                            height: 68px;
                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                alignment: space-between;
                                                VerticalLayout {
                                                    spacing: 3px;
                                                    alignment: center;
                                                    Text { text: "Raven Notch Lifetime"; font-size: 14px; font-weight: 750; color: white; }
                                                    Text { text: "Lifetime access for one active device at a time."; font-size: 12px; font-weight: 550; color: rgba(255,255,255,0.48); }
                                                }
                                                Text {
                                                    text: root.license-status-label == "Raven Notch account is activated" || root.license-status-label == "Raven Notch is activated" ? "Active" : "Inactive";
                                                    font-size: 13px;
                                                    font-weight: 750;
                                                    color: root.license-status-label == "Raven Notch account is activated" || root.license-status-label == "Raven Notch is activated" ? #34c759 : rgba(255,255,255,0.52);
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                        if !(root.license-status-label == "Raven Notch account is activated" || root.license-status-label == "Raven Notch is activated") : Divider {}
                                        if !(root.license-status-label == "Raven Notch account is activated" || root.license-status-label == "Raven Notch is activated") : Rectangle {
                                            height: 58px;
                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                alignment: space-between;
                                                VerticalLayout {
                                                    spacing: 3px;
                                                    alignment: center;
                                                    Text { text: "Trial"; font-size: 14px; font-weight: 750; color: white; }
                                                    Text { text: root.license-trial-countdown-label == "" ? "Trial countdown will appear here." : root.license-trial-countdown-label; font-size: 12px; font-weight: 550; color: rgba(255,255,255,0.48); }
                                                }
                                                Text {
                                                    text: root.premium-locked ? "Expired" : "Available";
                                                    font-size: 13px;
                                                    font-weight: 750;
                                                    color: root.premium-locked ? #ff453a : rgba(255,255,255,0.52);
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 12px;
                                Text { text: "Account"; font-size: 14px; font-weight: 750; color: white; }
                                
                                Rectangle {
                                    border-radius: 8px;
                                    background: rgba(255,255,255,0.04);
                                    border-width: 1px;
                                    border-color: rgba(255,255,255,0.035);

                                    VerticalLayout {
                                        Rectangle {
                                            height: 50px;
                                            background: manage-account-touch.has-hover ? rgba(255,255,255,0.04) : transparent;
                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                alignment: space-between;
                                                Text { text: "Manage Account"; font-size: 14px; font-weight: 650; color: white; vertical-alignment: center; }
                                                Text { text: "↗"; font-size: 13px; color: rgba(255,255,255,0.45); vertical-alignment: center; }
                                            }
                                            manage-account-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.open-url("https://ravennotch.me"); }
                                            }
                                        }
                                        Divider {}
                                        Rectangle {
                                            height: 50px;
                                            background: sign-out-touch.has-hover ? rgba(255,69,58,0.10) : transparent;
                                            Text {
                                                text: "Sign Out";
                                                x: 16px;
                                                height: 100%;
                                                font-size: 14px;
                                                font-weight: 650;
                                                color: #ff453a;
                                                vertical-alignment: center;
                                            }
                                            sign-out-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.sign-out-account(); }
                                            }
                                        }
                                    }
                                }
                                
                                if root.license-action-message != "": Text {
                                    text: root.license-action-message;
                                    font-size: 12px;
                                    font-weight: 650;
                                    color: root.license-action-message == "License activated successfully." || root.license-action-message == "Lifetime purchase linked to this account." ? rgba(52, 199, 89, 0.78) : rgba(255,255,255,0.48);
                                }
                            }
                        }
                    }
 
                    // ── 1. APPEARANCE ─────────────────────────────────────
                    if root.active-tab == "appearance": VerticalLayout {
                    spacing: 16px;

                    Text { text: "Appearance"; font-size: 38px; font-weight: 900; color: white; }

                    SectionIntro {
                        tag: "VISUAL STUDIO";
                        tag-color: #00E5FF;
                        description: "Tune the idle pill, colors, and edge shape.";
                    }

                    // ── LIVE PREVIEW WINDOW ─────────────────────────
                    Rectangle {
                        height: 120px;
                        border-radius: 16px;
                        background: @linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #311042 100%);
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.08);
                        clip: true;

                        // Mock top-edge line to show the screen edge
                        Rectangle {
                            y: 0px;
                            width: 100%;
                            height: 1px;
                            background: rgba(255, 255, 255, 0.2);
                        }

                        // Centered mock wallpaper text
                        Text {
                            text: "LIVE RESTING PREVIEW";
                            font-size: 10px;
                            font-weight: 900;
                            color: rgba(255, 255, 255, 0.2);
                            letter-spacing: 1.5px;
                            y: parent.height - 24px;
                            x: (parent.width - self.width) / 2;
                        }

                        // The Mock Notch
                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: root.shape != "floating" ? 0px : 12px;
                            width: root.idle-width * 1px;
                            height: root.idle-height * 1px;
                            border-top-left-radius: root.shape != "floating" ? 0px : Math.min(root.notch-border-radius, root.idle-height * 0.5) * 1px;
                            border-top-right-radius: root.shape != "floating" ? 0px : Math.min(root.notch-border-radius, root.idle-height * 0.5) * 1px;
                            border-bottom-left-radius: Math.min(root.notch-border-radius, root.idle-height * 0.5) * 1px;
                            border-bottom-right-radius: Math.min(root.notch-border-radius, root.idle-height * 0.5) * 1px;
                            background: rgba(10, 10, 10, root.appearance-opacity);
                            border-width: 1px;
                            border-color: rgba(255, 255, 255, 0.08);
                            clip: true;

                            // Content inside mock notch based on selected modes
                            // 1. Split mode ("all")
                            if root.idle-pill-mode == "all": Text {
                                x: 22px;
                                text: root.current-date;
                                font-size: 13px;
                                font-weight: 800;
                                color: rgba(255, 255, 255, 0.75);
                                vertical-alignment: center;
                            }
                            if root.idle-pill-mode == "all": Text {
                                x: parent.width - self.width - 22px;
                                text: root.current-time;
                                font-size: 13px;
                                font-weight: 800;
                                color: rgba(255, 255, 255, 0.75);
                                vertical-alignment: center;
                            }

                            // 2. Centered Modes (name, date, clock)
                            if root.idle-pill-mode != "all" && root.idle-pill-mode != "none": HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: root.idle-pill-mode == "name" ? (root.idle-custom-name != "" ? root.idle-custom-name : "RAVEN NOTCH") :
                                          root.idle-pill-mode == "date" ? root.current-date :
                                          root.idle-pill-mode == "clock" ? root.current-time : "";
                                    font-size: 13px;
                                    font-weight: 900;
                                    color: white;
                                    letter-spacing: 0.5px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Inverse curves (only show if shape is curved)
                        if root.shape == "curved": Path {
                            x: (parent.width - root.idle-width * 1px) / 2 - 11px;
                            y: 1px;
                            width: 12px;
                            height: 12px;
                            fill: rgba(10, 10, 10, root.appearance-opacity);
                            viewbox-width: 12;
                            viewbox-height: 12;
                            commands: "M 12 0 L 12 12 Q 12 0 0 0 Z";
                        }
                        if root.shape == "curved": Path {
                            x: (parent.width - root.idle-width * 1px) / 2 - 11px;
                            y: 1px;
                            width: 12px;
                            height: 12px;
                            stroke: rgba(255, 255, 255, 0.08);
                            stroke-width: 1px;
                            viewbox-width: 12;
                            viewbox-height: 12;
                            commands: "M 12 12 Q 12 0 0 0";
                        }
                        if root.shape == "curved": Path {
                            x: (parent.width - root.idle-width * 1px) / 2 + root.idle-width * 1px - 1px;
                            y: 1px;
                            width: 12px;
                            height: 12px;
                            fill: rgba(10, 10, 10, root.appearance-opacity);
                            viewbox-width: 12;
                            viewbox-height: 12;
                            commands: "M 0 0 L 0 12 Q 0 0 12 0 Z";
                        }
                        if root.shape == "curved": Path {
                            x: (parent.width - root.idle-width * 1px) / 2 + root.idle-width * 1px - 1px;
                            y: 1px;
                            width: 12px;
                            height: 12px;
                            stroke: rgba(255, 255, 255, 0.08);
                            stroke-width: 1px;
                            viewbox-width: 12;
                            viewbox-height: 12;
                            commands: "M 0 12 Q 0 0 12 0";
                        }
                    }

                    SettingGroup {
                        label: "Idle Pill Personality";
                        ToggleRow {
                            label: "Auto hide/show";
                            checked <=> root.auto-hide;
                            toggled(v) => { root.bool_setting_changed("auto-hide", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Auto hide on fullscreen";
                            checked <=> root.auto-hide-on-fullscreen;
                            toggled(v) => { root.bool_setting_changed("auto-hide-on-fullscreen", v); }
                        }
                        

                        VerticalLayout {
                            padding-left: 30px;
                            padding-right: 30px;
                            padding-top: 14px;
                            padding-bottom: 20px;
                            spacing: 12px;
                            
                            Text {
                                text: "DISPLAY MODE";
                                font-size: 11px;
                                font-weight: 900;
                                color: rgba(255,255,255,0.4);
                                letter-spacing: 1px;
                            }
                            
                            GridLayout {
                                spacing: 8px;
                                Row {
                                    ModeBtn { label: "Date & Time"; selected: root.idle-pill-mode == "all"; clicked => { root.idle-pill-mode = "all"; root.string_setting_changed("idle-pill-mode", "all"); } }
                                    ModeBtn { label: "Custom Name"; selected: root.idle-pill-mode == "name"; clicked => { root.idle-pill-mode = "name"; root.string_setting_changed("idle-pill-mode", "name"); } }
                                    ModeBtn { label: "Date Only"; selected: root.idle-pill-mode == "date"; clicked => { root.idle-pill-mode = "date"; root.string_setting_changed("idle-pill-mode", "date"); } }
                                }
                                Row {
                                    ModeBtn { label: "Clock Only"; selected: root.idle-pill-mode == "clock"; clicked => { root.idle-pill-mode = "clock"; root.string_setting_changed("idle-pill-mode", "clock"); } }
                                    ModeBtn { label: "Nothing"; selected: root.idle-pill-mode == "none"; clicked => { root.idle-pill-mode = "none"; root.string_setting_changed("idle-pill-mode", "none"); } }
                                    Rectangle { } // spacer for 3rd column
                                }
                            }
                            
                            if root.idle-pill-mode == "all" || root.idle-pill-mode == "clock": VerticalLayout {
                                Rectangle { height: 8px; }
                                Rectangle {
                                    height: 44px;
                                    border-radius: 20px;
                                    background: #0066FF;
                                    Text { text: "🕐 Configure Clock Engine"; font-size: 12px; font-weight: 800; color: white; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.active-tab = "clock_panel"; } } // Or "clock"
                                }
                            }
                            
                            if root.idle-pill-mode == "name": VerticalLayout {
                                Rectangle { height: 8px; }
                                spacing: 8px;
                                Text { text: "BRAND NAME"; font-size: 11px; font-weight: 900; color: rgba(255,255,255,0.4); letter-spacing: 1px; }
                                Rectangle {
                                    height: 40px;
                                    background: rgba(255,255,255,0.03);
                                    border-color: rgba(255,255,255,0.06);
                                    border-width: 1px;
                                    border-radius: 20px;
                                    TextInput {
                                        text <=> root.idle-custom-name;
                                        color: white;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                        single-line: true;
                                        edited => { root.string_setting_changed("idle-custom-name", self.text); }
                                    }
                                }
                            }
                        }
                    }

                    SettingGroup {
                        label: "Geometry & Shape";
                        VerticalLayout {
                            padding-left: 30px;
                            padding-right: 30px;
                            padding-top: 14px;
                            padding-bottom: 20px;
                            spacing: 12px;
                            Text {
                                text: "PILL SHAPE";
                                font-size: 11px;
                                font-weight: 900;
                                color: rgba(255,255,255,0.4);
                                letter-spacing: 1px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                ModeBtn { label: "Floating Pill"; selected: root.shape == "floating"; clicked => { root.shape = "floating"; root.string_setting_changed("shape", "floating"); } }
                                ModeBtn { label: "Curved Edge"; selected: root.shape == "curved"; clicked => { root.shape = "curved"; root.string_setting_changed("shape", "curved"); } }
                                ModeBtn { label: "Simple Notch"; selected: root.shape == "edge"; clicked => { root.shape = "edge"; root.string_setting_changed("shape", "edge"); } }
                            }
                        }
                        SliderRow {
                            label: "Notch Corner Smoothing";
                            value <=> root.notch-border-radius;
                            min-value: 0;
                            max-value: 40;
                            unit: "px";
                            value_changed(val) => { root.int_setting_changed("border-radius", val); }
                        }
                        Divider {}
                        SliderRow {
                            label: "Idle Corner Smoothing";
                            value <=> root.idle-border-radius;
                            min-value: 0;
                            max-value: 40;
                            unit: "px";
                            value_changed(val) => { root.int_setting_changed("idle-border-radius", val); }
                        }
                        Divider {}
                        SliderRow {                            
                            label: "Idle Width";
                            value <=> root.idle-width;
                            min-value: 150;
                            max-value: 400;
                            unit: "px";
                            value_changed(val) => { root.int_setting_changed("idle-width", val); }
                        }
                        Divider {}
                        SliderRow {
                            label: "Idle Height";
                            value <=> root.idle-height;
                            min-value: 20;
                            max-value: 100;
                            unit: "px";
                            value_changed(val) => { root.int_setting_changed("idle-height", val); }
                        }
                    }
                    SettingGroup {
                        label: "Notch Appearance";
                        
                        VerticalLayout {
                            padding-left: 30px;
                            padding-right: 30px;
                            padding-top: 14px;
                            padding-bottom: 20px;
                            spacing: 12px;
                            
                            Text {
                                text: "BACKGROUND TYPE";
                                font-size: 11px;
                                font-weight: 900;
                                color: rgba(255,255,255,0.4);
                                letter-spacing: 1px;
                            }
                            
                            HorizontalLayout {
                                spacing: 8px;
                                ModeBtn {
                                    label: "Transparent";
                                    selected: root.appearance-mode == "transparent";
                                    clicked => {
                                        root.appearance-mode = "transparent";
                                        root.string_setting_changed("appearance-mode", "transparent");
                                    }
                                }
                                ModeBtn {
                                    label: "Solid Color";
                                    selected: root.appearance-mode == "solid";
                                    clicked => {
                                        root.appearance-mode = "solid";
                                        root.string_setting_changed("appearance-mode", "solid");
                                    }
                                }
                            }
                        }

                        if root.appearance-mode == "transparent": SliderRow {
                            label: "Transparency Opacity";
                            value: round(root.appearance-opacity * 100);
                            min-value: 10;
                            max-value: 100;
                            unit: "%";
                            value_changed(v) => {
                                root.appearance-opacity = v / 100.0;
                                root.int_setting_changed("appearance-opacity", v);
                            }
                        }
                    }

                    SettingGroup {
                        label: "System Options";
                        ToggleRow {
                            label: "Run on Startup";
                            checked <=> root.advanced-run-on-startup;
                            toggled(v) => { root.bool_setting_changed("advanced-run-on-startup", v); }
                        }
                    }


                }

                // ── CLOCK PANEL CONFIGURATION ──────────────────────────
                if root.active-tab == "clock_panel": VerticalLayout {
                    spacing: 16px;

                    HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            width: 154px;
                            height: 32px;
                            border-radius: 16px;
                            background: rgba(255, 255, 255, 0.04);
                            border-width: 1px;
                            border-color: rgba(255, 255, 255, 0.08);
                            
                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text {
                                    text: "←";
                                    font-size: 14px;
                                    color: white;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "Back to Appearance";
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: white;
                                    vertical-alignment: center;
                                }
                            }
                            
                            TouchArea {
                                clicked => { root.active-tab = "appearance"; }
                            }
                        }
                    }

                    Text { text: "Clock Engine Settings"; font-size: 38px; font-weight: 900; color: white; }

                    SectionIntro {
                        tag: "TIME & DATE STUDIO";
                        tag-color: #FF9900;
                        description: "Configure how the live clock and date format display on your Notch.";
                    }

                    Rectangle { height: 12px; }

                    SettingGroup {
                        label: "Time Format & Display";
                        ToggleRow {
                            label: "24-Hour Military Format";
                            checked <=> root.clock-24h;
                            toggled(v) => { root.bool_setting_changed("clock-24h", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Show Live Seconds";
                            checked <=> root.clock-show-seconds;
                            toggled(v) => { root.bool_setting_changed("clock-show-seconds", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Show AM/PM Indicator (12h mode only)";
                            checked <=> root.clock-show-ampm;
                            toggled(v) => { root.bool_setting_changed("clock-show-ampm", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Flash Separator Colon (:)";
                            checked <=> root.clock-blink-colon;
                            toggled(v) => { root.bool_setting_changed("clock-blink-colon", v); }
                        }
                    }

                    SettingGroup {
                        label: "Date Format & Display";
                        ToggleRow {
                            label: "Display Day of the Week (e.g. MON)";
                            checked <=> root.clock-show-weekday;
                            toggled(v) => { root.bool_setting_changed("clock-show-weekday", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Display Calendar Date (e.g. JUN 1)";
                            checked <=> root.clock-show-date;
                            toggled(v) => { root.bool_setting_changed("clock-show-date", v); }
                        }
                    }

                    SettingGroup {
                        label: "Dashboard Widgets";
                        ToggleRow {
                            label: "Enable Timer Widget";
                            checked <=> root.clock-show-timer;
                            toggled(v) => { root.bool_setting_changed("clock-show-timer", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Enable Stopwatch Widget";
                            checked <=> root.clock-show-stopwatch;
                            toggled(v) => { root.bool_setting_changed("clock-show-stopwatch", v); }
                        }
                    }
                }



                // ── 3. TAB VISIBILITY ─────────────────────────────────
                if root.active-tab == "tabs": VerticalLayout {
                    spacing: 16px;

                    Text { text: "Tab Visibility"; font-size: 38px; font-weight: 900; color: white; }

                    SectionIntro {
                        tag: "MODULE CONTROL";
                        tag-color: #A855F7;
                        description: "Choose which panels appear in your expanded Raven Notch.";
                    }

                    Rectangle { height: 12px; }

                    SettingGroup {
                        label: "Active Modules";
                        ToggleRow {
                            label: "Show Home Tab";
                            checked <=> root.tab-home;
                            toggled(v) => { root.bool_setting_changed("tab-home", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Show Media Tab";
                            checked <=> root.tab-media;
                            toggled(v) => { root.bool_setting_changed("tab-media", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Show Live Calendar";
                            checked <=> root.tab-calendar;
                            toggled(v) => { root.bool_setting_changed("tab-calendar", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Show Clock Tab";
                            checked <=> root.tab-clock;
                            toggled(v) => { root.bool_setting_changed("tab-clock", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Show File Shelf";
                            checked <=> root.tab-drop;
                            toggled(v) => { root.bool_setting_changed("tab-drop", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Show Stats Panel";
                            checked <=> root.tab-stats;
                            toggled(v) => { root.bool_setting_changed("tab-stats", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Show Caffeine Toggle";
                            checked <=> root.tab-caffeine;
                            toggled(v) => { root.bool_setting_changed("tab-caffeine", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Show Settings Cog";
                            checked <=> root.tab-settings;
                            toggled(v) => { root.bool_setting_changed("tab-settings", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Show Battery Status";
                            checked <=> root.tab-battery;
                            toggled(v) => { root.bool_setting_changed("tab-battery", v); }
                        }
                    }
                }

                // ── 3. SOUNDS (formerly media) ───────────────────────────────────────
                if root.active-tab == "sounds": VerticalLayout {
                    spacing: 16px;

                    Text { text: "Sounds"; font-size: 38px; font-weight: 900; color: white; }

                    SectionIntro {
                        tag: "SOUND STUDIO";
                        tag-color: #00E5FF;
                        description: "Manage Raven feedback sounds with preview and status indicators.";
                    }

                    Rectangle { height: 12px; }

                    SettingGroup {
                        label: "System Sounds";
                        ToggleRow {
                            label: "Enable Raven Notch Sounds";
                            checked <=> root.sounds-enabled;
                            toggled(v) => { root.bool_setting_changed("sounds-enabled", v); }
                        }
                    }

                    SettingGroup {
                        label: "Clock & Timing";
                        SoundRow {
                            label: "Timer complete";
                            description: "Plays when a countdown finishes.";
                            checked <=> root.sound-timer-complete;
                            enabled: root.sounds-enabled;
                            custom-path: root.sound-timer-complete-custom-path;
                            toggled(v) => { root.bool_setting_changed("sound-timer-complete", v); }
                            preview() => { root.play_sound("timer_complete"); }
                            upload() => { root.upload_sound("timer_complete"); }
                            reset() => { root.reset_sound("timer_complete"); }
                        }
                        Divider {}
                        SoundRow {
                            label: "Stopwatch actions";
                            description: "Plays when the stopwatch starts or stops.";
                            checked <=> root.sound-stopwatch;
                            enabled: root.sounds-enabled;
                            custom-path: root.sound-stopwatch-custom-path;
                            toggled(v) => { root.bool_setting_changed("sound-stopwatch", v); }
                            preview() => { root.play_sound("stopwatch"); }
                            upload() => { root.upload_sound("stopwatch"); }
                            reset() => { root.reset_sound("stopwatch"); }
                        }
                    }

                    SettingGroup {
                        label: "Raven Notch Alerts";
                        SoundRow {
                            label: "Battery low";
                            description: "Plays when Raven Notch detects a low battery warning.";
                            checked <=> root.sound-battery-low;
                            enabled: root.sounds-enabled;
                            custom-path: root.sound-battery-low-custom-path;
                            toggled(v) => { root.bool_setting_changed("sound-battery-low", v); }
                            preview() => { root.play_sound("battery_low"); }
                            upload() => { root.upload_sound("battery_low"); }
                            reset() => { root.reset_sound("battery_low"); }
                        }
                        Divider {}
                        SoundRow {
                            label: "Charger connected";
                            description: "Plays when power is connected.";
                            checked <=> root.sound-charger-connected;
                            enabled: root.sounds-enabled;
                            custom-path: root.sound-charger-connected-custom-path;
                            toggled(v) => { root.bool_setting_changed("sound-charger-connected", v); }
                            preview() => { root.play_sound("charger_connected"); }
                            upload() => { root.upload_sound("charger_connected"); }
                            reset() => { root.reset_sound("charger_connected"); }
                        }
                        Divider {}
                        SoundRow {
                            label: "Charger disconnected";
                            description: "Plays when power is removed.";
                            checked <=> root.sound-charger-disconnected;
                            enabled: root.sounds-enabled;
                            custom-path: root.sound-charger-disconnected-custom-path;
                            toggled(v) => { root.bool_setting_changed("sound-charger-disconnected", v); }
                            preview() => { root.play_sound("charger_disconnected"); }
                            upload() => { root.upload_sound("charger_disconnected"); }
                            reset() => { root.reset_sound("charger_disconnected"); }
                        }
                        Divider {}
                        SoundRow {
                            label: "Caps Lock on";
                            description: "Plays when Caps Lock is enabled.";
                            checked <=> root.sound-capslock-on;
                            enabled: root.sounds-enabled;
                            custom-path: root.sound-capslock-on-custom-path;
                            toggled(v) => { root.bool_setting_changed("sound-capslock-on", v); }
                            preview() => { root.play_sound("capslock_on"); }
                            upload() => { root.upload_sound("capslock_on"); }
                            reset() => { root.reset_sound("capslock_on"); }
                        }
                        Divider {}
                        SoundRow {
                            label: "Caps Lock off";
                            description: "Plays when Caps Lock is disabled.";
                            checked <=> root.sound-capslock-off;
                            enabled: root.sounds-enabled;
                            custom-path: root.sound-capslock-off-custom-path;
                            toggled(v) => { root.bool_setting_changed("sound-capslock-off", v); }
                            preview() => { root.play_sound("capslock_off"); }
                            upload() => { root.upload_sound("capslock_off"); }
                            reset() => { root.reset_sound("capslock_off"); }
                        }
                        Divider {}
                        SoundRow {
                            label: "Screen unlock";
                            description: "Plays when the PC unlocks.";
                            checked <=> root.sound-unlock;
                            enabled: root.sounds-enabled;
                            custom-path: root.sound-unlock-custom-path;
                            toggled(v) => { root.bool_setting_changed("sound-unlock", v); }
                            preview() => { root.play_sound("unlock"); }
                            upload() => { root.upload_sound("unlock"); }
                            reset() => { root.reset_sound("unlock"); }
                        }
                    }
                }

                // ── 5b. MEDIA PLAYER ────────────────────
                if root.active-tab == "media": VerticalLayout {
                    spacing: 16px;
                    Text { text: "Media Player"; font-size: 38px; font-weight: 900; color: white; }
                    SectionIntro {
                        tag: "MEDIA PLAYER ENGINE";
                        tag-color: #FF5D86;
                        description: "Control the media engine behavior and visibility options.";
                    }
                    Rectangle { height: 12px; }

                    SettingGroup {
                        label: "Engine Behavior";
                        ToggleRow {
                            label: "Show Track Waveform";
                            checked <=> root.media-show-waveform;
                            toggled(v) => { root.bool_setting_changed("media-show-waveform", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Pill Media Waveform";
                            checked <=> root.media-pill-waveform;
                            toggled(v) => { root.bool_setting_changed("media-pill-waveform", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Display Source Tooltip";
                            checked <=> root.media-show-source;
                            toggled(v) => { root.bool_setting_changed("media-show-source", v); }
                        }

                        Divider {}
                        ToggleRow {
                            label: "Adaptive Accent Color";
                            checked <=> root.media-adaptive-accent;
                            toggled(v) => { root.bool_setting_changed("media-adaptive-accent", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Full Calendar on No Media";
                            checked <=> root.media-full-calendar-on-no-media;
                            toggled(v) => { root.bool_setting_changed("media-full-calendar-on-no-media", v); }
                        }

                    }
                }

                // ── 6. LIVE CALENDAR ────────────────────
                if root.active-tab == "calendar": VerticalLayout {
                    spacing: 16px;
                    Text { text: "Live Calendar"; font-size: 38px; font-weight: 900; color: white; }
                    SectionIntro {
                        tag: "CALENDAR ENGINE";
                        tag-color: #FFD166;
                        description: "Connect Google Calendar to see upcoming events in your notch.";
                    }
                    if root.premium-locked: PremiumLockNotice {
                        title: "Your Raven trial period is over";
                        message: "Google Calendar is premium. Buy Raven Notch to unlock syncing.";
                        buy => { root.open-url("https://ravennotch.me/"); }
                    }
                    Rectangle { height: 12px; }
                    SettingGroup {
                        label: "Google Calendar";
                        opacity: root.premium-locked ? 0.36 : 1.0;

                        VerticalLayout {
                            // Status row
                            HorizontalLayout {
                                padding-left: 30px;
                                padding-right: 30px;
                                padding-top: 16px;
                                padding-bottom: 16px;
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 4px;
                                    alignment: center;

                                    // Connected indicator dot + email / "Not connected"
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            y: (parent.height - self.height) / 2;
                                            background: root.google-connected ? #00FF88 : rgba(255,255,255,0.2);
                                            animate background { duration: 300ms; easing: ease-in-out; }
                                        }
                                        Text {
                                            text: root.google-connected
                                                ? (root.google-email != "" ? root.google-email : "Google Calendar")
                                                : "Not connected";
                                            color: root.google-connected ? white : rgba(255,255,255,0.5);
                                            font-weight: 700;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: root.google-message != ""
                                            ? root.google-message
                                            : (root.google-connected
                                                ? "Events are syncing automatically."
                                                : "Sign in once and Raven Notch will fetch events automatically.");
                                        color: root.google-message != ""
                                            ? (root.google-connected ? #00FF88 : #FF6B6B)
                                            : rgba(255,255,255,0.45);
                                        font-weight: 400;
                                        font-size: 11px;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: end;
                                    y: (parent.height - self.height) / 2;

                                    // Connect / busy button
                                    Rectangle {
                                        width: root.google-connected ? 0px : 130px;
                                        height: 32px;
                                        border-radius: 16px;
                                        background: root.google-busy ? rgba(0,102,255,0.4) : #0066FF;
                                        opacity: root.google-busy ? 0.7 : 1.0;
                                        clip: true;
                                        animate width { duration: 220ms; easing: ease-in-out; }

                                        Text {
                                            text: root.google-busy ? "Connecting…" : "Connect Google";
                                            color: white;
                                            font-weight: 700;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        TouchArea {
                                            enabled: !root.premium-locked && !root.google-busy && !root.google-connected;
                                            clicked => { root.google_sign_in(); }
                                        }
                                    }

                                    // Disconnect button (only when connected)
                                    Rectangle {
                                        width: root.google-connected ? 90px : 0px;
                                        height: 32px;
                                        border-radius: 16px;
                                        background: rgba(255,69,58,0.12);
                                        border-color: rgba(255,69,58,0.25);
                                        border-width: 1px;
                                        clip: true;
                                        animate width { duration: 220ms; easing: ease-in-out; }

                                        Text {
                                            text: "Disconnect";
                                            color: #ff453a;
                                            font-weight: 700;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        TouchArea {
                                            enabled: !root.premium-locked && root.google-connected;
                                            clicked => { root.disconnect_google(); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.google-connected: SettingGroup {
                        label: "Connected Calendars (" + root.google-selected-calendars-count + " active)";
                        opacity: root.premium-locked ? 0.36 : 1.0;

                        VerticalLayout {
                            padding-top: 10px;
                            padding-bottom: 10px;
                            padding-left: 20px;
                            padding-right: 20px;
                            spacing: 4px;

                            for cal in root.google-calendars: Rectangle {
                                height: 42px;
                                border-radius: 12px;
                                background: touch-cal.has-hover ? rgba(255,255,255,0.03) : transparent;
                                animate background { duration: 150ms; }

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    alignment: space-between;
                                    spacing: 12px;

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: start;

                                        // Custom checkbox
                                        Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            border-radius: 4px;
                                            border-width: 1.5px;
                                            border-color: cal.selected ? cal.color : rgba(255,255,255,0.25);
                                            background: cal.selected ? cal.color : transparent;
                                            y: (parent.height - self.height) / 2;
                                            animate background { duration: 100ms; }
                                            animate border-color { duration: 100ms; }

                                            if cal.selected: Path {
                                                width: 9px;
                                                height: 7px;
                                                stroke: white;
                                                stroke-width: 2.2px;
                                                fill: transparent;
                                                viewbox-width: 9;
                                                viewbox-height: 7;
                                                commands: "M 1 3.5 L 3.5 6 L 8 1.5";
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }

                                        Text {
                                            text: cal.summary;
                                            color: cal.selected ? white : rgba(255,255,255,0.65);
                                            font-size: 13px;
                                            font-weight: cal.selected ? 700 : 500;
                                            vertical-alignment: center;
                                            animate color { duration: 150ms; }
                                        }
                                    }

                                    // Primary Badge / indicator
                                    if cal.primary: Rectangle {
                                        height: 18px;
                                        border-radius: 9px;
                                        background: rgba(0, 102, 255, 0.15);
                                        border-width: 1px;
                                        border-color: rgba(0, 102, 255, 0.3);
                                        y: (parent.height - self.height) / 2;
                                        
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            alignment: center;
                                            Text {
                                                text: "PRIMARY";
                                                color: #0066FF;
                                                font-size: 9px;
                                                font-weight: 900;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                touch-cal := TouchArea {
                                    enabled: !root.premium-locked;
                                    clicked => {
                                        root.toggle_google_calendar(cal.id);
                                    }
                                }
                            }
                        }
                    }

                    SettingGroup {
                        label: "Advanced Fallback (.ics)";
                        
                        VerticalLayout {
                            padding-left: 30px;
                            padding-right: 30px;
                            padding-top: 16px;
                            padding-bottom: 16px;
                            spacing: 8px;
                            
                            Text { 
                                text: "SOURCE URL"; 
                                color: rgba(255,255,255,0.4); 
                                font-weight: 800; 
                                font-size: 10px; 
                                letter-spacing: 1px; 
                            }
                            
                            Rectangle {
                                height: 36px;
                                border-radius: 18px;
                                background: rgba(255,255,255,0.03);
                                border-color: rgba(255,255,255,0.06);
                                border-width: 1px;
                                
                                TextInput {
                                    text: root.media-calendar-url;
                                    color: white;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    x: 14px;
                                    width: parent.width - 28px;
                                    accepted => { root.string_setting_changed("media-calendar-url", self.text); }
                                }
                            }
                            
                            Text { 
                                text: "Used only when Google Calendar is not connected."; 
                                color: rgba(255,255,255,0.4); 
                                font-weight: 400; 
                                font-size: 10px; 
                            }
                        }
                    }

                }

                // ── 5. SHELF & SHARE (formerly file) ────────────────────────
                if root.active-tab == "shelf": VerticalLayout {
                    spacing: 16px;
                    Text { text: "File Drop"; font-size: 38px; font-weight: 900; color: white; }
                    SectionIntro {
                        tag: "FILE SHELF";
                        tag-color: #6EE7F9;
                        description: "Drop files onto the notch for quick access and sharing.";
                    }
                    Rectangle { height: 12px; }
                    SettingGroup {
                        label: "Shelf Settings";
                        ToggleRow {
                            label: "Enable File Drop Shelf";
                            checked <=> root.drop-enabled;
                            toggled(v) => { root.bool_setting_changed("drop-enabled", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Auto-Expand Notch on File Drop";
                            checked <=> root.drop-auto-expand;
                            toggled(v) => { root.bool_setting_changed("drop-auto-expand", v); }
                            enabled: root.drop-enabled;
                        }
                        Divider {}
                        ToggleRow {
                            label: "Open/Reveal File after Drop";
                            checked <=> root.drop-open-after-drop;
                            toggled(v) => { root.bool_setting_changed("drop-open-after-drop", v); }
                            enabled: root.drop-enabled;
                        }
                        Divider {}
                        SliderRow {
                            label: "Max Files in Drop Shelf";
                            value: root.drop-keep-max;
                            min-value: 5;
                            max-value: 30;
                            unit: "";
                            value_changed(v) => { root.int_setting_changed("drop-keep-max", v); }
                            enabled: root.drop-enabled;
                        }
                    }

                    SettingGroup {
                        label: "Sharing Integration";
                        VerticalLayout {
                            padding-left: 30px;
                            padding-right: 30px;
                            padding-top: 14px;
                            padding-bottom: 16px;
                            spacing: 10px;
                            
                            Text {
                                text: "DEFAULT SHARING PROVIDER";
                                color: rgba(255,255,255,0.35);
                                font-weight: 850;
                                font-size: 9px;
                                letter-spacing: 1.2px;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                ModeBtn {
                                    label: "LocalSend";
                                    selected: root.drop-default-provider == "localsend";
                                    clicked => { root.string_setting_changed("drop-default-provider", "localsend"); }
                                    enabled: root.drop-enabled;
                                }
                                ModeBtn {
                                    label: "Quick Share";
                                    selected: root.drop-default-provider == "quickshare";
                                    clicked => { root.string_setting_changed("drop-default-provider", "quickshare"); }
                                    enabled: root.drop-enabled;
                                }
                                ModeBtn {
                                    label: "KDE Connect";
                                    selected: root.drop-default-provider == "kdeconnect";
                                    clicked => { root.string_setting_changed("drop-default-provider", "kdeconnect"); }
                                    enabled: root.drop-enabled;
                                }
                            }
                        }
                    }
                }

                // ── 6b. CAPTURE STUDIO ─────────────────────────────────
                if root.active-tab == "capture": VerticalLayout {
                    spacing: 16px;
                    Text { text: "Capture Studio"; font-size: 38px; font-weight: 900; color: white; }
                    SectionIntro {
                        tag: "CAPTURE STUDIO";
                        tag-color: #A000FF;
                        description: "Control Raven screenshots, local saves, and recording defaults.";
                    }
                    Rectangle { height: 12px; }

                    SettingGroup {
                        label: "Screenshot Defaults";
                        ToggleRow {
                            label: "Enable Capture Studio";
                            checked <=> root.capture-enabled;
                            toggled(v) => { root.bool_setting_changed("capture-enabled", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Include Cursor in Screenshots";
                            checked <=> root.include-cursor;
                            toggled(v) => { root.bool_setting_changed("include-cursor", v); }
                            enabled: root.capture-enabled;
                        }
                    }

                    SettingGroup {
                        label: "Recording Defaults";
                        ToggleRow {
                            label: "Show Recording Indicator";
                            checked <=> root.show-recording-indicator;
                            toggled(v) => { root.bool_setting_changed("show-recording-indicator", v); }
                            enabled: root.capture-enabled;
                        }
                        Divider {}
                        ToggleRow {
                            label: "Enable Microphone";
                            checked <=> root.mic-enabled;
                            toggled(v) => { root.bool_setting_changed("mic-enabled", v); }
                            enabled: root.capture-enabled;
                        }
                        Divider {}
                        ToggleRow {
                            label: "Capture System Audio";
                            checked <=> root.system-audio-enabled;
                            toggled(v) => { root.bool_setting_changed("system-audio-enabled", v); }
                            enabled: root.capture-enabled;
                        }
                    }
                }

                // ── 7. KEYBOARD SHORTCUTS ──────────────────
                if root.active-tab == "shortcuts": VerticalLayout {
                    spacing: 16px;
                    Text { text: "Keyboard Shortcuts"; font-size: 38px; font-weight: 900; color: white; }
                    SectionIntro {
                        tag: "SHORTCUT STUDIO";
                        tag-color: #6EE7F9;
                        description: "Assign global hotkeys to control Raven Notch instantly.";
                    }
                    Rectangle { height: 12px; }

                    SettingGroup {
                        label: "Navigation";
                        ShortcutRecorderRow {
                            label: "Toggle Raven Notch";
                            hint: "Show or hide Raven Notch instantly.";
                            value: root.shortcut-toggle-raven;
                            is-recording: root.recording-shortcut-key == "toggle_raven";
                            start-recording() => { root.record_shortcut("toggle_raven"); }
                            clear-shortcut() => { root.clear_shortcut("toggle_raven"); }
                        }
                        Divider {}
                        ShortcutRecorderRow {
                            label: "Freeze Raven Notch";
                            hint: "Lock Raven Notch in place until you unfreeze it.";
                            value: root.shortcut-toggle-freeze;
                            is-recording: root.recording-shortcut-key == "toggle_freeze";
                            start-recording() => { root.record_shortcut("toggle_freeze"); }
                            clear-shortcut() => { root.clear_shortcut("toggle_freeze"); }
                        }
                        Divider {}
                        ShortcutRecorderRow {
                            label: "Open Home";
                            hint: "Jump to the Home dashboard.";
                            value: root.shortcut-tab-home;
                            is-recording: root.recording-shortcut-key == "tab_home";
                            start-recording() => { root.record_shortcut("tab_home"); }
                            clear-shortcut() => { root.clear_shortcut("tab_home"); }
                        }
                        Divider {}
                        ShortcutRecorderRow {
                            label: "Open Media";
                            hint: "Jump to the Media panel.";
                            value: root.shortcut-tab-media;
                            is-recording: root.recording-shortcut-key == "tab_media";
                            start-recording() => { root.record_shortcut("tab_media"); }
                            clear-shortcut() => { root.clear_shortcut("tab_media"); }
                        }
                        Divider {}
                        ShortcutRecorderRow {
                            label: "Open Clock";
                            hint: "Jump to the Clock panel.";
                            value: root.shortcut-tab-clock;
                            is-recording: root.recording-shortcut-key == "tab_clock";
                            start-recording() => { root.record_shortcut("tab_clock"); }
                            clear-shortcut() => { root.clear_shortcut("tab_clock"); }
                        }
                        Divider {}
                        ShortcutRecorderRow {
                            label: "Open Drop Shelf";
                            hint: "Jump to the Drop panel.";
                            value: root.shortcut-tab-drop;
                            is-recording: root.recording-shortcut-key == "tab_drop";
                            start-recording() => { root.record_shortcut("tab_drop"); }
                            clear-shortcut() => { root.clear_shortcut("tab_drop"); }
                        }
                        Divider {}
                        ShortcutRecorderRow {
                            label: "Open Stats";
                            hint: "Jump to the Stats panel.";
                            value: root.shortcut-tab-stats;
                            is-recording: root.recording-shortcut-key == "tab_stats";
                            start-recording() => { root.record_shortcut("tab_stats"); }
                            clear-shortcut() => { root.clear_shortcut("tab_stats"); }
                        }
                    }

                    SettingGroup {
                        label: "Playback";
                        ShortcutRecorderRow {
                            label: "Play / Pause";
                            hint: "Toggle the current track.";
                            value: root.shortcut-media-play;
                            is-recording: root.recording-shortcut-key == "media_play";
                            start-recording() => { root.record_shortcut("media_play"); }
                            clear-shortcut() => { root.clear_shortcut("media_play"); }
                        }
                        Divider {}
                        ShortcutRecorderRow {
                            label: "Next Track";
                            hint: "Skip to the next song.";
                            value: root.shortcut-media-next;
                            is-recording: root.recording-shortcut-key == "media_next";
                            start-recording() => { root.record_shortcut("media_next"); }
                            clear-shortcut() => { root.clear_shortcut("media_next"); }
                        }
                        Divider {}
                        ShortcutRecorderRow {
                            label: "Previous Track";
                            hint: "Go back to the previous song.";
                            value: root.shortcut-media-prev;
                            is-recording: root.recording-shortcut-key == "media_prev";
                            start-recording() => { root.record_shortcut("media_prev"); }
                            clear-shortcut() => { root.clear_shortcut("media_prev"); }
                        }
                    }



                    SettingGroup {
                        label: "System";
                        ShortcutRecorderRow {
                            label: "Open Settings";
                            hint: "Open the Raven Notch settings panel.";
                            value: root.shortcut-open-settings;
                            is-recording: root.recording-shortcut-key == "open_settings";
                            start-recording() => { root.record_shortcut("open_settings"); }
                            clear-shortcut() => { root.clear_shortcut("open_settings"); }
                        }
                        Divider {}
                        ShortcutRecorderRow {
                            label: "Restart Raven Notch";
                            hint: "Restart the whole Raven Notch app.";
                            value: root.shortcut-restart-raven;
                            is-recording: root.recording-shortcut-key == "restart_raven";
                            start-recording() => { root.record_shortcut("restart_raven"); }
                            clear-shortcut() => { root.clear_shortcut("restart_raven"); }
                        }
                        Divider {}
                        ShortcutRecorderRow {
                            label: "Quit Raven Notch";
                            hint: "Quit Raven Notch completely.";
                            value: root.shortcut-quit-raven;
                            is-recording: root.recording-shortcut-key == "quit_raven";
                            start-recording() => { root.record_shortcut("quit_raven"); }
                            clear-shortcut() => { root.clear_shortcut("quit_raven"); }
                        }
                    }
                }

                // ── 8. INTELLIGENCE & ALERTS ──────────────
                if root.active-tab == "intelligence": VerticalLayout {
                    spacing: 16px;
                    Text { text: "Intelligence & Alerts"; font-size: 38px; font-weight: 900; color: white; }
                    SectionIntro {
                        tag: "ALERT STUDIO";
                        tag-color: #00FF88;
                        description: "Choose which system events should appear through Raven alerts.";
                    }
                    Rectangle { height: 12px; }

                    SettingGroup {
                        label: "Raven Notch Alert (Pill HUD)";
                        ToggleRow {
                            label: "Enable Raven Notch Alert Engine";
                            checked <=> root.alert-enabled;
                            toggled(v) => { root.bool_setting_changed("alert-enabled", v); }
                        }

                        Divider {}

                        VerticalLayout {
                            padding-left: 30px;
                            padding-right: 30px;
                            padding-top: 14px;
                            padding-bottom: 20px;
                            spacing: 12px;

                            Text { 
                                text: "WHAT TO MONITOR"; 
                                color: rgba(255,255,255,0.4); 
                                font-weight: 850; 
                                font-size: 10px; 
                                letter-spacing: 1px; 
                            }

                            GridLayout {
                                spacing: 10px;
                                Row {
                                    GridSelectionButton {
                                        label: "Charger Connected";
                                        selected <=> root.alert-monitor-charger-in;
                                        clicked => {
    root.alert-monitor-charger-in = !root.alert-monitor-charger-in;
    root.bool_setting_changed("alert-monitor-charger-in", root.alert-monitor-charger-in);
}
                                    }
                                    GridSelectionButton {
                                        label: "Charger Unplugged";
                                        selected <=> root.alert-monitor-charger-out;
                                        clicked => {
    root.alert-monitor-charger-out = !root.alert-monitor-charger-out;
    root.bool_setting_changed("alert-monitor-charger-out", root.alert-monitor-charger-out);
}
                                    }
                                }
                                Row {
                                    GridSelectionButton {
                                        label: "Low Battery Alert";
                                        selected <=> root.alert-monitor-low-battery;
                                        clicked => {
    root.alert-monitor-low-battery = !root.alert-monitor-low-battery;
    root.bool_setting_changed("alert-monitor-low-battery", root.alert-monitor-low-battery);
}
                                    }
                                    GridSelectionButton {
                                        label: "PC Unlock Event";
                                        selected <=> root.alert-monitor-unlock;
                                        clicked => {
    root.alert-monitor-unlock = !root.alert-monitor-unlock;
    root.bool_setting_changed("alert-monitor-unlock", root.alert-monitor-unlock);
}
                                    }
                                }
                                Row {
                                    GridSelectionButton {
                                        label: "Bluetooth Connection";
                                        selected <=> root.alert-monitor-bluetooth;
                                        clicked => {
    root.alert-monitor-bluetooth = !root.alert-monitor-bluetooth;
    root.bool_setting_changed("alert-monitor-bluetooth", root.alert-monitor-bluetooth);
}
                                    }
                                    GridSelectionButton {
                                        label: "Key Overlay";
                                        selected <=> root.alert-monitor-keys;
                                        clicked => {
    root.alert-monitor-keys = !root.alert-monitor-keys;
    root.bool_setting_changed("alert-monitor-keys", root.alert-monitor-keys);
}
                                    }
                                }
                                Row {
                                    GridSelectionButton {
                                        label: "Volume HUD";
                                        selected <=> root.alert-volume-hud;
                                        clicked => {
    root.alert-volume-hud = !root.alert-volume-hud;
    root.bool_setting_changed("alert-volume-hud", root.alert-volume-hud);
}
                                    }
                                    GridSelectionButton {
                                        label: "Brightness HUD";
                                        selected <=> root.alert-brightness-hud;
                                        clicked => {
    root.alert-brightness-hud = !root.alert-brightness-hud;
    root.bool_setting_changed("alert-brightness-hud", root.alert-brightness-hud);
}
                                    }
                                }
                                Row {
                                    GridSelectionButton {
                                        label: "Camera Active";
                                        selected <=> root.alert-monitor-camera;
                                        clicked => {
    root.alert-monitor-camera = !root.alert-monitor-camera;
    root.bool_setting_changed("alert-monitor-camera", root.alert-monitor-camera);
}
                                    }
                                    GridSelectionButton {
                                        label: "Caffeine Active";
                                        selected <=> root.alert-monitor-caffeine;
                                        clicked => {
    root.alert-monitor-caffeine = !root.alert-monitor-caffeine;
    root.bool_setting_changed("alert-monitor-caffeine", root.alert-monitor-caffeine);
}
                                    }
                                }
                            }
                        }
                    }

                    SettingGroup {
                        label: "ALWAYS ON HUB";
                        ToggleRow {
                            label: "Charging Indicator HUD";
                            checked <=> root.intelligence-always-on-charging;
                            toggled(v) => { root.bool_setting_changed("intelligence-always-on-charging", v); }
                        }
                        Divider {}
                        ToggleRow {
                            label: "Battery Low Warning";
                            checked <=> root.intelligence-always-on-low-battery;
                            toggled(v) => { root.bool_setting_changed("intelligence-always-on-low-battery", v); }
                        }
                        Divider {}
                        
                        VerticalLayout {
                            padding-left: 30px;
                            padding-right: 30px;
                            padding-top: 14px;
                            padding-bottom: 16px;
                            spacing: 10px;

                            Text { 
                                text: "DISPLAY MODE CONFIGURATION"; 
                                color: rgba(255,255,255,0.35); 
                                font-weight: 850; 
                                font-size: 9px; 
                                letter-spacing: 1.2px; 
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                ModeBtn {
                                    label: "⚡ Bolt";
                                    selected: root.intelligence-always-on-charging-mode == "bolt";
                                    clicked => { root.string_setting_changed("intelligence-always-on-charging-mode", "bolt"); }
                                }
                                ModeBtn {
                                    label: "% Percent";
                                    selected: root.intelligence-always-on-charging-mode == "pct";
                                    clicked => { root.string_setting_changed("intelligence-always-on-charging-mode", "pct"); }
                                }
                                ModeBtn {
                                    label: "🔋 Aura";
                                    selected: root.intelligence-always-on-charging-mode == "battery";
                                    clicked => { root.string_setting_changed("intelligence-always-on-charging-mode", "battery"); }
                                }
                            }
                        }
                    }
                }

                // ── DESKTOP WIDGET ENGINE (WIDGET STUDIO REDESIGN) ──
                if root.active-tab == "widgets": HorizontalLayout {
                    spacing: 16px;
                    alignment: stretch;
                    height: content-scroll.visible-height - 60px;
                    
                    // Left Area: Widget Studio Library & Active Widgets List (70% width)
                    VerticalLayout {
                        spacing: 20px;
                        horizontal-stretch: 1;
                        
                        // Header
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Widget Studio"; font-size: 32px; font-weight: 900; color: white; }
                            Text { text: "Choose and customize widgets to build your perfect desktop workspace."; font-size: 13px; color: rgba(255,255,255,0.4); }
                        }

                        if root.premium-locked: PremiumLockNotice {
                            title: "Your Raven trial period is over";
                            message: "Desktop Widgets are premium. Buy Raven Notch to unlock them.";
                            buy => { root.open-url("https://ravennotch.me/"); }
                        }


                        // Grid of Available Widgets — squarish cards, side by side
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            
                            // 1. Clock Widget
                            WidgetCard {
                                title: "Clock Widget"; size-label: "";
                                width: 160px;
                                height: 162px;
                                is-active: root.widgets-enabled && root.widgets-stats-enabled;
                                is-selected: root.selected-widget-id == "stats";
                                clicked => { root.selected-widget-id = "stats"; }
                                add_clicked => {
                                    root.widgets-enabled = true;
                                    root.widgets-stats-enabled = true;
                                    root.bool_setting_changed("widgets-enabled", true);
                                    root.bool_setting_changed("widgets-stats-enabled", true);
                                    root.widgets-clock-count = root.widgets-clock-count + 1;
                                    root.int_setting_changed("widgets-clock-count", root.widgets-clock-count);
                                    root.selected-widget-id = "stats";
                                    root.selected-clock-index = max(0, root.widgets-clock-count - 1);
                                    root.selected_clock_changed(root.selected-clock-index);
                                }
                                
                                // Clock preview (compact squarish)
                                Rectangle {
                                    height: 100px;
                                    border-radius: 12px;
                                    background: @linear-gradient(145deg, rgba(22, 22, 26, 0.80) 0%, rgba(5, 5, 8, 0.85) 100%);
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.10);

                                    Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        border-radius: parent.border-radius;
                                        background: @linear-gradient(135deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.0) 40%);
                                    }

                                    VerticalLayout {
                                        padding-left: 10px; padding-right: 10px;
                                        padding-top: 6px; padding-bottom: 8px;
                                        spacing: 0px;

                                        HorizontalLayout {
                                            height: 20px;
                                            alignment: space-between;
                                            Text { text: "CLOCK"; font-size: 7px; font-weight: 950; color: rgba(255,255,255,0.7); vertical-alignment: center; }
                                            Text { text: "DRAG"; font-size: 6px; font-weight: 950; color: rgba(255,255,255,0.25); vertical-alignment: center; }
                                        }

                                        Text {
                                            text: "12:07";
                                            font-size: 24px;
                                            font-weight: 760;
                                            color: #FFFFFF;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: "Wednesday, 20 May";
                                            font-size: 8px;
                                            font-weight: 700;
                                            color: rgba(255,255,255,0.5);
                                        }
                                    }
                                }
                            }

                            // 2. Year Progress Widget
                            WidgetCard {
                                title: "Year Progress"; size-label: "";
                                width: 160px;
                                height: 162px;
                                is-active: root.widgets-enabled && root.widgets-year-progress-enabled;
                                is-selected: root.selected-widget-id == "year_progress";
                                clicked => { root.selected-widget-id = "year_progress"; }
                                add_clicked => {
                                    root.widgets-enabled = true;
                                    root.widgets-year-progress-enabled = true;
                                    root.bool_setting_changed("widgets-enabled", true);
                                    root.bool_setting_changed("widgets-year-progress-enabled", true);
                                    root.selected-widget-id = "year_progress";
                                    root.settings_widgets_apply_changes();
                                }
                                
                                // Year progress preview (compact squarish)
                                Rectangle {
                                    height: 100px;
                                    border-radius: 12px;
                                    background: @linear-gradient(145deg, rgba(22, 22, 26, 0.80) 0%, rgba(5, 5, 8, 0.85) 100%);
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.10);

                                    Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        border-radius: parent.border-radius;
                                        background: @linear-gradient(135deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.0) 40%);
                                    }

                                    VerticalLayout {
                                        padding-left: 10px; padding-right: 10px;
                                        padding-top: 6px; padding-bottom: 8px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            height: 20px;
                                            alignment: space-between;
                                            Text { text: "YEAR JOURNEY"; font-size: 7px; font-weight: 950; color: #FFD200; vertical-alignment: center; }
                                            Text { text: "DRAG"; font-size: 6px; font-weight: 950; color: rgba(255,255,255,0.25); vertical-alignment: center; }
                                        }

                                        Text {
                                            text: "43.5%";
                                            font-size: 20px;
                                            font-weight: 760;
                                            color: #FFFFFF;
                                            vertical-alignment: center;
                                        }

                                        // Progress Bar preview
                                        Rectangle {
                                            height: 6px;
                                            background: rgba(255, 255, 255, 0.1);
                                            border-radius: 3px;
                                            Rectangle {
                                                x: 0;
                                                width: parent.width * 0.435;
                                                height: 100%;
                                                background: @linear-gradient(90deg, #FFD200 0%, #FF9500 100%);
                                                border-radius: 3px;
                                            }
                                        }
                                    }
                                }
                            }

                            // 3. Day Progress Widget
                            WidgetCard {
                                title: "Day Progress"; size-label: "";
                                width: 160px;
                                height: 162px;
                                is-active: root.widgets-enabled && root.widgets-day-progress-enabled;
                                is-selected: root.selected-widget-id == "day_progress";
                                clicked => { root.selected-widget-id = "day_progress"; }
                                add_clicked => {
                                    root.widgets-enabled = true;
                                    root.widgets-day-progress-enabled = true;
                                    root.bool_setting_changed("widgets-enabled", true);
                                    root.bool_setting_changed("widgets-day-progress-enabled", true);
                                    root.selected-widget-id = "day_progress";
                                    root.settings_widgets_apply_changes();
                                }
                                
                                // Day progress preview (compact squarish)
                                Rectangle {
                                    height: 100px;
                                    border-radius: 12px;
                                    background: @linear-gradient(145deg, rgba(22, 22, 26, 0.80) 0%, rgba(5, 5, 8, 0.85) 100%);
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.10);

                                    Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        border-radius: parent.border-radius;
                                        background: @linear-gradient(135deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.0) 40%);
                                    }

                                    VerticalLayout {
                                        padding-left: 10px; padding-right: 10px;
                                        padding-top: 6px; padding-bottom: 8px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            height: 20px;
                                            alignment: space-between;
                                            Text { text: "DAY JOURNEY"; font-size: 7px; font-weight: 950; color: #00E5FF; vertical-alignment: center; }
                                            Text { text: "DRAG"; font-size: 6px; font-weight: 950; color: rgba(255,255,255,0.25); vertical-alignment: center; }
                                        }

                                        Text {
                                            text: "43.5%";
                                            font-size: 20px;
                                            font-weight: 760;
                                            color: #FFFFFF;
                                            vertical-alignment: center;
                                        }

                                        // Progress Bar preview
                                        Rectangle {
                                            height: 6px;
                                            background: rgba(255, 255, 255, 0.1);
                                            border-radius: 3px;
                                            Rectangle {
                                                x: 0;
                                                width: parent.width * 0.435;
                                                height: 100%;
                                                background: @linear-gradient(90deg, #00E5FF 0%, #0066FF 100%);
                                                border-radius: 3px;
                                            }
                                        }
                                    }
                                }
                            }

                            // 4. Month Progress Widget
                            WidgetCard {
                                title: "Month Progress"; size-label: "";
                                width: 160px;
                                height: 162px;
                                is-active: root.widgets-enabled && root.widgets-month-progress-enabled;
                                is-selected: root.selected-widget-id == "month_progress";
                                clicked => { root.selected-widget-id = "month_progress"; }
                                add_clicked => {
                                    root.widgets-enabled = true;
                                    root.widgets-month-progress-enabled = true;
                                    root.bool_setting_changed("widgets-enabled", true);
                                    root.bool_setting_changed("widgets-month-progress-enabled", true);
                                    root.selected-widget-id = "month_progress";
                                    root.settings_widgets_apply_changes();
                                }
                                
                                // Month progress preview (compact squarish)
                                Rectangle {
                                    height: 100px;
                                    border-radius: 12px;
                                    background: @linear-gradient(145deg, rgba(22, 22, 26, 0.80) 0%, rgba(5, 5, 8, 0.85) 100%);
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.10);

                                    Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        border-radius: parent.border-radius;
                                        background: @linear-gradient(135deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.0) 40%);
                                    }

                                    VerticalLayout {
                                        padding-left: 10px; padding-right: 10px;
                                        padding-top: 6px; padding-bottom: 8px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            height: 20px;
                                            alignment: space-between;
                                            Text { text: "MONTH JOURNEY"; font-size: 7px; font-weight: 950; color: #FF2D55; vertical-alignment: center; }
                                            Text { text: "DRAG"; font-size: 6px; font-weight: 950; color: rgba(255,255,255,0.25); vertical-alignment: center; }
                                        }

                                        Text {
                                            text: "43.5%";
                                            font-size: 20px;
                                            font-weight: 760;
                                            color: #FFFFFF;
                                            vertical-alignment: center;
                                        }

                                        // Progress Bar preview
                                        Rectangle {
                                            height: 6px;
                                            background: rgba(255, 255, 255, 0.1);
                                            border-radius: 3px;
                                            Rectangle {
                                                x: 0;
                                                width: parent.width * 0.435;
                                                height: 100%;
                                                background: @linear-gradient(90deg, #FF2D55 0%, #A000FF 100%);
                                                border-radius: 3px;
                                            }
                                        }
                                    }
                                }
                            }

                            // 5. Media Player Widget
                            WidgetCard {
                                title: "Media Player"; size-label: "";
                                width: 160px;
                                height: 162px;
                                is-active: root.widgets-enabled && root.widgets-media-enabled;
                                is-selected: root.selected-widget-id == "media";
                                clicked => { root.selected-widget-id = "media"; }
                                add_clicked => {
                                    root.widgets-enabled = true;
                                    root.widgets-media-enabled = true;
                                    root.bool_setting_changed("widgets-enabled", true);
                                    root.bool_setting_changed("widgets-media-enabled", true);
                                    root.selected-widget-id = "media";
                                    root.settings_widgets_apply_changes();
                                }
                                
                                // Media preview (compact squarish)
                                Rectangle {
                                    height: 100px;
                                    border-radius: 12px;
                                    background: @linear-gradient(145deg, rgba(22, 22, 26, 0.80) 0%, rgba(5, 5, 8, 0.85) 100%);
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.10);

                                    Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        border-radius: parent.border-radius;
                                        background: @linear-gradient(135deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.0) 40%);
                                    }

                                    VerticalLayout {
                                        padding-left: 10px; padding-right: 10px;
                                        padding-top: 6px; padding-bottom: 8px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            height: 20px;
                                            alignment: space-between;
                                            Text { text: "MEDIA PLAYER"; font-size: 7px; font-weight: 950; color: #A000FF; vertical-alignment: center; }
                                            Text { text: "DRAG"; font-size: 6px; font-weight: 950; color: rgba(255,255,255,0.25); vertical-alignment: center; }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            
                                            // Mini Album art
                                            Rectangle {
                                                width: 28px;
                                                height: 28px;
                                                border-radius: 6px;
                                                background: rgba(255, 255, 255, 0.05);
                                                clip: true;
                                                Image {
                                                    source: @image-url("assets/rihanna_art.png");
                                                    width: 100%;
                                                    height: 100%;
                                                    image-fit: cover;
                                                }
                                            }
                                            
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 1px;
                                                Text { text: "Love On The Brain"; font-size: 8px; font-weight: 700; color: white; overflow: elide; width: 90px; }
                                                Text { text: "Rihanna"; font-size: 7px; font-weight: 600; color: #A000FF; overflow: elide; width: 90px; }
                                            }
                                        }

                                        // Progress Bar preview
                                        Rectangle {
                                            height: 4px;
                                            background: rgba(255, 255, 255, 0.1);
                                            border-radius: 2px;
                                            Rectangle {
                                                x: 0;
                                                width: parent.width * 0.11;
                                                height: 100%;
                                                background: #A000FF;
                                                border-radius: 2px;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Row 2 of Grid of Available Widgets
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;

                            // 6. Notes Widget
                            WidgetCard {
                                title: "Notes Widget"; size-label: "";
                                width: 160px;
                                height: 162px;
                                is-active: root.widgets-enabled && root.widgets-notes-enabled;
                                is-selected: root.selected-widget-id == "notes";
                                clicked => { root.selected-widget-id = "notes"; }
                                add_clicked => {
                                    root.widgets-enabled = true;
                                    root.widgets-notes-enabled = true;
                                    root.bool_setting_changed("widgets-enabled", true);
                                    root.bool_setting_changed("widgets-notes-enabled", true);
                                    root.selected-widget-id = "notes";
                                    root.settings_widgets_apply_changes();
                                }

                                Rectangle {
                                    height: 100px;
                                    border-radius: 12px;
                                    background: @linear-gradient(145deg, rgba(22, 22, 26, 0.80) 0%, rgba(5, 5, 8, 0.85) 100%);
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.10);

                                    VerticalLayout {
                                        padding-left: 10px; padding-right: 10px;
                                        padding-top: 6px; padding-bottom: 8px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            height: 20px;
                                            alignment: space-between;
                                            Text { text: "QUICK NOTES"; font-size: 7px; font-weight: 950; color: #FFCC00; vertical-alignment: center; }
                                            Text { text: "DRAG"; font-size: 6px; font-weight: 950; color: rgba(255,255,255,0.25); vertical-alignment: center; }
                                        }

                                        Text {
                                            text: "Write quick thoughts, lists, and reminders.";
                                            font-size: 9px;
                                            color: rgba(255, 255, 255, 0.6);
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            // 7. To-Do List Widget
                            WidgetCard {
                                title: "To-Do List"; size-label: "";
                                width: 160px;
                                height: 162px;
                                is-active: root.widgets-enabled && root.widgets-todo-enabled;
                                is-selected: root.selected-widget-id == "todo";
                                clicked => { root.selected-widget-id = "todo"; }
                                add_clicked => {
                                    root.widgets-enabled = true;
                                    root.widgets-todo-enabled = true;
                                    root.bool_setting_changed("widgets-enabled", true);
                                    root.bool_setting_changed("widgets-todo-enabled", true);
                                    root.selected-widget-id = "todo";
                                    root.settings_widgets_apply_changes();
                                }

                                Rectangle {
                                    height: 100px;
                                    border-radius: 12px;
                                    background: @linear-gradient(145deg, rgba(22, 22, 26, 0.80) 0%, rgba(5, 5, 8, 0.85) 100%);
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.10);

                                    VerticalLayout {
                                        padding-left: 10px; padding-right: 10px;
                                        padding-top: 6px; padding-bottom: 8px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            height: 20px;
                                            alignment: space-between;
                                            Text { text: "TO-DO LIST"; font-size: 7px; font-weight: 950; color: #FF9500; vertical-alignment: center; }
                                            Text { text: "DRAG"; font-size: 6px; font-weight: 950; color: rgba(255,255,255,0.25); vertical-alignment: center; }
                                        }

                                        // Mini Checklist
                                        VerticalLayout {
                                            spacing: 4px;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Rectangle { width: 8px; height: 8px; border-radius: 2px; background: #FF9500; }
                                                Text { text: "Review layout plan"; font-size: 8px; color: rgba(255,255,255,0.4); vertical-alignment: center; }
                                            }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Rectangle { width: 8px; height: 8px; border-radius: 2px; border-width: 1px; border-color: rgba(255,255,255,0.3); }
                                                Text { text: "Test new widgets"; font-size: 8px; color: rgba(255,255,255,0.8); vertical-alignment: center; }
                                            }
                                        }
                                    }
                                }
                            }

                            // 8. Quotes Widget
                            WidgetCard {
                                title: "Daily Quotes"; size-label: "";
                                width: 160px;
                                height: 162px;
                                is-active: root.widgets-enabled && root.widgets-quotes-enabled;
                                is-selected: root.selected-widget-id == "quotes";
                                clicked => { root.selected-widget-id = "quotes"; }
                                add_clicked => {
                                    root.widgets-enabled = true;
                                    root.widgets-quotes-enabled = true;
                                    root.bool_setting_changed("widgets-enabled", true);
                                    root.bool_setting_changed("widgets-quotes-enabled", true);
                                    root.selected-widget-id = "quotes";
                                    root.settings_widgets_apply_changes();
                                }

                                Rectangle {
                                    height: 100px;
                                    border-radius: 12px;
                                    background: @linear-gradient(145deg, rgba(22, 22, 26, 0.80) 0%, rgba(5, 5, 8, 0.85) 100%);
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.10);

                                    VerticalLayout {
                                        padding-left: 10px; padding-right: 10px;
                                        padding-top: 6px; padding-bottom: 8px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            height: 20px;
                                            alignment: space-between;
                                            Text { text: "DAILY WISDOM"; font-size: 7px; font-weight: 950; color: #FF2D55; vertical-alignment: center; }
                                            Text { text: "DRAG"; font-size: 6px; font-weight: 950; color: rgba(255,255,255,0.25); vertical-alignment: center; }
                                        }

                                        Text {
                                            text: "“Everything is within.”";
                                            font-size: 10px;
                                            font-italic: true;
                                            color: #FFFFFF;
                                            horizontal-alignment: center;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            // 9. Picture Widget
                            WidgetCard {
                                title: "Picture Frame"; size-label: "";
                                width: 160px;
                                height: 162px;
                                is-active: root.widgets-enabled && root.widgets-picture-enabled;
                                is-selected: root.selected-widget-id == "picture";
                                clicked => { root.selected-widget-id = "picture"; }
                                add_clicked => {
                                    root.widgets-enabled = true;
                                    root.widgets-picture-enabled = true;
                                    root.bool_setting_changed("widgets-enabled", true);
                                    root.bool_setting_changed("widgets-picture-enabled", true);
                                    root.selected-widget-id = "picture";
                                    root.settings_widgets_apply_changes();
                                }

                                Rectangle {
                                    height: 100px;
                                    border-radius: 12px;
                                    background: @linear-gradient(145deg, rgba(22, 22, 26, 0.80) 0%, rgba(5, 5, 8, 0.85) 100%);
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.10);
                                    clip: true;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        
                                        HorizontalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 24px;
                                                height: 24px;
                                                border-radius: 12px;
                                                background: rgba(255,255,255,0.06);
                                                
                                                Path {
                                                    width: 10px;
                                                    height: 10px;
                                                    x: 7px;
                                                    y: 7px;
                                                    stroke: white;
                                                    stroke-width: 2px;
                                                    stroke-line-cap: round;
                                                    commands: "M5 0v10 M0 5h10";
                                                }
                                            }
                                        }
                                        
                                        Text {
                                            text: "Click to select image";
                                            font-size: 8px;
                                            font-weight: 600;
                                            color: rgba(255, 255, 255, 0.4);
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }

                            // 10. Video Frame Widget
                            WidgetCard {
                                title: "Video Frame"; size-label: "";
                                width: 160px;
                                height: 162px;
                                is-active: root.widgets-enabled && root.widgets-video-enabled;
                                is-selected: root.selected-widget-id == "video";
                                clicked => { root.selected-widget-id = "video"; }
                                add_clicked => {
                                    root.widgets-enabled = true;
                                    root.widgets-video-enabled = true;
                                    root.bool_setting_changed("widgets-enabled", true);
                                    root.bool_setting_changed("widgets-video-enabled", true);
                                    root.selected-widget-id = "video";
                                    root.settings_widgets_apply_changes();
                                }

                                Rectangle {
                                    height: 100px;
                                    border-radius: 12px;
                                    background: @linear-gradient(145deg, rgba(22, 22, 26, 0.80) 0%, rgba(5, 5, 8, 0.85) 100%);
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.10);
                                    clip: true;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        
                                        HorizontalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 24px;
                                                height: 24px;
                                                border-radius: 12px;
                                                background: rgba(255,255,255,0.06);
                                                
                                                Path {
                                                    width: 10px;
                                                    height: 10px;
                                                    x: 7px;
                                                    y: 7px;
                                                    stroke: white;
                                                    stroke-width: 2px;
                                                    stroke-line-cap: round;
                                                    commands: "M5 0v10 M0 5h10";
                                                }
                                            }
                                        }
                                        
                                        Text {
                                            text: "Click to select GIF or video";
                                            font-size: 8px;
                                            font-weight: 600;
                                            color: rgba(255, 255, 255, 0.4);
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Row 3 of Grid of Available Widgets
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;

                            // 11. Battery Percentage Widget
                            WidgetCard {
                                title: "Battery Percentage"; size-label: "";
                                width: 160px;
                                height: 162px;
                                is-active: root.widgets-enabled && root.widgets-battery-enabled;
                                is-selected: root.selected-widget-id == "battery";
                                clicked => { root.selected-widget-id = "battery"; }
                                add_clicked => {
                                    root.widgets-enabled = true;
                                    root.widgets-battery-enabled = true;
                                    root.bool_setting_changed("widgets-enabled", true);
                                    root.bool_setting_changed("widgets-battery-enabled", true);
                                    root.selected-widget-id = "battery";
                                    root.settings_widgets_apply_changes();
                                }

                                Rectangle {
                                    height: 100px;
                                    border-radius: 12px;
                                    background: @linear-gradient(145deg, rgba(22, 22, 26, 0.80) 0%, rgba(5, 5, 8, 0.85) 100%);
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.10);
                                    clip: true;

                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        padding-top: 8px; padding-bottom: 8px;
                                        alignment: center;
                                        spacing: 4px;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            
                                            // Left side: Text percentage and state
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "85%";
                                                    font-size: 26px;
                                                    font-weight: 760;
                                                    color: white;
                                                }
                                                Text {
                                                    text: "Discharging";
                                                    font-size: 9px;
                                                    font-weight: 600;
                                                    color: rgba(255, 255, 255, 0.5);
                                                }
                                            }

                                            // Right side: Progress ring and battery graphic
                                            Rectangle {
                                                width: 44px;
                                                height: 44px;
                                                
                                                // Outer progress ring track
                                                Rectangle {
                                                    width: 100%; height: 100%; border-radius: 22px;
                                                    border-width: 3px; border-color: rgba(255, 255, 255, 0.08);
                                                }
                                                // Colored progress active indicator
                                                Rectangle {
                                                    width: 100%; height: 100%; border-radius: 22px;
                                                    border-width: 3px; border-color: #34C759;
                                                }
                                                
                                                // Battery outline inside
                                                Rectangle {
                                                    width: 20px; height: 12px; border-width: 1.5px; border-radius: 2px; border-color: rgba(255,255,255,0.85);
                                                    x: 12px; y: 16px;
                                                    Rectangle {
                                                        x: 2px; y: 2px; width: 12px; height: 5px; border-radius: 1px; background: #34C759;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // 12. Calendar Focus Widget
                            WidgetCard {
                                title: "Calendar Focus"; size-label: "";
                                width: 160px;
                                height: 162px;
                                is-active: root.widgets-enabled && root.widgets-calendar-focus-enabled;
                                is-selected: root.selected-widget-id == "calendar_focus";
                                clicked => { root.selected-widget-id = "calendar_focus"; }
                                add_clicked => {
                                    root.widgets-enabled = true;
                                    root.widgets-calendar-focus-enabled = true;
                                    root.bool_setting_changed("widgets-enabled", true);
                                    root.bool_setting_changed("widgets-calendar-focus-enabled", true);
                                    root.selected-widget-id = "calendar_focus";
                                    root.settings_widgets_apply_changes();
                                }

                                Rectangle {
                                    height: 100px;
                                    border-radius: 12px;
                                    background: @linear-gradient(145deg, rgba(22, 22, 26, 0.80) 0%, rgba(5, 5, 8, 0.85) 100%);
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.10);
                                    clip: true;

                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        alignment: center;
                                        
                                        HorizontalLayout {
                                            alignment: space-between;
                                            
                                            // Left side: Date info
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                
                                                HorizontalLayout {
                                                    spacing: 4px;
                                                    alignment: center;
                                                    Text { text: "Thu"; font-size: 11px; font-weight: 800; color: #FF453A; }
                                                    Text { text: "Sep"; font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.4); }
                                                }
                                                
                                                Text {
                                                    text: "11";
                                                    font-size: 32px;
                                                    font-weight: 720;
                                                    color: white;
                                                    horizontal-alignment: center;
                                                }
                                            }
                                            
                                            // Right side: Timer ring
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                
                                                Rectangle {
                                                    width: 44px;
                                                    height: 44px;
                                                    
                                                    // Progress ring track
                                                    Rectangle {
                                                        width: 100%; height: 100%; border-radius: 22px;
                                                        border-width: 3px; border-color: rgba(255, 255, 255, 0.08);
                                                    }
                                                    Rectangle {
                                                        width: 100%; height: 100%; border-radius: 22px;
                                                        border-width: 3px; border-color: #FF453A;
                                                    }
                                                    
                                                    Text {
                                                        text: "25:00";
                                                        font-size: 10px;
                                                        font-weight: 760;
                                                        color: white;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                
                                                // Focus button
                                                Rectangle {
                                                    width: 38px; height: 14px; border-radius: 3px;
                                                    background: rgba(10, 132, 255, 0.18);
                                                    x: (parent.width - self.width) / 2;
                                                    Text {
                                                        text: "FOCUS";
                                                        color: #3DA5FF;
                                                        font-size: 6px;
                                                        font-weight: 850;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // 13. Apps Container Widget
                            WidgetCard {
                                title: "Apps Container"; size-label: "";
                                width: 160px;
                                height: 162px;
                                is-active: root.widgets-enabled && root.widgets-apps-container-enabled;
                                is-selected: root.selected-widget-id == "apps_container";
                                clicked => { root.selected-widget-id = "apps_container"; }
                                add_clicked => {
                                    root.widgets-enabled = true;
                                    root.widgets-apps-container-enabled = true;
                                    root.bool_setting_changed("widgets-enabled", true);
                                    root.bool_setting_changed("widgets-apps-container-enabled", true);
                                    root.selected-widget-id = "apps_container";
                                    root.settings_widgets_apply_changes();
                                }

                                Rectangle {
                                    height: 100px;
                                    border-radius: 12px;
                                    background: @linear-gradient(145deg, rgba(22, 22, 26, 0.80) 0%, rgba(5, 5, 8, 0.85) 100%);
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.10);
                                    clip: true;

                                    VerticalLayout {
                                        padding-left: 10px; padding-right: 10px;
                                        padding-top: 8px; padding-bottom: 8px;
                                        alignment: center;
                                        spacing: 6px;

                                        HorizontalLayout {
                                            height: 20px;
                                            alignment: space-between;
                                            Text { text: "APPS DOCK"; font-size: 7px; font-weight: 950; color: #B000FF; vertical-alignment: center; }
                                            Text { text: "DROP"; font-size: 6px; font-weight: 950; color: rgba(255,255,255,0.25); vertical-alignment: center; }
                                        }

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 8px;
                                            
                                            // Simulated App 1
                                            Rectangle { width: 22px; height: 22px; border-radius: 6px; background: #FF3B30; }
                                            // Simulated App 2
                                            Rectangle { width: 22px; height: 22px; border-radius: 6px; background: #007AFF; }
                                            // Simulated App 3
                                            Rectangle { width: 22px; height: 22px; border-radius: 6px; background: #34C759; }
                                            // Simulated App 4
                                            Rectangle { width: 22px; height: 22px; border-radius: 6px; background: #FF9500; }
                                        }

                                        Text {
                                            text: "Launch shortcuts";
                                            font-size: 8px;
                                            font-weight: 600;
                                            color: rgba(255, 255, 255, 0.4);
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }

                            // 14. Calendar Widget
                            WidgetCard {
                                title: "Calendar Widget"; size-label: "";
                                width: 160px;
                                height: 162px;
                                is-active: root.widgets-enabled && root.widgets-streak-enabled;
                                is-selected: root.selected-widget-id == "streak";
                                clicked => { root.selected-widget-id = "streak"; }
                                add_clicked => {
                                    root.widgets-enabled = true;
                                    root.widgets-streak-enabled = true;
                                    root.bool_setting_changed("widgets-enabled", true);
                                    root.bool_setting_changed("widgets-streak-enabled", true);
                                    root.selected-widget-id = "streak";
                                    root.settings_widgets_apply_changes();
                                }

                                Rectangle {
                                    height: 100px;
                                    border-radius: 12px;
                                    background: @linear-gradient(145deg, rgba(22, 22, 26, 0.80) 0%, rgba(5, 5, 8, 0.85) 100%);
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.10);
                                    clip: true;

                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        alignment: center;
                                        
                                        HorizontalLayout {
                                            alignment: space-between;
                                            
                                            // Left side: Mini calendar sheet icon/date
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                Text { text: "MONDAY"; font-size: 8px; font-weight: 800; color: #007AFF; }
                                                Text { text: "September"; font-size: 8px; font-weight: 600; color: rgba(255,255,255,0.7); }
                                                Text { text: "07"; font-size: 26px; font-weight: 700; color: white; }
                                            }
                                            
                                            // Right side: Simulated calendar grid
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 3px;
                                                
                                                // Header: S M T W T F S
                                                HorizontalLayout {
                                                    spacing: 4px;
                                                    for day in ["S", "M", "T", "W", "T", "F", "S"]: Text {
                                                        text: day; font-size: 6px; font-weight: 800; color: rgba(255,255,255,0.4); width: 8px; horizontal-alignment: center;
                                                    }
                                                }
                                                
                                                // Grid row 1
                                                HorizontalLayout {
                                                    spacing: 4px;
                                                    for val in [1, 2, 3, 4, 5, 6, 7]: Rectangle {
                                                        width: 8px; height: 8px; border-radius: 4px;
                                                        background: val == 7 ? #007AFF : rgba(255, 255, 255, 0.05);
                                                    }
                                                }
                                                
                                                // Grid row 2
                                                HorizontalLayout {
                                                    spacing: 4px;
                                                    for val in [8, 9, 10, 11, 12, 13, 14]: Rectangle {
                                                        width: 8px; height: 8px; border-radius: 4px;
                                                        background: rgba(255, 255, 255, 0.05);
                                                    }
                                                }
                                                
                                                // Grid row 3
                                                HorizontalLayout {
                                                    spacing: 4px;
                                                    for val in [15, 16, 17, 18, 19, 20, 21]: Rectangle {
                                                        width: 8px; height: 8px; border-radius: 4px;
                                                        background: rgba(255, 255, 255, 0.05);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // 15. Focus Score Widget
                            WidgetCard {
                                title: "Focus Score"; size-label: "";
                                width: 160px;
                                height: 162px;
                                is-active: root.widgets-enabled && root.widgets-focus-score-enabled;
                                is-selected: root.selected-widget-id == "focus_score";
                                clicked => { root.selected-widget-id = "focus_score"; }
                                add_clicked => {
                                    root.widgets-enabled = true;
                                    root.widgets-focus-score-enabled = true;
                                    root.bool_setting_changed("widgets-enabled", true);
                                    root.bool_setting_changed("widgets-focus-score-enabled", true);
                                    root.selected-widget-id = "focus_score";
                                    root.settings_widgets_apply_changes();
                                }

                                Rectangle {
                                    height: 100px;
                                    border-radius: 12px;
                                    background: @linear-gradient(145deg, rgba(22, 22, 26, 0.80) 0%, rgba(5, 5, 8, 0.85) 100%);
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.10);
                                    clip: true;

                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        alignment: center;
                                        
                                        HorizontalLayout {
                                            alignment: space-between;
                                            
                                            // Left side: Total Focus score/label
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                Text { text: "FOCUS SCORE"; font-size: 8px; font-weight: 900; color: rgba(255,255,255,0.6); }
                                                Text { text: "120m"; font-size: 20px; font-weight: 950; color: white; }
                                                Text { text: "Total Focus"; font-size: 8px; color: rgba(255,255,255,0.4); }
                                            }
                                            
                                            // Right side: Score ring
                                            VerticalLayout {
                                                alignment: center;
                                                
                                                Rectangle {
                                                    width: 44px;
                                                    height: 44px;
                                                    
                                                    // Progress ring track
                                                    Rectangle {
                                                        width: 100%; height: 100%; border-radius: 22px;
                                                        border-width: 3px; border-color: rgba(255, 255, 255, 0.08);
                                                    }
                                                    Rectangle {
                                                        width: 100%; height: 100%; border-radius: 22px;
                                                        border-width: 3px; border-color: #a855f7;
                                                    }
                                                    
                                                    Text {
                                                        text: "85";
                                                        font-size: 14px;
                                                        font-weight: 950;
                                                        color: white;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Spacer to push Active Widgets to the bottom
                        Rectangle { vertical-stretch: 1; }

                        // Bottom Section: Active Widgets List
                        VerticalLayout {
                            spacing: 10px;
                            
                            HorizontalLayout {
                                alignment: space-between;
                                height: 22px;
                                Text { text: "Active Widgets"; font-size: 15px; font-weight: 800; color: white; vertical-alignment: center; }
                                
                                TouchArea {
                                    height: 22px;
                                    Text { text: "Clear All"; font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.4); vertical-alignment: center; }
                                    clicked => {
                                        root.widgets-stats-enabled = false;
                                        root.widgets-year-progress-enabled = false;
                                        root.widgets-day-progress-enabled = false;
                                        root.widgets-month-progress-enabled = false;
                                        root.widgets-media-enabled = false;
                                        root.widgets-notes-enabled = false;
                                        root.widgets-todo-enabled = false;
                                        root.widgets-quotes-enabled = false;
                                        root.widgets-picture-enabled = false;
                                        root.widgets-video-enabled = false;
                                        root.widgets-battery-enabled = false;
                                        root.widgets-calendar-focus-enabled = false;
                                        root.widgets-apps-container-enabled = false;
                                        root.widgets-streak-enabled = false;
                                        root.widgets-focus-score-enabled = false;
                                        root.widgets-clock-count = 0;
                                        
                                        root.bool_setting_changed("widgets-stats-enabled", false);
                                        root.bool_setting_changed("widgets-year-progress-enabled", false);
                                        root.bool_setting_changed("widgets-day-progress-enabled", false);
                                        root.bool_setting_changed("widgets-month-progress-enabled", false);
                                        root.bool_setting_changed("widgets-media-enabled", false);
                                        root.bool_setting_changed("widgets-notes-enabled", false);
                                        root.bool_setting_changed("widgets-todo-enabled", false);
                                        root.bool_setting_changed("widgets-quotes-enabled", false);
                                        root.bool_setting_changed("widgets-picture-enabled", false);
                                        root.bool_setting_changed("widgets-video-enabled", false);
                                        root.bool_setting_changed("widgets-battery-enabled", false);
                                        root.bool_setting_changed("widgets-calendar-focus-enabled", false);
                                        root.bool_setting_changed("widgets-apps-container-enabled", false);
                                        root.bool_setting_changed("widgets-streak-enabled", false);
                                        root.bool_setting_changed("widgets-focus-score-enabled", false);
                                        root.int_setting_changed("widgets-clock-count", 0);
                                        
                                        root.settings_widgets_apply_changes();
                                    }
                                }
                            }
                            
                            Flickable {
                                height: 105px;
                                interactive: true;
                                HorizontalLayout {
                                    min-width: 1600px;
                                    spacing: 10px;
                                    alignment: start;

                                // Render chips in add-order using the ordered list from backend
                                for active_widget in root.widgets-active-rows: Rectangle {
                                    width: 160px; border-radius: 12px;
                                    background: (root.selected-widget-id == active_widget.id ||
                                        (active_widget.kind == "clock_0" && root.selected-widget-id == "stats" && root.selected-clock-index == 0) ||
                                        (active_widget.kind == "clock_1" && root.selected-widget-id == "stats" && root.selected-clock-index == 1) ||
                                        (active_widget.kind == "clock_2" && root.selected-widget-id == "stats" && root.selected-clock-index == 2) ||
                                        (active_widget.kind == "clock_3" && root.selected-widget-id == "stats" && root.selected-clock-index == 3) ||
                                        (active_widget.kind == "clock_4" && root.selected-widget-id == "stats" && root.selected-clock-index == 4)
                                    ) ? rgba(160, 0, 255, 0.08) : rgba(255,255,255,0.02);
                                    border-color: (root.selected-widget-id == active_widget.id ||
                                        (active_widget.kind == "clock_0" && root.selected-widget-id == "stats" && root.selected-clock-index == 0) ||
                                        (active_widget.kind == "clock_1" && root.selected-widget-id == "stats" && root.selected-clock-index == 1) ||
                                        (active_widget.kind == "clock_2" && root.selected-widget-id == "stats" && root.selected-clock-index == 2) ||
                                        (active_widget.kind == "clock_3" && root.selected-widget-id == "stats" && root.selected-clock-index == 3) ||
                                        (active_widget.kind == "clock_4" && root.selected-widget-id == "stats" && root.selected-clock-index == 4)
                                    ) ? rgba(160,0,255,0.7) : rgba(255,255,255,0.07);
                                    border-width: 1px;

                                    TouchArea { clicked => {
                                        if (active_widget.kind == "clock_0") { root.selected-widget-id = "stats"; root.selected-clock-index = 0; root.selected_clock_changed(0); }
                                        else if (active_widget.kind == "clock_1") { root.selected-widget-id = "stats"; root.selected-clock-index = 1; root.selected_clock_changed(1); }
                                        else if (active_widget.kind == "clock_2") { root.selected-widget-id = "stats"; root.selected-clock-index = 2; root.selected_clock_changed(2); }
                                        else if (active_widget.kind == "clock_3") { root.selected-widget-id = "stats"; root.selected-clock-index = 3; root.selected_clock_changed(3); }
                                        else if (active_widget.kind == "clock_4") { root.selected-widget-id = "stats"; root.selected-clock-index = 4; root.selected_clock_changed(4); }
                                        else { root.selected-widget-id = active_widget.id; }
                                    }}

                                    VerticalLayout {
                                        padding: 10px; spacing: 6px;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            VerticalLayout {
                                                spacing: 1px;
                                                Text {
                                                    text: active_widget.title;
                                                    font-size: 9px; font-weight: 800; color: white;
                                                }

                                            }
                                            Rectangle {
                                                width: 16px; height: 16px; border-radius: 8px;
                                                background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.1); border-width: 1px;
                                                Path {
                                                    width: 6px; height: 6px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    stroke: rgba(255,255,255,0.6);
                                                    stroke-width: 1.5px;
                                                    MoveTo { x: 0; y: 0; }
                                                    LineTo { x: 6; y: 6; }
                                                    MoveTo { x: 6; y: 0; }
                                                    LineTo { x: 0; y: 6; }
                                                }
                                                TouchArea { clicked => {
                                                    root.remove_active_widget(active_widget.id);
                                                }}
                                            }
                                        }

                                        Rectangle {
                                            height: 54px; border-radius: 12px;
                                            background: @linear-gradient(145deg, rgba(22,22,26,0.95) 0%, rgba(5,5,8,0.98) 100%);
                                            border-width: 1px; border-color: rgba(255,255,255,0.10);
                                            clip: true;

                                            if active_widget.kind == "year_progress": Rectangle {
                                                width: 100%; height: 100%; border-radius: parent.border-radius;
                                                background: @linear-gradient(135deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.0) 40%);
                                                VerticalLayout {
                                                    padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 6px; spacing: 0px;
                                                    HorizontalLayout { height: 20px; alignment: space-between;
                                                        Text { text: "YEAR JOURNEY"; font-size: 7px; font-weight: 950; color: #FFD200; vertical-alignment: center; }
                                                        Text { text: root.widgets-locked ? "LOCKED" : "LIVE"; font-size: 7px; font-weight: 950; color: rgba(255,255,255,0.25); vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout { alignment: start; spacing: 2px;
                                                        Text { text: "43.5%"; font-size: 20px; font-weight: 760; color: white; vertical-alignment: bottom; }
                                                    }
                                                }
                                            }

                                            if active_widget.kind == "day_progress": Rectangle {
                                                width: 100%; height: 100%; border-radius: parent.border-radius;
                                                background: @linear-gradient(135deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.0) 40%);
                                                VerticalLayout {
                                                    padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 6px; spacing: 0px;
                                                    HorizontalLayout { height: 20px; alignment: space-between;
                                                        Text { text: "DAY JOURNEY"; font-size: 7px; font-weight: 950; color: #00E5FF; vertical-alignment: center; }
                                                        Text { text: root.widgets-locked ? "LOCKED" : "LIVE"; font-size: 7px; font-weight: 950; color: rgba(255,255,255,0.25); vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout { alignment: start; spacing: 2px;
                                                        Text { text: "43.5%"; font-size: 20px; font-weight: 760; color: white; vertical-alignment: bottom; }
                                                    }
                                                }
                                            }

                                            if active_widget.kind == "month_progress": Rectangle {
                                                width: 100%; height: 100%; border-radius: parent.border-radius;
                                                background: @linear-gradient(135deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.0) 40%);
                                                VerticalLayout {
                                                    padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 6px; spacing: 0px;
                                                    HorizontalLayout { height: 20px; alignment: space-between;
                                                        Text { text: "MONTH JOURNEY"; font-size: 7px; font-weight: 950; color: #FF2D55; vertical-alignment: center; }
                                                        Text { text: root.widgets-locked ? "LOCKED" : "LIVE"; font-size: 7px; font-weight: 950; color: rgba(255,255,255,0.25); vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout { alignment: start; spacing: 2px;
                                                        Text { text: "43.5%"; font-size: 20px; font-weight: 760; color: white; vertical-alignment: bottom; }
                                                    }
                                                }
                                            }

                                            if active_widget.kind == "media": Rectangle {
                                                width: 100%; height: 100%; border-radius: parent.border-radius;
                                                background: @linear-gradient(135deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.0) 40%);
                                                VerticalLayout {
                                                    padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 6px; spacing: 0px;
                                                    HorizontalLayout { height: 20px; alignment: space-between;
                                                        Text { text: "MEDIA PLAYER"; font-size: 7px; font-weight: 950; color: #A000FF; vertical-alignment: center; }
                                                        Text { text: root.widgets-locked ? "LOCKED" : "LIVE"; font-size: 7px; font-weight: 950; color: rgba(255,255,255,0.25); vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout { alignment: start; spacing: 4px;
                                                        Rectangle { width: 20px; height: 20px; border-radius: 4px; clip: true;
                                                            Image { source: @image-url("assets/rihanna_art.png"); width: 100%; height: 100%; image-fit: cover; }
                                                        }
                                                        VerticalLayout { alignment: center;
                                                            Text { text: "Love On The Brain"; font-size: 8px; font-weight: 700; color: white; overflow: elide; width: 100px; }
                                                        }
                                                    }
                                                }
                                            }

                                            if active_widget.kind == "clock_0": Rectangle {
                                                width: 100%; height: 100%; border-radius: root.clock-0-border-radius * 0.5px;
                                                background: @linear-gradient(135deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.0) 40%);
                                                VerticalLayout {
                                                    padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 6px; spacing: 0px;
                                                    HorizontalLayout { height: 20px; alignment: space-between;
                                                        Text { text: "CLOCK"; font-size: 7px; font-weight: 950; color: rgba(255,255,255,0.5); vertical-alignment: center; }
                                                        Text { text: root.widgets-locked ? "LOCKED" : "LIVE"; font-size: 7px; font-weight: 950; color: rgba(255,255,255,0.25); vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout { alignment: start; spacing: 2px;
                                                        Text { text: "12:07"; font-size: 20px; font-weight: 760; color: root.clock-0-cpu-color; vertical-alignment: bottom; }
                                                        if root.clock-0-show-battery: Text { text: "pm"; font-size: 10px; font-weight: 760; color: root.clock-0-cpu-color; vertical-alignment: bottom; y: -1px; }
                                                    }
                                                }
                                            }

                                            if active_widget.kind == "clock_1": Rectangle {
                                                width: 100%; height: 100%; border-radius: root.clock-1-border-radius * 0.5px;
                                                background: @linear-gradient(135deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.0) 40%);
                                                VerticalLayout {
