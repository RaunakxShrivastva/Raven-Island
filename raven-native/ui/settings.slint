                                                                for day in ["S","M","T","W","T","F","S"]: Text { text: day; font-size: 5px; font-weight: 800; color: rgba(255,255,255,0.4); width: 6px; horizontal-alignment: center; }
                                                            }
                                                            HorizontalLayout { spacing: 3px;
                                                                for val in [1,2,3,4,5,6,7]: Rectangle { width: 6px; height: 6px; border-radius: 3px; background: val == 7 ? #007AFF : rgba(255,255,255,0.05); }
                                                            }
                                                            HorizontalLayout { spacing: 3px;
                                                                for val in [8,9,10,11,12,13,14]: Rectangle { width: 6px; height: 6px; border-radius: 3px; background: rgba(255,255,255,0.05); }
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            if active_widget.kind == "focus_score": Rectangle {
                                                width: 100%; height: 100%; border-radius: parent.border-radius;
                                                VerticalLayout {
                                                    padding-left: 10px; padding-right: 10px; alignment: center;
                                                    HorizontalLayout { alignment: space-between;
                                                        VerticalLayout { alignment: center; spacing: 1px;
                                                            Text { text: "FOCUS SCORE"; font-size: 7px; font-weight: 900; color: rgba(255,255,255,0.6); }
                                                            Text { text: "120m"; font-size: 16px; font-weight: 950; color: white; }
                                                        }
                                                        VerticalLayout { alignment: center;
                                                            Rectangle { width: 28px; height: 28px;
                                                                Rectangle { width: 100%; height: 100%; border-radius: 14px; border-width: 2px; border-color: rgba(255,255,255,0.08); }
                                                                Rectangle { width: 100%; height: 100%; border-radius: 14px; border-width: 2px; border-color: #a855f7; }
                                                                Text { text: "85"; font-size: 10px; font-weight: 950; color: white; horizontal-alignment: center; vertical-alignment: center; }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                }
                            }
                            }
                    }
                    
                    // Right Area: Customize Widget Control Panel (30% width)
                    Rectangle {
                        width: 320px;
                        background: #09090e;
                        border-radius: 20px;
                        border-color: rgba(255,255,255,0.04); border-width: 1px;
                        clip: true;
                        
                        VerticalLayout {
                            height: parent.height;
