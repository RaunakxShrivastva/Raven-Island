                                                        Rectangle { width: 16px; height: 16px; border-radius: 8px; background: rgba(255,255,255,0.06);
                                                            Path { width: 8px; height: 8px; x: 4px; y: 4px; stroke: white; stroke-width: 1.5px; stroke-line-cap: round; commands: "M4 0v8 M0 4h8"; }
                                                        }
                                                    }
                                                    Text {
                                                        text: root.picture-selected-path == "" ? "No image" : "Image selected";
                                                        font-size: 7px; font-weight: 600; color: rgba(255,255,255,0.4); horizontal-alignment: center;
