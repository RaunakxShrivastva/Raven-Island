                                                root.selected-widget-id == "month_progress" ? "Month Progress Widget" : (
                                                    root.selected-widget-id == "media" ? "Media Player Widget" : (
                                                        root.selected-widget-id == "notes" ? "Notes Widget" : (
                                                            root.selected-widget-id == "todo" ? "To-Do List Widget" : (
                                                                root.selected-widget-id == "quotes" ? "Quotes Widget" : (
                                                                    root.selected-widget-id == "picture" ? "Picture Widget" : (
                                                                        root.selected-widget-id == "video" ? "Video Frame Widget" : (
                                                                            root.selected-widget-id == "battery" ? "Battery Percentage Widget" : (
                                                                                root.selected-widget-id == "calendar_focus" ? "Calendar Focus Widget" : "Clock Widget"
                                                                            )
                                                                        )
                                                                    )
                                                                )
                                                            )
                                                        )
                                                    )
                                                )
                                            )
                                        );
                                        font-size: 11px; font-weight: 600; color: #A000FF;
                                        overflow: elide;
                                    }
                                }
                                Rectangle {
                                    width: 24px; height: 24px; border-radius: 12px; background: rgba(255,255,255,0.05);
                                    Text { text: "✕"; font-size: 10px; color: white; horizontal-alignment: center; vertical-alignment: center; }
