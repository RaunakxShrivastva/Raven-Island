                                                        Text { text: root.widgets-locked ? "LOCKED" : "LIVE"; font-size: 7px; font-weight: 950; color: rgba(255,255,255,0.25); vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout { alignment: start; spacing: 2px;
                                                        Text { text: "12:07"; font-size: 20px; font-weight: 760; color: root.clock-1-cpu-color; vertical-alignment: bottom; }
                                                        if root.clock-1-show-battery: Text { text: "pm"; font-size: 10px; font-weight: 760; color: root.clock-1-cpu-color; vertical-alignment: bottom; y: -1px; }
                                                    }
