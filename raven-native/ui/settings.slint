                                                    HorizontalLayout { height: 20px; alignment: space-between;
                                                        Text { text: "CLOCK"; font-size: 7px; font-weight: 950; color: rgba(255,255,255,0.5); vertical-alignment: center; }
                                                        Text { text: root.widgets-locked ? "LOCKED" : "LIVE"; font-size: 7px; font-weight: 950; color: rgba(255,255,255,0.25); vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout { alignment: start; spacing: 2px;
                                                        Text { text: "12:07"; font-size: 20px; font-weight: 760; color: root.clock-2-cpu-color; vertical-alignment: bottom; }
                                                        if root.clock-2-show-battery: Text { text: "pm"; font-size: 10px; font-weight: 760; color: root.clock-2-cpu-color; vertical-alignment: bottom; y: -1px; }
                                                    }
                                                }
                                            }

                                            if active_widget.kind == "clock_3": Rectangle {
                                                width: 100%; height: 100%; border-radius: root.clock-3-border-radius * 0.5px;
                                                background: @linear-gradient(135deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.0) 40%);
                                                VerticalLayout {
                                                    padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 6px; spacing: 0px;
                                                    HorizontalLayout { height: 20px; alignment: space-between;
                                                        Text { text: "CLOCK"; font-size: 7px; font-weight: 950; color: rgba(255,255,255,0.5); vertical-alignment: center; }
                                                        Text { text: root.widgets-locked ? "LOCKED" : "LIVE"; font-size: 7px; font-weight: 950; color: rgba(255,255,255,0.25); vertical-alignment: center; }
                                                    }
                                                    HorizontalLayout { alignment: start; spacing: 2px;
                                                        Text { text: "12:07"; font-size: 20px; font-weight: 760; color: root.clock-3-cpu-color; vertical-alignment: bottom; }
                                                        if root.clock-3-show-battery: Text { text: "pm"; font-size: 10px; font-weight: 760; color: root.clock-3-cpu-color; vertical-alignment: bottom; y: -1px; }
                                                    }
                                                }
                                            }

                                            if active_widget.kind == "clock_4": Rectangle {
                                                width: 100%; height: 100%; border-radius: root.clock-4-border-radius * 0.5px;
                                                background: @linear-gradient(135deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.0) 40%);
                                                VerticalLayout {
                                                    padding-left: 10px; padding-right: 10px; padding-top: 0px; padding-bottom: 6px; spacing: 0px;
                                                    HorizontalLayout { height: 20px; alignment: space-between;
                                                        Text { text: "CLOCK"; font-size: 7px; font-weight: 950; color: rgba(255,255,255,0.5); vertical-alignment: center; }
