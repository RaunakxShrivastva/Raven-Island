component MediaWidgetButton inherits Rectangle {
    width: 44px;
    height: 32px;
    border-radius: 12px;
    background: touch-area.has-hover ? rgba(255, 255, 255, 0.07) : rgba(255, 255, 255, 0.02);
    border-width: 1px;
    border-color: touch-area.has-hover ? rgba(255, 255, 255, 0.12) : rgba(255, 255, 255, 0.04);
    
    callback clicked();
    
    touch-area := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MediaWidgetWindow inherits Window {
    no-frame: true;
    background: transparent;
    always-on-top: false;
    width: 320px;
    height: 150px;
    in-out property <string> instance-title: "Raven Media Widget";
    title: root.instance-title;

    in-out property <string> track-title: "Not Playing";
    in-out property <string> track-artist: "No Media";
    in-out property <bool> is-playing: false;
    in-out property <float> progress: 0.0;
    in-out property <string> time-elapsed: "00:00";
    in-out property <string> time-remaining: "-00:00";
    in-out property <image> album-art;
    in-out property <bool> has-album-art: false;
    in-out property <image> app-icon;
    in-out property <bool> has-app-icon: false;
    in-out property <bool> is-locked: true;
    in-out property <float> bg-opacity: 0.96;
    in-out property <int> border-radius-val: 24;
    in-out property <color> accent-color: #A000FF;

    callback drag_window();
    callback show_context_menu();
    callback dummy_tracker();
    callback skip_backward();
    callback prev_track();
    callback toggle_play();
    callback next_track();
    callback skip_forward();

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius-val * 1px;
        background: @linear-gradient(145deg, rgba(22, 22, 26, root.bg-opacity * 0.82) 0%, rgba(5, 5, 8, root.bg-opacity * 0.88) 100%);
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.13);

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: parent.border-radius;
            background: @linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.0) 35%);
        }

        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(evt) => {
                if evt.button == PointerEventButton.right && evt.kind == PointerEventKind.down {
                    root.show_context_menu();
                }
            }
        }

        TouchArea {
            width: 100%;
            height: 84px;
            pointer-event(evt) => {
                if evt.button == PointerEventButton.left && evt.kind == PointerEventKind.down {
                    if !root.is-locked {
                        root.drag_window();
                    }
                }
            }
        }

        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 10px;

            // Row 1: Album Art + Track Info + App Icon
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                height: 54px;
                
                // Album Art Frame
                Rectangle {
                    width: 54px;
                    height: 54px;
                    border-radius: 12px;
                    background: rgba(255, 255, 255, 0.05);
                    clip: true;

                    if root.has-album-art : Image {
                        source: root.album-art;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                    
                    if !root.has-album-art : Rectangle {
                        width: 100%;
                        height: 100%;
                        background: @linear-gradient(135deg, #A000FF 0%, #FF2D55 100%);
                        
                        Path {
                            width: 20px;
                            height: 20px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            stroke: white;
                            stroke-width: 2px;
                            commands: "M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V5h4V3h-6z";
                        }
                    }
                }

                // Track Info (Title and Artist)
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 4px;

                    Text {
                        text: root.track-title;
                        font-size: 14px;
                        font-weight: 750;
                        color: white;
                        overflow: elide;
                    }
                    Text {
                        text: root.track-artist;
                        font-size: 11px;
                        font-weight: 600;
                        color: rgba(255, 255, 255, 0.6);
                        overflow: elide;
                    }
                }

                // App Icon Frame (e.g. Spotify/Chrome source badge)
                if root.has-app-icon : Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: rgba(255, 255, 255, 0.05);
                    clip: true;
                    y: (parent.height - self.height) / 2;

                    Image {
                        source: root.app-icon;
                        width: 100%;
                        height: 100%;
                        image-fit: contain;
                    }
                }
            }

            // Row 2: Progress Slider Bar
            HorizontalLayout {
                spacing: 8px;
                height: 16px;

                Text {
                    text: root.time-elapsed;
                    font-size: 10px;
                    font-weight: 600;
                    color: rgba(255, 255, 255, 0.4);
                    vertical-alignment: center;
                }

                // Slider Track
                Rectangle {
                    horizontal-stretch: 1;
                    height: 4px;
                    background: rgba(255, 255, 255, 0.1);
                    border-radius: 2px;
                    y: (parent.height - self.height) / 2;

                    // Progress fill
                    Rectangle {
                        x: 0;
                        width: parent.width * root.progress;
                        height: 100%;
                        background: root.accent-color;
                        border-radius: 2px;
                    }
                    
                    // Thumb slider point representation
                    Rectangle {
                        x: (parent.width - self.width) * root.progress;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.accent-color;
                        y: -2px;
                    }
                }

                Text {
                    text: root.time-remaining;
                    font-size: 10px;
                    font-weight: 600;
                    color: rgba(255, 255, 255, 0.4);
                    vertical-alignment: center;
                }
            }

            // Row 3: Control Buttons
            HorizontalLayout {
                alignment: space-between;
                height: 38px;

                // Skip Backward 10s Capsule
                MediaWidgetButton {
                    clicked => { root.skip_backward(); }
                    
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        
                        Path {
                            width: 100%;
                            height: 100%;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            stroke: rgba(255, 255, 255, 0.75);
                            stroke-width: 1.75px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                            commands: "M 3 12 A 9 9 0 1 0 12 3 A 9.75 9.75 0 0 0 5.26 5.74 L 3 8 M 3 3 V 8 H 8";
                        }
                        
                        Text {
                            text: "10";
                            font-size: 8px;
                            font-weight: 800;
                            color: rgba(255, 255, 255, 0.75);
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2 + 1px;
                        }
                    }
                }

                // Previous Track Button
                MediaWidgetButton {
                    clicked => { root.prev_track(); }
                    
                    Path {
                        width: 12px;
                        height: 12px;
                        x: 16px;
                        y: 10px;
                        fill: rgba(255, 255, 255, 0.75);
                        commands: "M 10 2 L 4.5 6 L 10 10 Z M 3.5 2 L 3.5 10 H 2 V 2 Z";
                    }
                }

                // Play / Pause Button
                MediaWidgetButton {
                    clicked => { root.toggle_play(); }
                    border-color: root.accent-color;
                    
                    if root.is-playing : Path {
                        width: 10px;
                        height: 10px;
                        x: 17px;
                        y: 11px;
                        fill: white;
                        commands: "M2 2h2v8H2zm4 0h2v8H6z";
                    }

                    if !root.is-playing : Path {
                        width: 12px;
                        height: 12px;
                        x: 17px;
                        y: 10px;
                        fill: white;
                        commands: "M 2.5 2 L 9.5 6 L 2.5 10 Z";
                    }
                }

                // Next Track Capsule
                MediaWidgetButton {
                    clicked => { root.next_track(); }
                    
                    Path {
                        width: 12px;
                        height: 12px;
                        x: 16px;
                        y: 10px;
                        fill: rgba(255, 255, 255, 0.75);
                        commands: "M 2 2 L 7.5 6 L 2 10 Z M 8.5 2 L 8.5 10 H 10 L 10 2 Z";
                    }
                }

                // Skip Forward 10s Capsule
                MediaWidgetButton {
                    clicked => { root.skip_forward(); }
                    
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        
                        Path {
                            width: 100%;
                            height: 100%;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            stroke: rgba(255, 255, 255, 0.75);
                            stroke-width: 1.75px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                            commands: "M 21 12 A 9 9 0 1 1 12 3 A 9.75 9.75 0 0 1 18.74 5.74 L 21 8 M 21 3 V 8 H 16";
                        }
                        
                        Text {
                            text: "10";
                            font-size: 8px;
                            font-weight: 800;
                            color: rgba(255, 255, 255, 0.75);
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2 + 1px;
                        }
                    }
                }
            }
        }
    }
}

export component NotesWidgetWindow inherits Window {
    no-frame: true;
    background: transparent;
    always-on-top: false;
    width: 320px;
    height: 150px;
    in-out property <string> instance-title: "Raven Notes Widget";
    title: root.instance-title;

    in-out property <string> notes-text: "";
    in-out property <bool> is-locked: true;
    in-out property <float> bg-opacity: 0.96;
    in-out property <int> border-radius-val: 24;

    callback drag_window();
    callback show_context_menu();
    callback dummy_tracker();
    callback notes_changed(string);

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius-val * 1px;
        background: @linear-gradient(145deg, rgba(22, 22, 26, root.bg-opacity * 0.82) 0%, rgba(5, 5, 8, root.bg-opacity * 0.88) 100%);
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.13);

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: parent.border-radius;
            background: @linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.0) 35%);
        }

        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(evt) => {
                if evt.button == PointerEventButton.right && evt.kind == PointerEventKind.down {
                    root.show_context_menu();
                }
            }
        }

        TouchArea {
            width: 100%;
            height: 38px;
            pointer-event(evt) => {
                if evt.button == PointerEventButton.left && evt.kind == PointerEventKind.down {
                    if !root.is-locked {
                        root.drag_window();
                    }
                }
            }
        }

        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 10px;

            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                height: 18px;

                Path {
                    width: 14px;
                    height: 14px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    stroke: #FFCC00;
                    stroke-width: 2.5px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    commands: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8";
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: "Quick Notes";
                    font-size: 13px;
                    font-weight: 750;
                    color: #FFCC00;
                    vertical-alignment: center;
                }
            }

            // Note Text Area
            Rectangle {
                background: rgba(255, 255, 255, 0.03);
                border-radius: 8px;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.06);
                vertical-stretch: 1;
                clip: true;

                TextEdit {
                    text: root.notes-text;
                    font-size: 12px;
                    wrap: word-wrap;
                    edited(t) => { root.notes_changed(t); }
                    width: 100%;
                    height: 100%;
                }
            }
        }
    }
}

export struct TodoItem {
    id: int,
    text: string,
    completed: bool,
}

export component TodoWidgetWindow inherits Window {
    no-frame: true;
    background: transparent;
    always-on-top: false;
    width: 320px;
    height: 150px;
    in-out property <string> instance-title: "Raven Todo Widget";
    title: root.instance-title;

    in-out property <[TodoItem]> todo-items;
    in-out property <bool> is-locked: true;
    in-out property <float> bg-opacity: 0.96;
    in-out property <int> border-radius-val: 24;
    in-out property <color> accent-color: #FF9500;
    in-out property <bool> hide-completed: false;

    callback drag_window();
    callback show_context_menu();
    callback dummy_tracker();
    callback add_task(string);
    callback toggle_task(int);
    callback delete_task(int);
    callback move_task(int, bool); // id, is_up

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius-val * 1px;
        background: @linear-gradient(145deg, rgba(22, 22, 26, root.bg-opacity * 0.82) 0%, rgba(5, 5, 8, root.bg-opacity * 0.88) 100%);
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.13);

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: parent.border-radius;
            background: @linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.0) 35%);
        }

        bg-touch := TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(evt) => {
                if evt.button == PointerEventButton.left && evt.kind == PointerEventKind.down {
                    if !root.is-locked {
                        root.drag_window();
                    }
                } else if evt.button == PointerEventButton.right && evt.kind == PointerEventKind.down {
                    root.show_context_menu();
                }
            }
        }

        TouchArea {
            width: 100%;
            height: 0px; visible: false;
            pointer-event(evt) => {
                if evt.button == PointerEventButton.left && evt.kind == PointerEventKind.down {
                    if !root.is-locked {
                        root.drag_window();
                    }
                }
            }
        }

        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 6px;

            // Row 1: Checklist Icon + "To-Do List"
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                height: 18px;

                Path {
                    width: 14px;
                    height: 14px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    stroke: root.accent-color;
                    stroke-width: 2.5px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    commands: "M9 11l3 3L22 4 M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11";
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: "To-Do List";
                    font-size: 13px;
                    font-weight: 750;
                    color: root.accent-color;
                    vertical-alignment: center;
                }
            }

            // Scrollable task list
            ScrollView {
                vertical-stretch: 1;
                
                VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    for item[idx] in root.todo-items : Rectangle {
                        visible: !(root.hide-completed && item.completed);
                        height: self.visible ? 26px : 0px;
                        background: rgba(255, 255, 255, 0.02);
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.04);
                        
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            alignment: space-between;

                            // Left: Checkbox + Text
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                vertical-stretch: 0;

                                // Checkbox Button
                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 4px;
                                    border-width: 1.5px;
                                    border-color: item.completed ? root.accent-color : rgba(255, 255, 255, 0.3);
                                    background: item.completed ? root.accent-color : transparent;
                                    y: (parent.height - self.height) / 2;

                                    if item.completed : Path {
                                        width: 8px;
                                        height: 8px;
                                        x: 4px;
                                        y: 4px;
                                        stroke: white;
                                        stroke-width: 2px;
                                        stroke-line-cap: round;
                                        stroke-line-join: round;
                                        commands: "M1.5 4.5l2 2 5-5";
                                    }

                                    TouchArea {
                                        clicked => { root.toggle_task(item.id); }
                                    }
                                }

                                // Task Description Text
                                Text {
                                    text: item.text;
                                    font-size: 12px;
                                    font-weight: 550;
                                    color: item.completed ? rgba(255, 255, 255, 0.4) : white;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                alignment: end;
                                vertical-stretch: 0;

                                // Move Up
                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 4px;
                                    background: up-touch.has-hover ? rgba(255,255,255,0.08) : transparent;
                                    y: (parent.height - self.height) / 2;
                                    
                                    Path {
                                        width: 8px;
                                        height: 8px;
                                        x: 4px;
                                        y: 4px;
                                        stroke: rgba(255, 255, 255, 0.6);
                                        stroke-width: 1.5px;
                                        stroke-line-cap: round;
                                        stroke-line-join: round;
                                        commands: "M 1 6 L 4 2 L 7 6";
                                    }
                                    
                                    up-touch := TouchArea {
                                        clicked => { root.move_task(item.id, true); }
                                    }
                                }

                                // Move Down
                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 4px;
                                    background: down-touch.has-hover ? rgba(255,255,255,0.08) : transparent;
                                    y: (parent.height - self.height) / 2;
                                    
                                    Path {
                                        width: 8px;
                                        height: 8px;
                                        x: 4px;
                                        y: 4px;
                                        stroke: rgba(255, 255, 255, 0.6);
                                        stroke-width: 1.5px;
                                        stroke-line-cap: round;
                                        stroke-line-join: round;
                                        commands: "M 1 2 L 4 6 L 7 2";
                                    }
                                    
                                    down-touch := TouchArea {
                                        clicked => { root.move_task(item.id, false); }
                                    }
                                }

                                // Delete Task
                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 4px;
                                    background: del-touch.has-hover ? rgba(255,69,58,0.15) : transparent;
                                    y: (parent.height - self.height) / 2;
                                    
                                    Path {
                                        width: 8px;
                                        height: 8px;
                                        x: 4px;
                                        y: 4px;
                                        stroke: del-touch.has-hover ? #FF453A : rgba(255, 255, 255, 0.6);
                                        stroke-width: 1.5px;
                                        stroke-line-cap: round;
                                        commands: "M1 1l6 6 M7 1l-6 6";
                                    }
                                    
                                    del-touch := TouchArea {
                                        clicked => { root.delete_task(item.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Bottom Add Task Input Row
            HorizontalLayout {
                spacing: (bg-touch.has-hover || todo-input.has-focus || root.todo-items.length == 0) ? 8px : 0px;
                height: (bg-touch.has-hover || todo-input.has-focus || root.todo-items.length == 0) ? 26px : 0px;
                visible: (bg-touch.has-hover || todo-input.has-focus || root.todo-items.length == 0);

                Rectangle {
                    background: rgba(255, 255, 255, 0.04);
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.06);
                    horizontal-stretch: 1;

                    todo-input := TextInput {
                        text: "";
                        color: white;
                        font-size: 12px;
                        vertical-alignment: center;
                        
                        accepted => {
                            if self.text != "" {
                                root.add_task(self.text);
                                self.text = "";
                            }
                        }
                    }
                }

                // Add Task Button
                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 6px;
                    background: add-touch.has-hover ? rgba(255, 255, 255, 0.1) : rgba(255, 255, 255, 0.04);
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.08);

                    Path {
                        width: 10px;
                        height: 10px;
                        x: 8px;
                        y: 8px;
                        stroke: white;
                        stroke-width: 2px;
                        stroke-line-cap: round;
                        commands: "M5 1v8 M1 5h8";
                    }

                    add-touch := TouchArea {
                        clicked => {
                            if todo-input.text != "" {
                                root.add_task(todo-input.text);
                                todo-input.text = "";
                            }
                        }
                    }
                }
            }
        }
    }
}

export component QuotesWidgetWindow inherits Window {
    no-frame: true;
    background: transparent;
    always-on-top: false;
    width: 320px;
    height: 150px;
    in-out property <string> instance-title: "Raven Quotes Widget";
    title: root.instance-title;

    in-out property <string> quote-text: "";
    in-out property <string> quote-author: "";
    in-out property <bool> is-locked: true;
    in-out property <float> bg-opacity: 0.96;
    in-out property <int> border-radius-val: 24;

    callback drag_window();
    callback show_context_menu();
    callback dummy_tracker();
    callback next_quote();

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius-val * 1px;
        background: @linear-gradient(145deg, rgba(22, 22, 26, root.bg-opacity * 0.82) 0%, rgba(5, 5, 8, root.bg-opacity * 0.88) 100%);
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.13);

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: parent.border-radius;
            background: @linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.0) 35%);
        }

        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(evt) => {
                if evt.button == PointerEventButton.left && evt.kind == PointerEventKind.down {
                    if !root.is-locked {
                        root.drag_window();
                    }
                } else if evt.button == PointerEventButton.right && evt.kind == PointerEventKind.down {
                    root.show_context_menu();
                }
            }
        }

        TouchArea {
            width: 100%;
            height: 0px; visible: false;
            pointer-event(evt) => {
                if evt.button == PointerEventButton.left && evt.kind == PointerEventKind.down {
                    if !root.is-locked {
                        root.drag_window();
                    }
                }
            }
        }

        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 6px;

            HorizontalLayout {
                alignment: start;
                spacing: 8px;

                Text {
                    text: "“";
                    font-size: 24px;
                    font-weight: 950;
                    color: #FF2D55;
                    vertical-alignment: center;
                }

                Text {
                    text: "Daily Wisdom";
                    font-size: 13px;
                    font-weight: 750;
                    color: #FF2D55;
                    vertical-alignment: center;
                }
            }

            // Quote display area
            VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: 6px;

                Text {
                    text: root.quote-text;
                    font-size: 13px;
                    font-weight: 550;
                    font-italic: true;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            // Bottom row: Manual Refresh (left) and Author (right)
            HorizontalLayout {
                alignment: space-between;
                height: 18px;

                // Refresh Button
                Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: refresh-touch.has-hover ? rgba(255, 45, 85, 0.15) : transparent;
                    
                    Path {
                        width: 10px;
                        height: 10px;
                        x: 4px;
                        y: 4px;
                        stroke: #FF2D55;
                        stroke-width: 1.75px;
                        stroke-line-cap: round;
                        commands: "M 8.5 2 A 4.5 4.5 0 1 1 5 1.5 M 5 0 L 5 2 L 3 2";
                    }

                    refresh-touch := TouchArea {
                        clicked => { root.next_quote(); }
                    }
                }

                // Author Text
                Text {
                    text: "- " + root.quote-author;
                    font-size: 10px;
                    font-weight: 600;
                    color: rgba(255, 255, 255, 0.5);
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component PictureWidgetWindow inherits Window {
    no-frame: true;
    background: transparent;
    always-on-top: false;
    width: 320px;
    height: 150px;
    in-out property <string> instance-title: "Raven Picture Widget";
    title: root.instance-title;

    in-out property <string> picture-path: "";
    in-out property <image> picture-img;
    in-out property <bool> has-picture: false;
    in-out property <bool> is-locked: true;
    in-out property <float> bg-opacity: 0.96;
    in-out property <int> border-radius-val: 24;
    in-out property <bool> show-camera-overlay: true;

    callback drag_window();
    callback show_context_menu();
    callback dummy_tracker();
    callback select_picture();

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius-val * 1px;
        background: @linear-gradient(145deg, rgba(22, 22, 26, root.bg-opacity * 0.82) 0%, rgba(5, 5, 8, root.bg-opacity * 0.88) 100%);
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.13);

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: parent.border-radius;
            background: @linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.0) 35%);
        }

        // Entire widget area is clickable to replace/pick photo or drag/right-click
        // Entire widget area is clickable to replace/pick photo or drag/right-click
        main-touch := TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(evt) => {
                root.show-camera-overlay = true;
                if evt.button == PointerEventButton.left && evt.kind == PointerEventKind.down {
                    if !root.is-locked {
                        // If no picture, check if click is inside the plus-touch bounds
                        if !root.has-picture && self.pressed-x >= 80px && self.pressed-x <= 240px && self.pressed-y >= 35px && self.pressed-y <= 115px {
                            root.select_picture();
                        } else {
                            root.drag_window();
                        }
                    } else {
                        root.select_picture();
                    }
                } else if evt.button == PointerEventButton.right && evt.kind == PointerEventKind.down {
                    root.show_context_menu();
                }
            }
        }

        // If picture is selected, show it
        if root.has-picture : Rectangle {
            width: 100%;
            height: 100%;
            border-radius: parent.border-radius;
            clip: true;

            Image {
                source: root.picture-img;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }

            // Hover indicator overlay - bound to root touch area hover state to prevent event interception
            Rectangle {
                width: 100%;
                height: 100%;
                background: (main-touch.has-hover && root.show-camera-overlay && root.is-locked) ? rgba(0, 0, 0, 0.4) : transparent;

                if (main-touch.has-hover && root.show-camera-overlay && root.is-locked) : Path {
                    width: 24px;
                    height: 24px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    stroke: white;
                    stroke-width: 2px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    commands: "M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z M12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8z";
                }
            }
        }

        // If no picture, show plus placeholder in center
        if !root.has-picture : Rectangle {
            width: 100%;
            height: 100%;

            plus-touch := TouchArea {
                width: 160px;
                height: 80px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                clicked => {
                    root.select_picture();
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 8px;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: plus-touch.has-hover ? rgba(255,255,255,0.18) : (main-touch.has-hover ? rgba(255,255,255,0.12) : rgba(255,255,255,0.06));

                        Path {
                            width: 14px;
                            height: 14px;
                            x: 9px;
                            y: 9px;
                            stroke: white;
                            stroke-width: 2.5px;
                            stroke-line-cap: round;
                            commands: "M7 1v12 M1 7h12";
                        }
                    }
                }

                Text {
                    text: "Click to select image";
                    font-size: 11px;
                    font-weight: 600;
                    color: plus-touch.has-hover ? rgba(255, 255, 255, 0.7) : rgba(255, 255, 255, 0.4);
                    horizontal-alignment: center;
                }
            }
        }
    }
}

export component VideoFrameWidgetWindow inherits Window {
    no-frame: true;
    background: transparent;
    always-on-top: false;
    width: 320px;
    height: 150px;
    in-out property <string> instance-title: "Raven Video Frame Widget";
    title: root.instance-title;

    in-out property <string> video-path: "";
    in-out property <image> video-frame-img;
    in-out property <bool> has-video: false;
    in-out property <bool> is-gif: false;
    in-out property <bool> is-locked: true;
    in-out property <float> bg-opacity: 0.96;
    in-out property <int> border-radius-val: 24;
    in-out property <bool> show-video-overlay: true;

    callback drag_window();
    callback show_context_menu();
    callback dummy_tracker();
    callback select_video();

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius-val * 1px;
        background: @linear-gradient(145deg, rgba(22, 22, 26, root.bg-opacity * 0.82) 0%, rgba(5, 5, 8, root.bg-opacity * 0.88) 100%);
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.13);
        clip: true;

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: parent.border-radius;
            background: @linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.0) 35%);
        }

        main-touch := TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(evt) => {
                root.show-video-overlay = true;
                if evt.button == PointerEventButton.left && evt.kind == PointerEventKind.down {
                    if !root.is-locked {
                        if !root.has-video && self.pressed-x >= 80px && self.pressed-x <= 240px && self.pressed-y >= 35px && self.pressed-y <= 115px {
                            root.select_video();
                        } else {
                            root.drag_window();
                        }
                    } else {
                        root.select_video();
                    }
                } else if evt.button == PointerEventButton.right && evt.kind == PointerEventKind.down {
                    root.show_context_menu();
                }
            }
        }

        if root.has-video && root.is-gif : Rectangle {
            width: 100%;
            height: 100%;
            border-radius: parent.border-radius;
            clip: true;

            Image {
                source: root.video-frame-img;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }
        }

        if root.has-video && !root.is-gif : Rectangle {
            width: 100%;
            height: 100%;

            Rectangle {
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.10);
            }

            if (main-touch.has-hover && root.show-video-overlay && root.is-locked) : Rectangle {
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.35);

                Path {
                    width: 28px;
                    height: 28px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    fill: white;
                    commands: "M8 5 L22 14 L8 23 Z";
                }
            }
        }

        if !root.has-video : Rectangle {
            width: 100%;
            height: 100%;

            plus-touch := TouchArea {
                width: 170px;
                height: 84px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                clicked => {
                    root.select_video();
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 8px;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: plus-touch.has-hover ? rgba(255,255,255,0.18) : (main-touch.has-hover ? rgba(255,255,255,0.12) : rgba(255,255,255,0.06));

                        Path {
                            width: 14px;
                            height: 14px;
                            x: 9px;
                            y: 9px;
                            stroke: white;
                            stroke-width: 2.5px;
                            stroke-line-cap: round;
                            commands: "M7 1v12 M1 7h12";
                        }
                    }
                }

                Text {
                    text: "Click to select GIF or video";
                    font-size: 11px;
                    font-weight: 600;
                    color: plus-touch.has-hover ? rgba(255, 255, 255, 0.7) : rgba(255, 255, 255, 0.4);
                    horizontal-alignment: center;
                }
            }
        }
    }
}
