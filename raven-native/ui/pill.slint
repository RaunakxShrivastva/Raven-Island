                Path { x: 14px; y: 79px; width: 14px; height: 15px; viewbox-width: 24; viewbox-height: 24; stroke: #eee7dc; stroke-width: 2.2px; fill: transparent; commands: "M12 17 V22 M8 2 H16 M9 2 L10 9 L6 13 V15 H18 V13 L14 9 L15 2"; }

                Rectangle { x: 10px; y: 106px; width: 300px; height: 1px; background: rgba(255,255,255,0.08); }

                Rectangle { x: 0px; y: 112px; width: 100%; height: 28px; background: delete-entry-action.has-hover ? rgba(255,80,80,0.18) : transparent; }
                delete-entry-action := TouchArea { x: 0px; y: 112px; width: 100%; height: 28px; mouse-cursor: pointer; clicked => { root.clipboard-delete-selected(); root.show-clipboard-settings-panel = false; root.show-clipboard-rename-panel = false; } }
                Text { x: 36px; y: 112px; height: 28px; text: "Delete History"; color: #ff5252; font-size: 12px; font-weight: 850; vertical-alignment: center; }
                Path { x: 14px; y: 119px; width: 14px; height: 14px; viewbox-width: 24; viewbox-height: 24; stroke: #ff5252; stroke-width: 2px; fill: transparent; commands: "M3 6 H21 M8 6 V4 H16 V6 M6 6 L7 21 H17 L18 6"; }

                Rectangle { x: 0px; y: 140px; width: 100%; height: 28px; background: delete-multiple-action.has-hover ? rgba(255,80,80,0.18) : transparent; }
                delete-multiple-action := TouchArea { x: 0px; y: 140px; width: 100%; height: 28px; mouse-cursor: pointer; clicked => { root.clipboard-delete-multiple(); root.show-clipboard-settings-panel = false; root.show-clipboard-rename-panel = false; } }
                Text { x: 36px; y: 140px; height: 28px; text: "Delete Multiple Items"; color: #ff5252; font-size: 12px; font-weight: 850; vertical-alignment: center; }
                Path { x: 14px; y: 147px; width: 14px; height: 14px; viewbox-width: 24; viewbox-height: 24; stroke: #ff5252; stroke-width: 2px; fill: transparent; commands: "M4 7 H20 M8 7 V5 H16 V7 M7 7 L8 21 H16 L17 7 M10 11 H14 M10 15 H14"; }

                Rectangle { x: 0px; y: 168px; width: 100%; height: 28px; background: delete-all-action.has-hover ? rgba(255,80,80,0.18) : transparent; }
                delete-all-action := TouchArea { x: 0px; y: 168px; width: 100%; height: 28px; mouse-cursor: pointer; clicked => { root.clipboard-delete-all(); root.show-clipboard-settings-panel = false; root.show-clipboard-rename-panel = false; } }
                Text { x: 36px; y: 168px; height: 28px; text: "Delete All History"; color: #ff5252; font-size: 12px; font-weight: 850; vertical-alignment: center; }
                Path { x: 14px; y: 175px; width: 14px; height: 14px; viewbox-width: 24; viewbox-height: 24; stroke: #ff5252; stroke-width: 2px; fill: transparent; commands: "M3 6 H21 M8 6 V4 H16 V6 M6 6 L7 21 H17 L18 6"; }

                if root.show-clipboard-retention-menu : Rectangle {
                    x: 132px;
                    y: 38px;
                    width: 174px;
                    height: 168px;
                    border-radius: 6px;
                    background: rgba(48, 48, 48, 0.98);
                    border-width: 1px;
                    border-color: rgba(255,255,255,0.18);
                    clip: true;

                    TextInput { x: 10px; y: 8px; width: 154px; height: 28px; text: ""; color: white; font-size: 12px; single-line: true; }
                    Rectangle { x: 0px; y: 44px; width: 100%; height: 1px; background: rgba(255,255,255,0.08); }

                    retention-day := TouchArea { x: 8px; y: 50px; width: 158px; height: 26px; mouse-cursor: pointer; clicked => { root.clipboard-retention-selected("1 Day"); root.clipboard-retention-label = "1 Day"; root.show-clipboard-retention-menu = false; } }
                    Rectangle { x: 8px; y: 50px; width: 158px; height: 26px; border-radius: 5px; background: retention-day.has-hover || root.clipboard-retention-label == "1 Day" ? rgba(255,255,255,0.12) : transparent; }
                    Text { x: 14px; y: 50px; height: 26px; text: "1 Day"; color: white; font-size: 12px; vertical-alignment: center; }

                    retention-week := TouchArea { x: 8px; y: 78px; width: 158px; height: 26px; mouse-cursor: pointer; clicked => { root.clipboard-retention-selected("1 Week"); root.clipboard-retention-label = "1 Week"; root.show-clipboard-retention-menu = false; } }
                    Rectangle { x: 8px; y: 78px; width: 158px; height: 26px; border-radius: 5px; background: retention-week.has-hover || root.clipboard-retention-label == "1 Week" ? rgba(255,255,255,0.12) : transparent; }
                    Text { x: 14px; y: 78px; height: 26px; text: "1 Week"; color: white; font-size: 12px; vertical-alignment: center; }

                    retention-month := TouchArea { x: 8px; y: 106px; width: 158px; height: 26px; mouse-cursor: pointer; clicked => { root.clipboard-retention-selected("1 Month"); root.clipboard-retention-label = "1 Month"; root.show-clipboard-retention-menu = false; } }
                    Rectangle { x: 8px; y: 106px; width: 158px; height: 26px; border-radius: 5px; background: retention-month.has-hover || root.clipboard-retention-label == "1 Month" ? rgba(255,255,255,0.12) : transparent; }
                    Text { x: 14px; y: 106px; height: 26px; text: "1 Month"; color: white; font-size: 12px; vertical-alignment: center; }

                    retention-months := TouchArea { x: 8px; y: 134px; width: 158px; height: 26px; mouse-cursor: pointer; clicked => { root.clipboard-retention-selected("3 Months"); root.clipboard-retention-label = "3 Months"; root.show-clipboard-retention-menu = false; } }
                    Rectangle { x: 8px; y: 134px; width: 158px; height: 26px; border-radius: 5px; background: retention-months.has-hover || root.clipboard-retention-label == "3 Months" ? rgba(255,255,255,0.12) : transparent; }
                    Text { x: 14px; y: 134px; height: 26px; text: "3 Months"; color: white; font-size: 12px; vertical-alignment: center; }
                }
            }
        }

        if root.show-clipboard-context-menu : Rectangle {
            x: root.clipboard-context-x;
            y: root.clipboard-context-y;
            width: 148px;
            height: 36px;
            border-radius: 8px;
            background: rgba(16, 16, 18, 0.98);
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.14);
            drop-shadow-blur: 18px;
            drop-shadow-color: rgba(0, 0, 0, 0.45);

            delete-context-action := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => {
                    root.clipboard-delete-selected();
                    root.show-clipboard-context-menu = false;
                }
            }
            Rectangle { width: 100%; height: 100%; border-radius: 8px; background: delete-context-action.has-hover ? rgba(255,80,80,0.18) : transparent; }
            Path { x: 12px; y: 10px; width: 15px; height: 15px; viewbox-width: 24; viewbox-height: 24; stroke: #ff5252; stroke-width: 2px; fill: transparent; commands: "M3 6 H21 M8 6 V4 H16 V6 M6 6 L7 21 H17 L18 6"; }
            Text { x: 36px; y: 0px; height: 100%; text: "Delete Item"; color: #ff6262; font-size: 12px; font-weight: 900; vertical-alignment: center; }
        }
    }

    if root.show-clipboard-drag-preview : Rectangle {
        x: root.clipboard-drag-x + 12px;
        y: root.clipboard-drag-y + 12px;
        width: 154px;
        height: 42px;
        border-radius: 9px;
        background: rgba(18, 18, 18, 0.92);
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.18);
        drop-shadow-blur: 22px;
        drop-shadow-color: rgba(0, 0, 0, 0.55);
        drop-shadow-offset-y: 6px;
        opacity: 0.96;

        Rectangle {
            x: 8px;
            y: 8px;
            width: 26px;
            height: 26px;
            border-radius: 6px;
            background: rgba(246, 185, 76, 0.18);
            border-width: 1px;
            border-color: rgba(246, 185, 76, 0.34);

            Path {
                x: 6px;
                y: 5px;
                width: 14px;
                height: 16px;
                viewbox-width: 24;
                viewbox-height: 24;
                stroke: #f6b94c;
                stroke-width: 2.2px;
                fill: transparent;
                commands: "M6 2 H14 L20 8 V22 H6 Z M14 2 V8 H20";
            }
        }

        Rectangle {
            x: 25px;
            y: 22px;
            width: 15px;
            height: 15px;
            border-radius: 8px;
            background: #32d74b;
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.5);

            Path {
                x: 3px;
                y: 3px;
                width: 9px;
                height: 9px;
                viewbox-width: 24;
                viewbox-height: 24;
                stroke: white;
                stroke-width: 3px;
                fill: transparent;
                commands: "M12 5 V19 M5 12 H19";
            }
        }

        Text {
            x: 46px;
            y: 7px;
            width: 98px;
            height: 16px;
            text: root.clipboard-drag-title;
            color: #ffffff;
            font-size: 11px;
            font-weight: 900;
            overflow: elide;
            vertical-alignment: center;
        }

        Text {
            x: 46px;
            y: 23px;
            width: 98px;
            height: 12px;
            text: "Drop to paste";
            color: rgba(255, 255, 255, 0.58);
            font-size: 9px;
            font-weight: 750;
            overflow: elide;
            vertical-alignment: center;
        }
    }

    // ── CALENDAR DROPDOWN PANEL ──
    if root.show-calendar-dropdown : Rectangle {
        x: root.width - 356px;
        y: root.idle-height;
        width: 340px;
        height: 510px;
        background: root.topbar-panel-surface;
        border-radius: 16px;
        border-width: 1px;
        border-color: root.topbar-panel-border;
        drop-shadow-blur: 34px;
        drop-shadow-color: root.topbar-panel-shadow;
        drop-shadow-offset-y: 6px;
        clip: true;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // 1. Stacked Live Time & Date
            VerticalLayout {
                spacing: 2px;
                alignment: center;
                Text {
                    text: root.current-time-str;
                    font-size: 32px;
                    font-weight: 800;
                    color: white;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.selected-day-label != "" ? root.selected-day-label : root.date;
                    font-size: 13px;
                    font-weight: 600;
                    color: rgba(255, 255, 255, 0.5);
                    horizontal-alignment: center;
                }
            }

            // Separator
            Rectangle {
                height: 1px;
                background: rgba(255, 255, 255, 0.06);
            }

            // 2. Month Navigator (Month Name + Year and chevron navigation buttons)
            HorizontalLayout {
                alignment: space-between;
                height: 24px;
                
                TouchArea {
                    width: 24px;
                    height: 24px;
                    mouse-cursor: pointer;
                    clicked => {
                        // Go to previous month
                        if root.mini-calendar-view-month == 1 {
                            root.mini-calendar-view-month = 12;
                            root.mini-calendar-view-year = root.mini-calendar-view-year - 1;
                        } else {
                            root.mini-calendar-view-month = root.mini-calendar-view-month - 1;
                        }
                        root.mini-calendar-change-month-year(root.mini-calendar-view-month, root.mini-calendar-view-year);
                    }
                    Path {
                        width: 8px;
                        height: 12px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        stroke: rgba(255, 255, 255, 0.75);
                        stroke-width: 2px;
                        viewbox-width: 8;
                        viewbox-height: 12;
                        commands: "M 6 2 L 2 6 L 6 10";
                    }
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.picker-mode = root.picker-mode == "months" ? "days" : "months";
                    }
                    Text {
                        text: root.mini-calendar-months[root.mini-calendar-view-month - 1] + " " + root.mini-calendar-view-year;
                        font-size: 14px;
                        font-weight: 800;
                        color: white;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    width: 24px;
                    height: 24px;
                    mouse-cursor: pointer;
                    clicked => {
                        // Go to next month
                        if root.mini-calendar-view-month == 12 {
                            root.mini-calendar-view-month = 1;
                            root.mini-calendar-view-year = root.mini-calendar-view-year + 1;
                        } else {
                            root.mini-calendar-view-month = root.mini-calendar-view-month + 1;
                        }
                        root.mini-calendar-change-month-year(root.mini-calendar-view-month, root.mini-calendar-view-year);
                    }
                    Path {
                        width: 8px;
                        height: 12px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        stroke: rgba(255, 255, 255, 0.75);
                        stroke-width: 2px;
                        viewbox-width: 8;
                        viewbox-height: 12;
                        commands: "M 2 2 L 6 6 L 2 10";
                    }
                }
            }

            // 3. Grid of Days
            Rectangle {
                height: 160px;
                
                if root.picker-mode == "days": VerticalLayout {
                    spacing: 2px;

                    // Weekdays small header
                    HorizontalLayout {
                        height: 14px;
                        for day-name in ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"]: Text {
                            text: day-name;
                            font-size: 9px;
                            font-weight: 800;
                            color: rgba(255, 255, 255, 0.35);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: (340px - 32px) / 7;
                        }
                    }

                    // Day Cells (6 rows of 7 columns = 42 cells)
                    for row-idx in [0, 1, 2, 3, 4, 5]: HorizontalLayout {
                        height: 22px;
                        for col-idx in [0, 1, 2, 3, 4, 5, 6]: TouchArea {
                            property <int> cell-idx: row-idx * 7 + col-idx;
                            width: (340px - 32px) / 7;
                            enabled: root.mini-calendar-days.length > self.cell-idx && root.mini-calendar-days[self.cell-idx].day_num != "";
                            clicked => {
                                root.mini-calendar-select-date(self.cell-idx, root.mini-calendar-view-month, root.mini-calendar-view-year);
                            }

                            Rectangle {
                                width: 22px;
                                height: 22px;
                                x: (parent.width - self.width) / 2;
                                border-radius: 6px;
                                background: (root.mini-calendar-days.length > cell-idx && root.mini-calendar-days[cell-idx].is_selected) ? #22c55e : transparent;
                                
                                states [
                                    hover when parent.has-hover && root.mini-calendar-days.length > cell-idx && root.mini-calendar-days[cell-idx].day_num != "": {
                                        background: rgba(255, 255, 255, 0.08);
                                    }
                                ]

                                if root.mini-calendar-days.length > cell-idx: Text {
                                    text: root.mini-calendar-days[cell-idx].day_num;
                                    font-size: 10px;
                                    font-weight: root.mini-calendar-days[cell-idx].is_today ? 900 : 600;
                                    color: root.mini-calendar-days[cell-idx].is_selected ? white : (root.mini-calendar-days[cell-idx].is_today ? #22c55e : (root.mini-calendar-days[cell-idx].is_current_month ? white : rgba(255, 255, 255, 0.25)));
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                if root.picker-mode == "months": VerticalLayout {
                    spacing: 4px;
                    for r in [0, 1, 2, 3]: HorizontalLayout {
                        spacing: 4px;
                        height: 34px;
                        for c in [0, 1, 2]: TouchArea {
                            property <int> m-idx: r * 3 + c + 1;
                            clicked => {
                                root.mini-calendar-view-month = self.m-idx;
                                root.mini-calendar-change-month-year(self.m-idx, root.mini-calendar-view-year);
                                root.picker-mode = "days";
                            }

                            Rectangle {
                                border-radius: 6px;
                                background: root.mini-calendar-view-month == (r * 3 + c + 1) ? #22c55e : rgba(255, 255, 255, 0.03);

                                states [
                                    hover when parent.has-hover: {
                                        background: root.mini-calendar-view-month == (r * 3 + c + 1) ? #22c55e : rgba(255, 255, 255, 0.08);
                                    }
                                ]

                                Text {
                                    text: root.mini-calendar-months[r * 3 + c];
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: white;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // Separator
            Rectangle {
                height: 1px;
                background: rgba(255, 255, 255, 0.06);
            }

            // 4. "Up Next" events area (Scrollable)
            VerticalLayout {
                spacing: 6px;
                vertical-stretch: 1;
                
                Text {
                    text: "UP NEXT";
                    font-size: 10px;
                    font-weight: 900;
                    color: rgba(255, 255, 255, 0.4);
                }

                if root.filtered-calendar-events.length == 0: VerticalLayout {
                    alignment: center;
                    Text {
                        text: "No upcoming events";
                        font-size: 12px;
                        font-weight: 600;
                        color: rgba(255, 255, 255, 0.4);
                        horizontal-alignment: center;
                    }
                }

                if root.filtered-calendar-events.length > 0: ScrollView {
                    viewport-height: root.filtered-calendar-events.length * 46px;
                    VerticalLayout {
                        spacing: 6px;
                        alignment: start;
                        for event in root.filtered-calendar-events: Rectangle {
                            height: 40px;
                            background: rgba(255, 255, 255, 0.03);
                            border-radius: 8px;
                            
                            Rectangle {
                                x: 0;
                                width: 4px;
                                height: 100%;
                                background: #22c55e;
                                border-radius: 2px;
                            }
                            
                            VerticalLayout {
                                x: 12px;
                                width: parent.width - 20px;
                                alignment: center;
                                spacing: 2px;
                                
                                Text {
                                    text: event.title;
                                    font-size: 12px;
                                    font-weight: 750;
                                    color: white;
                                    overflow: elide;
                                }
                                Text {
                                    text: event.date_str;
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: rgba(255, 255, 255, 0.45);
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── TIMER DROPDOWN PANEL ──
    if root.show-timer-dropdown : Rectangle {
        x: root.width - 256px;
        y: root.idle-height;
        width: 240px;
        height: 200px;
        background: root.topbar-panel-surface;
        border-radius: 16px;
        border-width: 1px;
        border-color: root.topbar-panel-border;
        drop-shadow-blur: 34px;
        drop-shadow-color: root.topbar-panel-shadow;
        drop-shadow-offset-y: 6px;
        clip: true;

        if !root.show-timer-input-panel : VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: center;

            // Timer display
            Text {
                text: root.timer-remaining-str;
                font-size: 36px;
                font-weight: 700;
                color: white;
                horizontal-alignment: center;
            }

            // Progress bar
            Rectangle {
                height: 6px;
                background: rgba(255, 255, 255, 0.1);
                border-radius: 3px;
                Rectangle {
                    x: 0px;
                    width: parent.width * Math.clamp(root.timer-progress, 0.0, 1.0);
                    height: 100%;
                    background: #22c55e;
                    border-radius: 3px;
                }
            }

            // Controls
            HorizontalLayout {
                alignment: center;
                spacing: 16px;

                // Play/Pause button
                TouchArea {
                    width: 36px;
                    height: 36px;
                    mouse-cursor: pointer;
                    clicked => {
                        root.timer-toggle();
                    }
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 18px;
                        background: rgba(255, 255, 255, 0.08);
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.15);

                        Path {
                            width: 16px;
                            height: 16px;
                            x: (parent.width - self.width) / 2 + (root.timer-running ? 0px : 1.5px);
                            y: (parent.height - self.height) / 2;
                            fill: #22c55e;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: root.timer-running
                                ? "M6 19h4V5H6v14zm8-14v14h4V5h-4z"
                                : "M8 5v14l11-7z";
                        }
                    }
                }

                // Reset button
                TouchArea {
                    width: 36px;
                    height: 36px;
                    mouse-cursor: pointer;
                    clicked => {
                        root.timer-reset();
                    }
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 18px;
                        background: rgba(255, 255, 255, 0.08);
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.15);

                        Path {
                            width: 16px;
                            height: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            stroke: white;
                            stroke-width: 2.5px;
                            fill: transparent;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M21 12a9 9 0 1 1-2.64-6.36 M21 3v6h-6";
                        }
                    }
                }

                // Edit button
                TouchArea {
                    width: 36px;
                    height: 36px;
                    mouse-cursor: pointer;
                    clicked => {
                        root.timer-text-clicked();
                    }
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 18px;
                        background: rgba(255, 255, 255, 0.08);
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.15);

                        Path {
                            width: 16px;
                            height: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            fill: white;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z";
                        }
                    }
                }
            }
        }

        if root.show-timer-input-panel : VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: center;

            Text {
                text: "SET TIMER DURATION";
                font-size: 11px;
                font-weight: 800;
                color: rgba(255, 255, 255, 0.6);
                horizontal-alignment: center;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                // Hours input box
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "HH"; font-size: 9px; font-weight: 800; color: rgba(255,255,255,0.4); horizontal-alignment: center; }
                    Rectangle {
                        width: 48px;
                        height: 32px;
                        border-radius: 8px;
                        background: rgba(255, 255, 255, 0.06);
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.12);
                        TextInput {
                            text <=> root.input-h;
                            font-size: 15px;
                            font-weight: 700;
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Minutes input box
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "MM"; font-size: 9px; font-weight: 800; color: rgba(255,255,255,0.4); horizontal-alignment: center; }
                    Rectangle {
                        width: 48px;
                        height: 32px;
                        border-radius: 8px;
                        background: rgba(255, 255, 255, 0.06);
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.12);
                        TextInput {
                            text <=> root.input-m;
                            font-size: 15px;
                            font-weight: 700;
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Seconds input box
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "SS"; font-size: 9px; font-weight: 800; color: rgba(255,255,255,0.4); horizontal-alignment: center; }
                    Rectangle {
                        width: 48px;
                        height: 32px;
                        border-radius: 8px;
                        background: rgba(255, 255, 255, 0.06);
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.12);
                        TextInput {
                            text <=> root.input-s;
                            font-size: 15px;
                            font-weight: 700;
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                TouchArea {
                    width: 80px;
                    height: 28px;
                    clicked => {
                        root.close-timer-input-panel();
                    }
                    Rectangle {
                        border-radius: 14px;
                        background: rgba(255, 255, 255, 0.08);
                        Text {
                            text: "CANCEL";
                            font-size: 10px;
                            font-weight: 800;
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                TouchArea {
                    width: 80px;
                    height: 28px;
                    clicked => {
                        root.set-timer-from-input();
                    }
                    Rectangle {
                        border-radius: 14px;
                        background: #22c55e;
                        Text {
                            text: "START";
                            font-size: 10px;
                            font-weight: 800;
                            color: black;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ── WI-FI DROPDOWN PANEL ──
    if root.show-wifi-dropdown : Rectangle {
        x: root.width - 330px;
        y: root.idle-height;
        width: 314px;
        height: 364px;
        background: root.topbar-panel-surface;
        border-radius: 14px;
        border-width: 1px;
        border-color: root.topbar-panel-border;
        drop-shadow-blur: 34px;
        drop-shadow-color: root.topbar-panel-shadow;
        drop-shadow-offset-y: 6px;
        clip: true;

        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 60px;
            background: rgba(255, 255, 255, 0.035);

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: rgba(255, 255, 255, 0.08);
            }

            WifiStrengthIcon {
                x: 16px;
                y: 17px;
                icon-size: 22px;
                signal: root.wifi-signal;
                connected: root.wifi-connected;
                enabled: root.wifi-enabled;
                disconnected-color: rgba(255, 255, 255, 0.58);
            }

            Text {
                x: 48px;
                y: 11px;
                width: 162px;
                height: 20px;
                text: root.wifi-connected ? root.wifi-ssid : root.wifi-status-text;
                color: #f2eee8;
                font-size: 13px;
                font-weight: 900;
                overflow: elide;
                vertical-alignment: center;
            }

            Text {
                x: 48px;
                y: 31px;
                width: 162px;
                height: 16px;
                text: root.wifi-connected ? "Signal " + root.wifi-signal + "%" : (root.wifi-enabled ? "Not connected" : "Wi-Fi is off");
                color: rgba(242, 238, 232, 0.58);
                font-size: 10px;
                font-weight: 750;
                overflow: elide;
                vertical-alignment: center;
            }

            wifi-toggle := TouchArea {
                x: 226px;
                y: 16px;
                width: 42px;
                height: 24px;
                mouse-cursor: pointer;
                clicked => {
                    root.wifi-toggle(!root.wifi-connected);
                }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: 12px;
                    background: root.wifi-connected ? rgba(52, 199, 89, 0.32) : rgba(255, 255, 255, 0.12);
                    border-width: 1px;
                    border-color: root.wifi-connected ? rgba(52, 199, 89, 0.48) : rgba(255, 255, 255, 0.18);

                    Rectangle {
                        x: root.wifi-connected ? 20px : 3px;
                        y: 3px;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: root.wifi-connected ? #34c759 : rgba(255, 255, 255, 0.74);
                        animate x { duration: 120ms; easing: ease-out; }
                    }
                }
            }

            refresh-wifi := TouchArea {
                x: 278px;
                y: 16px;
                width: 22px;
                height: 24px;
                mouse-cursor: pointer;
                clicked => {
                    root.wifi-searching = true;
                    root.wifi-refresh();
                }

                if root.wifi-searching : Text {
                    x: 2px;
                    y: 0px;
                    width: 18px;
                    height: 20px;
                    text: "↻";
                    color: #f5b84f;
                    font-size: 17px;
                    font-weight: 900;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if !root.wifi-searching : Path {
                    x: 3px;
                    y: 4px;
                    width: 16px;
                    height: 16px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    stroke: refresh-wifi.has-hover ? #ffffff : rgba(255, 255, 255, 0.70);
                    stroke-width: 2.2px;
                    fill: transparent;
                    commands: "M20 6 V11 H15 M4 18 V13 H9 M18.8 9 C17.7 5.9 14.8 4 11.7 4 C8.8 4 6.2 5.6 4.9 8.1 M5.2 15 C6.3 18.1 9.2 20 12.3 20 C15.2 20 17.8 18.4 19.1 15.9";
                }
            }
        }

        Text {
            x: 18px;
            y: 72px;
            width: 160px;
            height: 16px;
            text: "Available Networks";
            color: rgba(242, 238, 232, 0.58);
            font-size: 10px;
            font-weight: 900;
            vertical-alignment: center;
        }

        if root.wifi-searching : Text {
            x: 186px;
            y: 72px;
            width: 110px;
            height: 16px;
            text: "Searching" + root.wifi-search-dots;
            color: #f5b84f;
            font-size: 10px;
            font-weight: 900;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        if root.wifi-networks.length > 0 : ScrollView {
            x: 18px;
            y: 94px;
            width: 278px;
            height: 156px;
            viewport-height: root.wifi-networks.length * 46px;

            VerticalLayout {
                spacing: 4px;
                for network in root.wifi-networks : WifiNetworkRow {
                    item: network;
                    selected: root.selected-wifi-ssid == network.ssid;
                    clicked(ssid, security, saved) => {
                        root.selected-wifi-ssid = ssid;
                        root.selected-wifi-security = security;
                        root.selected-wifi-saved = saved;
                        root.wifi-password = "";
                    }
                }
            }
        }

        if root.wifi-networks.length == 0 : Text {
            x: 18px;
            y: 118px;
            width: 278px;
            height: 44px;
            text: root.wifi-enabled ? "No networks found. Refresh to scan again." : "Turn Wi-Fi on to scan networks.";
            color: rgba(242, 238, 232, 0.48);
            font-size: 11px;
            font-weight: 750;
            wrap: word-wrap;
            vertical-alignment: center;
        }

        Text {
            x: 18px;
            y: 260px;
            width: 180px;
            height: 16px;
            text: root.selected-wifi-ssid == "" ? "Select a network" : root.selected-wifi-ssid;
            color: #f2eee8;
            font-size: 11px;
            font-weight: 900;
            overflow: elide;
            vertical-alignment: center;
        }

        Text {
            x: 204px;
            y: 260px;
            width: 92px;
            height: 16px;
            text: root.selected-wifi-ssid == "" ? "" : (root.selected-wifi-security == "Open" ? "Open" : (root.selected-wifi-saved ? "Saved" : "Password"));
            color: root.selected-wifi-security == "Open" || root.selected-wifi-saved ? rgba(242, 238, 232, 0.54) : #f5b84f;
            font-size: 9px;
            font-weight: 900;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }

        TextInput {
            x: 18px;
            y: 284px;
            width: 278px;
            height: 34px;
            text <=> root.wifi-password;
            color: #ffffff;
            font-size: 12px;
            single-line: true;
            accepted => {
                if root.selected-wifi-ssid != "" && (root.selected-wifi-security == "Open" || root.selected-wifi-saved || root.wifi-password != "") {
                    root.wifi-connect(root.selected-wifi-ssid, root.wifi-password);
                }
            }

            if self.text == "" : Text {
                x: 8px;
                y: 0px;
                width: parent.width - 16px;
                height: 100%;
                text: root.selected-wifi-ssid == ""
                    ? "Select a network first"
                    : (root.selected-wifi-security == "Open"
                        ? "Open network - no password needed"
                        : (root.selected-wifi-saved ? "Saved network - password optional" : "Enter Wi-Fi password"));
                color: rgba(242, 238, 232, 0.38);
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        connect-wifi := TouchArea {
            x: 18px;
            y: 328px;
            width: 132px;
            height: 24px;
            mouse-cursor: pointer;
            clicked => {
                if root.selected-wifi-ssid != "" && (root.selected-wifi-security == "Open" || root.selected-wifi-saved || root.wifi-password != "") {
                    root.wifi-connect(root.selected-wifi-ssid, root.wifi-password);
                }
            }
            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 7px;
                background: root.selected-wifi-ssid == "" || (root.selected-wifi-security != "Open" && !root.selected-wifi-saved && root.wifi-password == "")
                    ? rgba(255, 255, 255, 0.08)
                    : (connect-wifi.has-hover ? rgba(52, 199, 89, 0.28) : rgba(52, 199, 89, 0.18));
                border-width: 1px;
                border-color: root.selected-wifi-ssid == "" || (root.selected-wifi-security != "Open" && !root.selected-wifi-saved && root.wifi-password == "")
                    ? rgba(255, 255, 255, 0.14)
                    : rgba(52, 199, 89, 0.42);
                Text {
                    width: 100%;
                    height: 100%;
                    text: root.selected-wifi-ssid == "" || (root.selected-wifi-security != "Open" && !root.selected-wifi-saved && root.wifi-password == "") ? "Password" : "Connect";
                    color: root.selected-wifi-ssid == "" || (root.selected-wifi-security != "Open" && !root.selected-wifi-saved && root.wifi-password == "") ? rgba(242, 238, 232, 0.50) : #eaffef;
                    font-size: 11px;
                    font-weight: 900;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        disconnect-wifi := TouchArea {
            x: 164px;
            y: 328px;
            width: 132px;
            height: 24px;
            mouse-cursor: pointer;
            clicked => { root.wifi-disconnect(); }
            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 7px;
                background: disconnect-wifi.has-hover ? rgba(255, 80, 80, 0.22) : rgba(255, 80, 80, 0.12);
                border-width: 1px;
                border-color: rgba(255, 80, 80, 0.32);
                Text { width: 100%; height: 100%; text: "Disconnect"; color: #ffb8b8; font-size: 11px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }

    // ── VOLUME DROPDOWN PANEL ──
    if root.show-volume-dropdown : Rectangle {
        x: root.width - 256px;
        y: root.idle-height;
        width: 240px;
        height: 110px;
        background: root.topbar-panel-surface;
        border-radius: 16px;
        border-width: 1px;
        border-color: root.topbar-panel-border;
        drop-shadow-blur: 34px;
        drop-shadow-color: root.topbar-panel-shadow;
        drop-shadow-offset-y: 6px;
        clip: true;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: center;

            // 1. Top row: Mute button + Volume percentage text
            HorizontalLayout {
                alignment: space-between;
                
                // Mute / Unmute Button
                TouchArea {
                    width: 24px;
                    height: 24px;
                    mouse-cursor: pointer;
                    clicked => {
                        root.volume-mute();
                    }
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 12px;
                        background: rgba(255, 255, 255, 0.08);
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.12);

                        Path {
                            width: 12px;
                            height: 12px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            fill: root.is-muted ? #ef4444 : white;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: root.is-muted
                                ? "M4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"
                                : "M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z";
                        }
                    }
                }

                // Volume % text
                Text {
                    text: root.is-muted ? "MUTED" : "VOLUME: " + root.volume-value + "%";
                    font-size: 11px;
                    font-weight: 800;
                    color: white;
                    vertical-alignment: center;
                }
            }

            // 2. Horizontal Volume Slider
            Rectangle {
                height: 16px;
                background: rgba(255, 255, 255, 0.08);
                border-radius: 8px;
                clip: true;

                // Fill from left
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width * (root.is-muted ? 0.0 : (root.volume-value / 100.0));
                    height: 100%;
                    background: #22c55e;
                    border-radius: 8px;
                }

                // Volume slider touch area
                slider-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;

                    moved => {
                        if self.pressed {
                            let pct = Math.clamp(self.mouse-x / self.width, 0.0, 1.0);
                            root.volume-value = Math.round(pct * 100.0);
                            root.volume-changed(root.volume-value);
                        }
                    }
                    clicked => {
                        let pct = Math.clamp(self.mouse-x / self.width, 0.0, 1.0);
                        root.volume-value = Math.round(pct * 100.0);
                        root.volume-changed(root.volume-value);
                    }
                }
            }
        }
    }

    // ── RAVEN ICON CONTROL CENTER MENU ──
    // Placed as the LAST child of root so it renders above all other content.
    // x/y are absolute coords within the Pill window.
    if root.show-raven-menu: Rectangle {
        x: 8px;
        y: root.idle-height + 6px;
        width: 176px;
        height: 170px;
        // Glassmorphic background — matches other panels
        background: root.topbar-panel-surface;
        border-radius: 16px;
        border-width: 1px;
        border-color: root.topbar-panel-border;
        drop-shadow-blur: 34px;
        drop-shadow-color: root.topbar-panel-shadow;
        drop-shadow-offset-y: 6px;
        clip: true;

        // ── Click blocker: absorbs all pointer events so buttons work ──
        TouchArea {
            width: 100%; height: 100%;
            // Do nothing — just prevent click-through to the notch below
        }

        rm-layout := VerticalLayout {
            padding: 8px;
            spacing: 2px;

            // ─── Lock ───
            rm-lock-ta := TouchArea {
                height: 36px;
                clicked => {
                    root.show-raven-menu = false;
                    root.raven-lock();
                }
                Rectangle {
                    width: 100%; height: 100%;
                    border-radius: 8px;
                    background: rm-lock-ta.has-hover ? rgba(255,255,255,0.10) : transparent;
                    animate background { duration: 100ms; }
                    HorizontalLayout {
                        padding-left: 12px; spacing: 10px; alignment: start;
                        Rectangle {
                            width: 20px; height: 20px;
                            y: (parent.height - self.height) / 2;
                            Path {
                                x: 2px; y: 2px;
                                width: 16px; height: 8px;
                                viewbox-width: 16; viewbox-height: 8;
                                stroke: rgba(255,255,255,0.85); stroke-width: 1.5px; fill: transparent;
                                commands: "M 2 8 L 2 4 A 6 6 0 0 1 14 4 L 14 8";
                            }
                            Rectangle {
                                x: 2px; y: 8px;
                                width: 16px; height: 11px;
                                border-radius: 3px;
                                background: rgba(255,255,255,0.85);
                            }
                            Rectangle {
                                x: 8px; y: 11px;
                                width: 4px; height: 5px;
                                border-radius: 2px;
                                background: rgba(22,22,22,0.93);
                            }
                        }
                        Text {
                            text: "Lock";
                            font-size: 13px; font-weight: 600;
                            color: rgba(255,255,255,0.92);
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // ─── Sleep ───
            rm-sleep-ta := TouchArea {
                height: 36px;
                clicked => {
                    root.show-raven-menu = false;
                    root.raven-sleep();
                }
                Rectangle {
                    width: 100%; height: 100%;
                    border-radius: 8px;
                    background: rm-sleep-ta.has-hover ? rgba(255,255,255,0.10) : transparent;
                    animate background { duration: 100ms; }
                    HorizontalLayout {
                        padding-left: 12px; spacing: 10px; alignment: start;
                        Rectangle {
                            width: 20px; height: 20px;
                            y: (parent.height - self.height) / 2;
                            Path {
                                x: 2px; y: 2px;
                                width: 16px; height: 16px;
                                viewbox-width: 24; viewbox-height: 24;
                                stroke: rgba(255,255,255,0.85); stroke-width: 2px; fill: transparent;
                                commands: "M 21 12.79 A 9 9 0 1 1 11.21 3 A 7 7 0 0 0 21 12.79 Z";
                            }
                        }
                        Text {
                            text: "Sleep";
                            font-size: 13px; font-weight: 600;
                            color: rgba(255,255,255,0.92);
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // ─── Divider ───
            HorizontalLayout {
                height: 1px;
                padding-left: 12px; padding-right: 12px;
                Rectangle { height: 1px; background: rgba(255,255,255,0.10); }
            }

            // ─── Shut Down ───
            rm-shutdown-ta := TouchArea {
                height: 36px;
                clicked => {
                    root.show-raven-menu = false;
                    root.raven-shutdown();
                }
                Rectangle {
                    width: 100%; height: 100%;
                    border-radius: 8px;
                    background: rm-shutdown-ta.has-hover ? rgba(255,60,50,0.15) : transparent;
                    animate background { duration: 100ms; }
                    HorizontalLayout {
                        padding-left: 12px; spacing: 10px; alignment: start;
                        Rectangle {
                            width: 20px; height: 20px;
                            y: (parent.height - self.height) / 2;
                            Path {
                                x: 2px; y: 2px;
                                width: 16px; height: 16px;
                                viewbox-width: 24; viewbox-height: 24;
                                stroke: rm-shutdown-ta.has-hover ? #FF453A : rgba(255,255,255,0.85);
                                animate stroke { duration: 100ms; }
                                stroke-width: 2px; fill: transparent;
                                commands: "M 12 2 L 12 12 M 6.46 5.46 A 8 8 0 1 0 17.54 5.46";
                            }
                        }
                        Text {
                            text: "Shut Down";
                            font-size: 13px; font-weight: 600;
                            color: rm-shutdown-ta.has-hover ? #FF453A : rgba(255,255,255,0.92);
                            animate color { duration: 100ms; }
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // ─── Restart ───
            rm-restart-ta := TouchArea {
                height: 36px;
                clicked => {
                    root.show-raven-menu = false;
                    root.raven-restart();
                }
                Rectangle {
                    width: 100%; height: 100%;
                    border-radius: 8px;
                    background: rm-restart-ta.has-hover ? rgba(255,255,255,0.10) : transparent;
                    animate background { duration: 100ms; }
                    HorizontalLayout {
                        padding-left: 12px; spacing: 10px; alignment: start;
                        Rectangle {
                            width: 20px; height: 20px;
                            y: (parent.height - self.height) / 2;
                            Path {
                                x: 2px; y: 2px;
                                width: 16px; height: 16px;
                                viewbox-width: 24; viewbox-height: 24;
                                stroke: rgba(255,255,255,0.85); stroke-width: 2px; fill: transparent;
                                commands: "M 1 4 L 1 10 L 7 10 M 3.51 15 A 9 9 0 1 0 3.36 8.36 L 1 10";
                            }
                        }
                        Text {
                            text: "Restart";
                            font-size: 13px; font-weight: 600;
                            color: rgba(255,255,255,0.92);
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
