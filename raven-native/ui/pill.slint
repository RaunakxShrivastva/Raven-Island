    callback wifi-refresh();
    callback wifi-toggle(bool);
    callback wifi-disconnect();
    callback wifi-connect(string, string);
    callback focus-clipboard-search();

    public function close-transient-panels() {
        root.show-global-menu = false;
        root.show-raven-menu = false;
        root.show-caffeine-menu = false;
        root.show-timer-menu = false;
        root.show-clock-add-menu = false;
        root.show-clock-row-menu = false;
        root.show-media-source-menu = false;
        root.show-drop-action-menu = false;
        root.show-calendar-dropdown = false;
        root.show-timer-dropdown = false;
        root.show-volume-dropdown = false;
        root.show-wifi-dropdown = false;
        root.show-topbar-stats-dropdown = false;
        root.show-clipboard-dropdown = false;
        root.show-clipboard-settings-panel = false;
        root.show-clipboard-rename-panel = false;
        root.show-clipboard-hotkeys-panel = false;
        root.show-clipboard-context-menu = false;
        root.show-clipboard-retention-menu = false;
        root.show-timer-input-panel = false;
        root.show-mini-calendar = false;
        root.close-popups-trigger += 1;
        root.focus-duration-dropdown-changed(false);
    }

    // ── INNER VISIBLE NOTCH / PILL ──
    // This rectangle morphs width/height and is centered within the larger fixed OS window.
    // Centering: x = (parent.width - self.width) / 2 (left: 50%; transform: translateX(-50%) in Tauri)
    
    // Inverse curves moved to the end of the file to render on top of inner-rect border

    // Full width horizontal black bar (behind the notch) when full-width-bar is enabled
    if root.full-width-bar && root.system-hud-kind == "" && root.notch-phase == "closed" : Rectangle {
        x: 0px;
        y: root.auto-hide && !root.is-expanded && !root.is-hovered && root.system-hud-kind == "" ? -self.height - 10px : (root.appearance-shape != "floating" ? -1px : 0px);
        width: parent.width;
        height: root.appearance-shape != "floating" ? root.idle-height : root.idle-height + 8px;
        background: root.bezel-bg-color;
        
        // Bottom border line
        Rectangle {
            y: parent.height - 1px;
            width: 100%;
            height: 1px;
            background: rgba(255, 255, 255, 0.08);
        }

        if root.top-bar-widgets : HorizontalLayout {
            alignment: start;
            y: 0px;
            height: parent.height;
            padding-left: 16px;
            spacing: 12px;

            // 1. Raven Notch Logo — click to open the Raven control center
            if root.top-bar-widget-raven : raven-btn := TouchArea {
                width: 28px;
                height: 28px;
                y: (parent.height - self.height) / 2;
                clicked => {
                    root.toggle-raven-menu-rust();
                }
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 7px;
                    background: raven-btn.has-hover ? rgba(255, 255, 255, 0.1) : (root.show-raven-menu ? rgba(255, 255, 255, 0.12) : transparent);
                    animate background { duration: 120ms; }
                    Image {
                        source: @image-url("assets/app_logo.png");
                        width: 20px;
                        height: 20px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Divider — separates Raven icon control area from the app list
            if root.top-bar-widget-raven && (root.top-bar-widget-media || root.top-bar-widget-apps) : Rectangle {
                width: 1px;
                height: 16px;
                y: (parent.height - self.height) / 2;
                background: rgba(255, 255, 255, 0.18);
            }

            // 2. Media Player Widget
            if root.top-bar-widget-media && root.media-title != "" && root.media-title != "No Media Playing" : HorizontalLayout {
                spacing: 10px;
                height: parent.height;
                alignment: center;

                // Album Art
                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 4px;
                    clip: true;
                    background: #282828;
                    y: (parent.height - self.height) / 2;

                    if root.has-media-art : Image {
                        source: root.media-art-url;
                        width: 100%;
                        height: 100%;
                    }
                    if !root.has-media-art : Image {
                        source: @image-url("assets/nav-media.svg");
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: rgba(255, 255, 255, 0.5);
                    }
                }

                // Title and Artist
                VerticalLayout {
                    alignment: center;
                    width: 120px;
                    height: parent.height;

                    Text {
                        text: root.media-title;
                        font-size: 11px;
                        font-weight: 850;
                        color: white;
                        overflow: elide;
                    }
                    Text {
                        text: root.media-artist;
                        font-size: 9px;
                        font-weight: 500;
                        color: rgba(255, 255, 255, 0.5);
                        overflow: elide;
                    }
                }

                // Media Controls (Prev, Play/Pause, Next)
                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;
                    height: parent.height;

                    TouchArea {
                        width: 20px;
                        height: parent.height;
                        clicked => { root.prev(); }
                        Path {
                            width: 10px;
                            height: 10px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            fill: rgba(255, 255, 255, 0.88);
                            commands: "M 10 0 L 2 5 L 10 10 Z M 0 0 L 2 0 L 2 10 L 0 10 Z";
                        }
                    }

                    TouchArea {
                        width: 20px;
                        height: parent.height;
                        clicked => { root.play-pause(); }
                        if root.is-playing : Path {
                            width: 10px;
                            height: 10px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            fill: rgba(255, 255, 255, 0.88);
                            commands: "M 0 0 L 3 0 L 3 10 L 0 10 Z M 6 0 L 9 0 L 9 10 L 6 10 Z";
                        }
                        if !root.is-playing : Path {
                            width: 10px;
                            height: 10px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            fill: rgba(255, 255, 255, 0.88);
                            commands: "M 0 0 L 8 5 L 0 10 Z";
                        }
                    }

                    TouchArea {
                        width: 20px;
                        height: parent.height;
                        clicked => { root.next(); }
                        Path {
                            width: 10px;
                            height: 10px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            fill: rgba(255, 255, 255, 0.88);
                            commands: "M 0 0 L 8 5 L 0 10 Z M 8 0 L 10 0 L 10 10 L 8 10 Z";
                        }
                    }
                }
            }

            // 3. Separator vertical line
            if root.top-bar-widget-media && root.media-title != "" && root.media-title != "No Media Playing" && root.top-bar-widget-apps : Rectangle {
                width: 1px;
                height: 16px;
                y: (parent.height - self.height) / 2;
                background: rgba(255, 255, 255, 0.15);
            }

            // 4. Opened Apps List, clipped before the center notch.
            if root.top-bar-widget-apps : app-strip-toggle := TouchArea {
                width: 20px;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => {
                    root.active-apps-hidden = !root.active-apps-hidden;
                }

                Rectangle {
                    width: 20px;
                    height: 24px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 6px;
                    background: app-strip-toggle.has-hover ? rgba(255, 255, 255, 0.10) : transparent;

                    if !root.active-apps-hidden : Image {
                        source: @image-url("assets/magic-lamp-1.svg");
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: app-strip-toggle.has-hover ? #ffffff : rgba(255, 255, 255, 0.86);
                    }

                    if root.active-apps-hidden : Image {
                        source: @image-url("assets/magic-lamp-2.svg");
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: app-strip-toggle.has-hover ? #ffffff : rgba(255, 255, 255, 0.86);
                    }
                }
            }

            if root.top-bar-widget-apps && !root.active-apps-hidden : ScrollView {
                property <length> preceding-width: 
                    16px // padding-left
                    + (root.top-bar-widget-raven ? 28px + 12px : 0px)
                    + (root.top-bar-widget-raven && (root.top-bar-widget-media || root.top-bar-widget-apps) ? 1px + 12px : 0px)
                    + (root.top-bar-widget-media && root.media-title != "" && root.media-title != "No Media Playing" ? 250px + 12px : 0px)
                    + (root.top-bar-widget-media && root.media-title != "" && root.media-title != "No Media Playing" && root.top-bar-widget-apps ? 1px + 12px : 0px)
                    + (root.top-bar-widget-apps ? 20px + 12px : 0px);

                width: Math.min(
                    Math.max(
                        0px,
                        (root.screen-width > 0px ? root.screen-width : 1920px) / 2
                            - root.idle-width / 2
                            - preceding-width
                    ),
                    root.open-apps.length * 36px
                );
                height: parent.height;
                viewport-width: root.open-apps.length * 36px;
                viewport-height: parent.height;
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy: always-off;

                HorizontalLayout {
                    spacing: 8px;
                    height: parent.height;
                    
                    for app in root.open-apps : ta := TouchArea {
                        width: 28px;
                        height: parent.height;
                        
                        pointer-event(evt) => {
                            if evt.button == PointerEventButton.left && evt.kind == PointerEventKind.down {
                                root.activate-app(app.id);
                            } else if evt.button == PointerEventButton.right && evt.kind == PointerEventKind.down {
                                root.show-app-context-menu(app.id);
                            }
                        }

                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 6px;
                            background: ta.has-hover ? rgba(255, 255, 255, 0.1) : transparent;
                            y: (parent.height - self.height) / 2;
                            
                            Image {
                                source: app.icon;
                                width: 18px;
                                height: 18px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }
            }
        }

        if root.top-bar-widgets : HorizontalLayout {
            alignment: end;
            y: 0px;
            height: parent.height;
            padding-right: 16px;
            spacing: 12px;

            // 1. Top bar stats popup trigger
            if root.top-bar-widget-stats : ta-topbar-stats := TouchArea {
                width: 18px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                mouse-cursor: pointer;
                clicked => {
                    root.toggle-topbar-stats-rust();
                }
                Path {
                    width: 100%;
                    height: 100%;
                    fill: ta-topbar-stats.has-hover || root.show-topbar-stats-dropdown ? #f5b84f : rgba(255, 255, 255, 0.85);
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: "M3 12 H7 L10 5 L14 19 L17 12 H21";
                }
            }

            // 2. Clipboard history popup trigger
            if root.top-bar-widget-clipboard : ta-topbar-clipboard := TouchArea {
                width: 18px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                mouse-cursor: pointer;
                clicked => {
                    root.toggle-clipboard-dropdown-rust();
                }
                Path {
                    width: 100%;
                    height: 100%;
                    fill: ta-topbar-clipboard.has-hover || root.show-clipboard-dropdown ? #f5b84f : rgba(255, 255, 255, 0.85);
                    viewbox-width: 512;
                    viewbox-height: 512;
                    commands: "M256 32 C226 32 210 55 210 82 L210 146 C210 171 230 191 256 191 C282 191 302 171 302 146 L302 82 C302 55 286 32 256 32 Z M126 86 C101 86 82 106 82 131 L82 186 C82 207 99 224 120 224 L392 224 C413 224 430 207 430 186 L430 131 C430 106 411 86 386 86 L336 86 L336 148 C336 192 300 228 256 228 C212 228 176 192 176 148 L176 86 Z M82 174 L82 430 C82 457 104 480 131 480 L381 480 C408 480 430 457 430 430 L430 174 C430 204 406 228 376 228 L136 228 C106 228 82 204 82 174 Z";
                }
            }

            // 3. Speaker Icon (clickable to toggle volume slider)
            if root.top-bar-widget-volume : ta-speaker := TouchArea {
                width: 16px;
                height: 16px;
                y: (parent.height - self.height) / 2;
                mouse-cursor: pointer;
                clicked => {
                    root.toggle-volume-dropdown-rust();
                }
                Path {
                    width: 100%;
                    height: 100%;
                    fill: ta-speaker.has-hover ? white : rgba(255, 255, 255, 0.85);
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: root.is-muted
                        ? "M4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"
                        : "M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z";
                }
            }

            // 4. Wi-Fi Widget (clickable to open Wi-Fi panel)
            if root.top-bar-widget-wifi : ta-wifi := TouchArea {
                width: 18px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                mouse-cursor: pointer;
                clicked => {
                    root.toggle-wifi-dropdown-rust();
                }
                WifiStrengthIcon {
                    width: 100%;
                    height: 100%;
                    icon-size: 18px;
                    signal: root.wifi-signal;
                    connected: root.wifi-connected;
                    enabled: root.wifi-enabled;
                    disconnected-color: ta-wifi.has-hover || root.show-wifi-dropdown ? #f5b84f : rgba(255, 255, 255, 0.72);
                }
            }

            // 5. Battery Widget (non-clickable)
            if root.top-bar-widget-battery : Rectangle {
                width: 48px; height: parent.height;
                clip: true;
                HorizontalLayout {
                    alignment: center;
                    spacing: 4px;
                    height: 12px;
                    y: (parent.height - self.height) / 2;
                    Rectangle {
                        width: 22px; height: 12px;
                        border-width: 1px; border-color: rgba(255, 255, 255, 0.88);
                        border-radius: 2px;
                        Rectangle {
                            x: 1px; y: 1px;
                            width: (parent.width - 2px) * root.battery-pct / 100.0;
                            height: parent.height - 2px;
                            background: root.battery-color;
                            border-radius: 1px;
                        }
                        Rectangle {
                            x: parent.width; y: 3px;
                            width: 1.5px; height: 4px;
                            background: rgba(255, 255, 255, 0.88);
                            border-radius: 0.5px;
                        }
                        if root.is-charging : Path {
                            width: 6px; height: 8px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            fill: white;
                            commands: "M3 0 L1 4.5 H2.5 L2 8 L5 3.5 H3.5 Z";
                        }
                    }
                    if !root.is-charging : Text {
                        text: round(root.battery-pct) + "";
                        font-size: 9px; font-weight: 850;
                        color: rgba(255, 255, 255, 0.92);
                        vertical-alignment: center;
                    }
                }
            }

            // Vertical Separator 1
            Rectangle {
                width: (root.top-bar-widget-timer || root.top-bar-widget-calendar) ? 1px : 0px;
                height: (root.top-bar-widget-timer || root.top-bar-widget-calendar) ? 14px : 0px;
                background: rgba(255, 255, 255, 0.15);
                y: (parent.height - self.height) / 2;
            }

            // 4. Timer/Stopwatch Widget (clickable to toggle timer panel)
            if root.top-bar-widget-timer : spider-timer-handle := TouchArea {
                y: (parent.height - self.height) / 2;
                width: 22px;
                height: 24px;
                mouse-cursor: grab;
                pointer-event(evt) => {
                    if evt.button == PointerEventButton.left && evt.kind == PointerEventKind.down {
                        root.spider-timer-drag-start(
                            spider-timer-handle.mouse-x / 1px,
                            spider-timer-handle.mouse-y / 1px,
                            spider-timer-handle.width / 1px,
                            spider-timer-handle.height / 1px
                        );
                    }
                }

                Rectangle {
                    width: 20px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 10px;
                    background: spider-timer-handle.has-hover ? rgba(255, 255, 255, 0.12) : rgba(255, 255, 255, 0.03);
                    border-width: 1px;
                    border-color: spider-timer-handle.has-hover ? rgba(255, 255, 255, 0.35) : rgba(255, 255, 255, 0.10);
                    Image {
                        source: @image-url("assets/spiderman.svg");
                        width: 15px;
                        height: 15px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            if root.top-bar-widget-timer : ta-timer := TouchArea {
                y: (parent.height - self.height) / 2;
                height: 22px;
                width: 68px;
                mouse-cursor: pointer;
                clicked => {
                    root.toggle-timer-dropdown-rust();
                }
                
                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: 11px;
                    background: rgba(255, 255, 255, 0.05);
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.1);
                    clip: true;
                    
                    // The "green liquid fill" progress bar
                    if root.timer-progress > 0.0 : Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width * Math.clamp(root.timer-progress, 0.0, 1.0);
                        height: 100%;
                        background: #22c55e;
                        // Smoothly animate the liquid fill width
                        animate width { duration: 150ms; }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;
                        
                        // Stopwatch icon SVG Path
                        Path {
                            width: 11px;
                            height: 11px;
                            fill: root.timer-progress > 0.45 
                                ? (ta-timer.has-hover ? #022c22 : #064e3b) 
                                : (ta-timer.has-hover ? white : rgba(255, 255, 255, 0.85));
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M15 1H9v2h6V1zm-4 13h2V8h-2v6zm8.03-6.61l1.42-1.42c-.43-.51-.9-.99-1.41-1.41l-1.42 1.42C16.07 4.74 14.12 4 12 4c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-2.12-.74-4.07-1.97-5.61zM12 20c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z";
                            y: (parent.height - self.height) / 2;
                        }
                        
                        Text {
                            text: root.timer-remaining-str;
                            font-size: 9px;
                            font-weight: 800;
                            font-family: "Consolas";
                            color: root.timer-progress > 0.45 
                                ? (ta-timer.has-hover ? #022c22 : #064e3b) 
                                : (ta-timer.has-hover ? white : rgba(255, 255, 255, 0.88));
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Vertical Separator 2
            Rectangle {
                width: (root.top-bar-widget-timer && root.top-bar-widget-calendar) ? 1px : 0px;
                height: (root.top-bar-widget-timer && root.top-bar-widget-calendar) ? 14px : 0px;
                background: rgba(255, 255, 255, 0.15);
                y: (parent.height - self.height) / 2;
            }

            // 5. DateTime Widget (clickable to open calendar panel)
            if root.top-bar-widget-calendar : ta-datetime := TouchArea {
                width: 92px;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => {
                    root.toggle-calendar-dropdown-rust();
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    // Clock icon SVG Path
                    Path {
                        width: 14px;
                        height: 14px;
                        fill: ta-datetime.has-hover ? white : rgba(255, 255, 255, 0.85);
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: "M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z";
                        y: (parent.height - self.height) / 2;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;

                        Text {
                            text: root.current-time-str;
                            font-size: 10px;
                            font-weight: 850;
                            color: ta-datetime.has-hover ? white : rgba(255, 255, 255, 0.95);
                            horizontal-alignment: left;
                        }

                        Text {
                            text: root.date;
                            font-size: 8px;
                            font-weight: 500;
                            color: ta-datetime.has-hover ? rgba(255, 255, 255, 0.85) : rgba(255, 255, 255, 0.5);
                            horizontal-alignment: left;
                        }
                    }
                }
            }
        }

        animate y { duration: 250ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
    }

    inner-rect := Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.auto-hide && !root.is-expanded && !root.is-hovered && root.system-hud-kind == "" ? -self.height - 10px : (root.appearance-shape != "floating" ? -1px : 8px);
        opacity: root.auto-hide && !root.is-expanded && !root.is-hovered && root.system-hud-kind == "" ? 0.0 : 1.0;
        // Pill always stays at its normal centered size — the full-width bezel bar is drawn behind it
        width: root.system-hud-kind != "" ? 720px : (root.motion-width > 0px ? root.motion-width : (root.is-expanded ? 720px : root.idle-width));
        height: root.system-hud-kind != "" ? 244px : (root.motion-height > 0px ? root.motion-height : (root.is-expanded ? 244px : root.idle-height));
        border-top-left-radius: root.appearance-shape != "floating" ? 0px : root.motion-radius;
        border-top-right-radius: root.appearance-shape != "floating" ? 0px : root.motion-radius;
        border-bottom-left-radius: root.motion-radius;
        border-bottom-right-radius: root.motion-radius;
        background: root.notch-bg-color;
        // Hide the pill border when it sits flush on the full-width bezel bar — the bezel provides its own bottom line
        border-width: (root.full-width-bar && !root.is-expanded) ? 0px : 1px;
        border-color: rgba(255, 255, 255, 0.08);
        clip: true;
        
        animate y { duration: 250ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
        animate opacity { duration: 200ms; easing: ease-out; }
        
        // ── IDLE PILL CLICK TO EXPAND ──
        if !root.is-expanded: TouchArea {
            clicked => {
                root.request-notch-open();
            }

            Rectangle {
                width: 100%;
                height: 100%;
                background: transparent;

                // Left Date (split mode "all")
                if root.idle-pill-mode == "all" && !(root.show-pill-waveform && root.media-waveform-active): Text {
                    x: 22px;
                    text: root.date;
                    font-size: 13px;
                    font-weight: 800;
                    color: rgba(255, 255, 255, 0.75);
                    vertical-alignment: center;
                }

                // Centered Mode Displays (name, date, clock)
                if !(root.show-pill-waveform && root.media-waveform-active): HorizontalLayout {
                    alignment: center;
                    Text {
                        text: root.idle-pill-mode == "name" ? (root.idle-custom-name != "" ? root.idle-custom-name : "RAVEN NOTCH") :
                              root.idle-pill-mode == "date" ? root.date :
                              root.idle-pill-mode == "clock" ? root.time : "";
                        font-size: 13px;
                        font-weight: 900;
                        color: white;
                        letter-spacing: 0.5px;
                        vertical-alignment: center;
                    }
                }

                // Right Time (split mode "all")
                if root.idle-pill-mode == "all" && !(root.show-pill-waveform && root.media-waveform-active): Text {
                    x: parent.width - self.width - root.right-reserve;
                    text: root.time;
                    font-size: 13px;
                    font-weight: 800;
                    color: rgba(255, 255, 255, 0.75);
                    vertical-alignment: center;
                    animate x { duration: 250ms; easing: ease-out; }
                }

                // Waveform Bounce Visualizer (Centered if active media)
                if root.show-pill-waveform && root.media-waveform-active: HorizontalLayout {
                    alignment: center;
                    spacing: 2px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;

                    for height-val[idx] in root.waveform-heights: Rectangle {
                        width: 2px;
                        height: (7.2 + (0.5 - 0.5 * Math.cos(((root.wave-time - root.waveform-delays[idx]) * 6.2831853 / root.waveform-durations[idx]) * 1rad)) * 10.8) * 1px;
                        background: white;
                        border-radius: 1px;
                        y: (18px - self.height) / 2;
                    }
                }

                // RavenZone right indicators slot
                if root.show-raven-zone: Rectangle {
                    x: parent.width - self.width - 15px;
                    y: (parent.height - 22px) / 2;
                    height: 22px;

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {}
                    }

                    HorizontalLayout {
                        height: 100%;
                        alignment: end;
                        spacing: 8px;

                    // --- PERSISTENT LAYER: Battery / Charging / Caffeine / Camera ---
                    if root.active-alert-type == "": HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        if root.visible-persistent == "charging" || root.visible-persistent == "low_battery": Rectangle {
                            width: (root.visible-persistent == "charging" && root.always-on-charging-mode == "pct") ? 26px : 14px;
                            height: 22px;

                            if root.visible-persistent == "low_battery" || (root.visible-persistent == "charging" && root.always-on-charging-mode == "battery"): Rectangle {
                                width: 14px;
                                height: 22px;
                                // Shell
                                Path {
                                    width: 12px;
                                    height: 18px;
                                    x: 1px;
                                    y: 4px;
                                    stroke: root.battery-color;
                                    stroke-width: 1.8px;
                                    commands: "M 3 0 L 9 0 C 10.65 0 12 1.35 12 3 L 12 15 C 12 16.65 10.65 18 9 18 L 3 18 C 1.35 18 0 16.65 0 15 L 0 3 C 0 1.35 1.35 0 3 0 Z";
                                }
                                // Tip
                                Path {
                                    width: 6px;
                                    height: 3px;
                                    x: 4px;
                                    y: 1px;
                                    stroke: root.battery-color;
                                    stroke-width: 1.8px;
                                    commands: "M 0 1 L 6 1";
                                }
                                // Dynamic Fill
                                Rectangle {
                                    x: 3px;
                                    y: 6px + (14px * (1.0 - (root.battery-pct / 100.0)));
                                    width: 8px;
                                    height: 14px * (root.battery-pct / 100.0);
                                    background: root.battery-color;
                                    border-radius: 1px;
                                }
                                // Charging bolt inside the battery icon if charging
                                if root.visible-persistent == "charging": Path {
                                    width: 6px;
                                    height: 10px;
                                    x: 4px;
                                    y: 8px;
                                    fill: white;
                                    viewbox-width: 24;
                                    viewbox-height: 24;
                                    commands: "M 13 2 L 4 14 L 11 14 L 10 22 L 19 10 L 12 10 L 13 2 Z";
                                }
                            }

                            if root.visible-persistent == "charging" && root.always-on-charging-mode == "bolt": Path {
                                width: 14px;
                                height: 18px;
                                y: 2px;
                                fill: root.battery-color;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: "M 13 2 L 4 14 L 11 14 L 10 22 L 19 10 L 12 10 L 13 2 Z";
                            }

                            if root.visible-persistent == "charging" && root.always-on-charging-mode == "pct": Text {
                                text: round(root.battery-pct) + "%";
                                font-size: 11px;
                                font-weight: 900;
                                color: root.battery-color;
                                vertical-alignment: center;
                            }
                        }

                        if root.visible-persistent == "camera": Rectangle {
                            width: 18px;
                            height: 18px;
                            y: 2px;

                            Path {
                                width: 18px;
                                height: 18px;
                                fill: rgba(255, 255, 255, 0.7);
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: "M 17 10.5 L 17 7 C 17 6.45 16.55 6 16 6 L 4 6 C 3.45 6 3 6.45 3 7 L 3 17 C 3 17.55 3.45 18 4 18 L 16 18 C 16.55 18 17 17.55 17 17 L 17 13.5 L 21 17.5 L 21 6.5 Z";
                            }

                            // Breathing red dot
                            Rectangle {
                                x: 13px;
                                y: 3px;
                                width: 5px;
                                height: 5px;
                                background: #FF3B30;
                                border-radius: 2.5px;
                            }
                        }

                        if root.visible-persistent == "caffeine": Rectangle {
                            width: 18px;
                            height: 18px;
                            y: 2px;

                            Image {
                                width: 18px;
                                height: 18px;
                                source: @image-url("assets/caffeine.svg");
                                colorize: #f5c16c;
                            }

                            Rectangle {
                                x: 13px;
                                y: 1px;
                                width: 5px;
                                height: 5px;
                                background: #f5c16c;
                                border-radius: 2.5px;
                            }
                        }
                    }

                    // --- TRANSIENT LAYER: Queued / Active Alerts ---
                    if root.active-alert-type != "": HorizontalLayout {
                        spacing: 4px;
                        alignment: end;

                        if root.active-alert-type == "charger_in": Rectangle {
                            width: 22px;
                            height: 22px;
                            y: 2px;

                            property <float> ring-scale: 1.0;
                            property <float> ring-opacity: 1.0;
                            property <float> bolt-scale: 0.0;

                            init => {
                                self.ring-scale = 0.62;
                                self.ring-opacity = 0.0;
                                self.bolt-scale = 1.0;
                            }

                            animate ring-scale { duration: 950ms; easing: cubic-bezier(0.66, 0.0, 0.34, 1.0); }
                            animate ring-opacity { duration: 950ms; easing: cubic-bezier(0.66, 0.0, 0.34, 1.0); }
                            animate bolt-scale { duration: 950ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1.0); }

                            Rectangle {
                                width: 20px * parent.ring-scale;
                                height: 20px * parent.ring-scale;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-width: 1.8px;
                                border-color: rgba(236, 28, 36, parent.ring-opacity);
                                border-radius: self.width / 2;
                                background: transparent;
                            }

                            Path {
                                width: 22px * parent.bolt-scale;
                                height: 22px * parent.bolt-scale;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                fill: #ec1c24;
                                viewbox-width: 500;
                                viewbox-height: 500;
                                commands: "M 315.893 91.991 L 193.203 259.378 L 241.909 259.378 L 182.654 397.009 L 182.615 397.009 L 305.305 229.621 L 256.598 229.621 L 315.853 91.991 L 315.893 91.991 Z";
                            }
                        }

                        if root.active-alert-type == "charger_out": Path {
                            width: 18px;
                            height: 18px;
                            y: 2px;
                            stroke: white;
                            stroke-width: 2px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M 18 10 L 14 10 L 14 4 L 10 4 L 10 10 L 6 10 C 4.9 10 4 10.9 4 12 L 4 14 C 4 15.1 4.9 16 6 16 L 9 16 L 9 20 L 15 20 L 15 16 L 18 16 C 19.1 16 20 15.1 20 14 L 20 12 C 20 10.9 19.1 10 18 10 Z";
                        }

                        if root.active-alert-type == "low_battery": Rectangle {
                            width: 14px;
                            height: 22px;
                            // Shell
                            Path {
                                width: 12px;
                                height: 18px;
                                x: 1px;
                                y: 4px;
                                stroke: #FF3B30;
                                stroke-width: 1.8px;
                                commands: "M 3 0 L 9 0 C 10.65 0 12 1.35 12 3 L 12 15 C 12 16.65 10.65 18 9 18 L 3 18 C 1.35 18 0 16.65 0 15 L 0 3 C 0 1.35 1.35 0 3 0 Z";
                            }
                            // Tip
                            Path {
                                width: 6px;
                                height: 3px;
                                x: 4px;
                                y: 1px;
                                stroke: #FF3B30;
                                stroke-width: 1.8px;
                                commands: "M 0 1 L 6 1";
                            }
                            // Dynamic Fill
                            Rectangle {
                                x: 3px;
                                y: 6px + (14px * (1.0 - (root.battery-pct / 100.0)));
                                width: 8px;
                                height: 14px * (root.battery-pct / 100.0);
                                background: #FF3B30;
                                border-radius: 1px;
                            }
                        }

                        if root.active-alert-type == "unlock": Rectangle {
                            width: 24px;
                            height: 20px;
                            y: 2px;

                            property <length> lock-offset-x: 0px;
                            property <length> keyhole-width: 5px;
                            property <float> closed-shackle-opacity: 1.0;
                            property <float> open-shackle-opacity: 0.0;
                            property <length> open-shackle-x: 3px;
                            property <length> open-shackle-y: 0px;

                            init => {
                                self.lock-offset-x = -4px;
                                self.keyhole-width = 1px;
                                self.closed-shackle-opacity = 0.0;
                                self.open-shackle-opacity = 1.0;
                                self.open-shackle-x = -2px;
                                self.open-shackle-y = -5px;
                            }

                            animate lock-offset-x { duration: 900ms; easing: cubic-bezier(0.333, 0.0, 0.0, 1.0); }
                            animate keyhole-width { duration: 900ms; easing: cubic-bezier(0.333, 0.0, 0.667, 1.0); }
                            animate closed-shackle-opacity { duration: 360ms; easing: ease-out; }
                            animate open-shackle-opacity { duration: 480ms; easing: ease-out; }
                            animate open-shackle-x { duration: 900ms; easing: cubic-bezier(0.333, 0.0, 0.0, 1.0); }
                            animate open-shackle-y { duration: 900ms; easing: cubic-bezier(0.333, 0.0, 0.0, 1.0); }

                            // Closed shackle from the uploaded lock SVG.
                            Path {
                                x: 3px + parent.lock-offset-x;
                                y: 0px;
                                width: 18px;
                                height: 12px;
                                opacity: parent.closed-shackle-opacity;
                                fill: #00FF88;
                                viewbox-width: 58.22;
                                viewbox-height: 57.61;
                                commands: "M 29.83 0 C 29.83 0 29.82 0 29.81 0 L 29.22 0 L 29 0 L 28.41 0 C 28.4 0 28.39 0 28.39 0 C 12.71 0 0 12.71 0 28.39 L 0 50.599 C 0 52.189 0.65 53.619 1.69 54.649 C 2.73 55.689 4.16 56.329 5.74 56.329 C 8.91 56.329 11.48 53.759 11.48 50.589 L 11.48 28.39 C 11.49 19.04 19.08 11.47 28.42 11.48 L 29 11.48 L 29.22 11.48 L 29.8 11.48 C 39.14 11.47 46.73 19.04 46.74 28.39 L 46.74 51.87 C 46.74 55.04 49.31 57.61 52.48 57.61 C 54.06 57.61 55.49 56.97 56.53 55.93 C 57.57 54.9 58.22 53.47 58.22 51.88 L 58.22 28.39 C 58.22 12.71 45.51 0 29.83 0 Z";
                            }

                            // Open shackle replaces the closed handle so the lock visibly unlocks.
                            Path {
                                x: parent.open-shackle-x + parent.lock-offset-x;
                                y: parent.open-shackle-y;
                                width: 18px;
                                height: 16px;
                                opacity: parent.open-shackle-opacity;
                                stroke: #00FF88;
                                stroke-width: 3px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: "M 8 13 L 8 8 C 8 5.2 10.2 3 13 3 C 15.8 3 18 5.2 18 8";
                            }

                            Rectangle {
                                x: 2px + parent.lock-offset-x;
                                y: 8px;
                                width: 20px;
                                height: 13px;
                                background: #00FF88;
                                border-radius: 3px;
                            }

                            Rectangle {
                                x: (parent.width - self.width) / 2 + parent.lock-offset-x;
                                y: 12px;
                                width: parent.keyhole-width;
                                height: 7px;
                                background: white;
                                border-radius: self.width / 2;
                            }
                        }

                        if root.active-alert-type == "keys": Rectangle {
                            width: 20px;
                            height: 14px;
                            y: 4px;
                            border-width: 2px;
                            border-color: (root.active-alert-event == "locked") ? #00FF88 : white;
                            border-radius: 2px;
                            Rectangle { x: 4px; y: 4px; width: 2px; height: 2px; background: (root.active-alert-event == "locked") ? #00FF88 : white; }
                            Rectangle { x: 9px; y: 4px; width: 2px; height: 2px; background: (root.active-alert-event == "locked") ? #00FF88 : white; }
                            Rectangle { x: 14px; y: 4px; width: 2px; height: 2px; background: (root.active-alert-event == "locked") ? #00FF88 : white; }
                            Rectangle { x: 6px; y: 8px; width: 8px; height: 2px; background: (root.active-alert-event == "locked") ? #00FF88 : white; }
                        }
                    }
                    }
                }
            }
        }

        Rectangle {
            visible: root.panel-ready;
            width: 100%;
            height: 100%;

            // Background TouchArea for global right-clicks
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.close-transient-panels();
                }
                pointer-event(evt) => {
                    if evt.button == PointerEventButton.right && evt.kind == PointerEventKind.down {
                        root.menu-x = self.mouse-x;
                        root.menu-y = self.mouse-y;
                        root.show-global-menu = true;
                        root.show-caffeine-menu = false;
                    }
                }
            }

            VerticalLayout {
                width: 100%;
                height: 100%;
                min-width: 0px;
                min-height: 0px;
                opacity: root.content-opacity;
                y: root.notch-phase == "closing-content" ? -6px : (root.content-opacity - 1.0) * 10px;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 12px;
                spacing: 0px;

                // 1. Navigation Tab Bar Header
                HorizontalLayout {
                    height: 28px;
                    alignment: space-between;

                    // Left: Tabs Navigation
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;

                        // Home tab
                        if root.tab-home: TouchArea {
                            width: 24px;
                            height: 24px;
                            mouse-cursor: pointer;
                            clicked => { root.switch-tab("home"); }
                            Image {
                                width: parent.has-hover ? 20px : 18px;
                                height: parent.has-hover ? 20px : 18px;
                                source: @image-url("assets/house.svg");
                                colorize: white;
                                opacity: root.active-tab == "home" ? 1.0 : (parent.has-hover ? 0.8 : 0.45);
                                animate width, height { duration: 150ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                                animate opacity { duration: 150ms; }
                            }
                        }

                        // Media tab
                        if root.tab-media: TouchArea {
                            width: 24px;
                            height: 24px;
                            mouse-cursor: pointer;
                            clicked => { root.switch-tab("media"); }
                            Image {
                                width: parent.has-hover ? 20px : 18px;
                                height: parent.has-hover ? 20px : 18px;
                                source: @image-url("assets/waveform.svg");
                                colorize: white;
                                opacity: root.active-tab == "media" ? 1.0 : (parent.has-hover ? 0.8 : 0.45);
                                animate width, height { duration: 150ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                                animate opacity { duration: 150ms; }
                            }
                        }

                        // Clock tab
                        if root.tab-clock: TouchArea {
                            width: 24px;
                            height: 24px;
                            mouse-cursor: pointer;
                            clicked => { root.switch-tab("clock"); }
                            Image {
                                width: parent.has-hover ? 20px : 18px;
                                height: parent.has-hover ? 20px : 18px;
                                source: @image-url("assets/clock-afternoon.svg");
                                colorize: white;
                                opacity: root.active-tab == "clock" ? 1.0 : (parent.has-hover ? 0.8 : 0.45);
                                animate width, height { duration: 150ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                                animate opacity { duration: 150ms; }
                            }
                        }

                        // Drop Shelf tab
                        if root.tab-drop: TouchArea {
                            width: 24px;
                            height: 24px;
                            mouse-cursor: pointer;
                            clicked => { root.switch-tab("drop"); }
                            Image {
                                width: parent.has-hover ? 20px : 18px;
                                height: parent.has-hover ? 20px : 18px;
                                source: @image-url("assets/inbox-topbar.png");
                                colorize: white;
                                opacity: root.active-tab == "drop" ? 1.0 : (parent.has-hover ? 0.8 : 0.45);
                                animate width, height { duration: 150ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                                animate opacity { duration: 150ms; }
                            }
                        }

                        // Stats tab
                        if root.tab-stats: TouchArea {
                            width: 24px;
                            height: 24px;
                            mouse-cursor: pointer;
                            clicked => { root.switch-tab("stats"); }
                            Image {
                                width: parent.has-hover ? 20px : 18px;
                                height: parent.has-hover ? 20px : 18px;
                                source: @image-url("assets/stats.svg");
                                colorize: white;
                                opacity: root.active-tab == "stats" ? 1.0 : (parent.has-hover ? 0.8 : 0.45);
                                animate width, height { duration: 150ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                                animate opacity { duration: 150ms; }
                            }
                        }
                    }

                    // Right: Caffeine, Settings, REC & Battery
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: end;

                        // Caffeine quick button
                        if root.tab-caffeine: TouchArea {
                            width: 24px;
                            height: 24px;
                            mouse-cursor: pointer;
                            clicked => { root.toggle-caffeine(root.caffeine-keep-screen); }
                            pointer-event(evt) => {
                                if evt.button == PointerEventButton.right && evt.kind == PointerEventKind.down {
                                    root.menu-x = self.absolute-position.x - 80px;
                                    root.menu-y = self.absolute-position.y + 24px;
                                    root.show-caffeine-menu = true;
                                    root.show-global-menu = false;
                                }
                            }
                            Image {
                                width: parent.has-hover ? 20px : 18px;
                                height: parent.has-hover ? 20px : 18px;
                                source: @image-url("assets/caffeine.svg");
                                colorize: root.caffeine-enabled ? #f5c16c : white;
                                opacity: root.caffeine-enabled ? 1.0 : (parent.has-hover ? 0.8 : 0.45);
                                animate width, height { duration: 150ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                                animate opacity { duration: 150ms; }
                            }
                        }

                        // Settings cog
                        if root.tab-settings: TouchArea {
                            width: 24px;
                            height: 24px;
                            mouse-cursor: pointer;
                            clicked => { root.open-settings(); }
                            Image {
                                width: parent.has-hover ? 20px : 18px;
                                height: parent.has-hover ? 20px : 18px;
                                source: @image-url("assets/gear.svg");
                                colorize: white;
                                opacity: parent.has-hover ? 0.8 : 0.45;
                                animate width, height { duration: 150ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                                animate opacity { duration: 150ms; }
                            }
                        }

                        // Screen Recorder REC Dot
                        if root.is-recording: HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: #ff453a;
                                drop-shadow-blur: 10px;
                                drop-shadow-color: rgba(255, 69, 58, 0.82);
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: "REC";
                                font-size: 10px;
                                font-weight: 950;
                                color: #ff453a;
                                vertical-alignment: center;
                            }
                        }

                        // Battery percentage status
                        if root.battery-pct >= 0 && root.tab-battery: HorizontalLayout {
                            spacing: 6px;
                            padding-left: 4px;
                            Text {
                                text: round(root.battery-pct) + "%";
                                font-size: 13px;
                                font-weight: 900;
                                color: white;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 28px;
                                height: 14px;
                                border-width: 1.5px;
                                border-color: rgba(255, 255, 255, 0.35);
                                border-radius: 3px;
                                y: (parent.height - self.height) / 2;
                                drop-shadow-blur: root.is-charging ? 8px : 0px;
                                drop-shadow-color: rgba(48, 209, 88, 0.22);

                                Rectangle {
                                    x: 2px;
                                    y: 2px;
                                    width: (parent.width - 4px) * root.battery-pct / 100.0;
                                    height: parent.height - 4px;
                                    background: root.battery-color;
                                    border-radius: 1px;
                                }
                                Rectangle {
                                    x: parent.width;
                                    y: 3px;
                                    width: 2px;
                                    height: 6px;
                                    background: rgba(255, 255, 255, 0.35);
                                    border-top-right-radius: 1px;
                                    border-bottom-right-radius: 1px;
                                }
                                // Lightning bolt if charging
                                if root.is-charging: Path {
                                    width: 13px;
                                    height: 13px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    fill: black;
                                    viewbox-width: 24;
                                    viewbox-height: 24;
                                    commands: "M 13 2 L 4 14 L 11 14 L 10 22 L 19 10 L 12 10 L 13 2 Z";
                                }
                            }
                        }
                    }
                }

                // Spacer between Header and Active Stage
                Rectangle { height: 8px; }

                // 2. Active Screen Display Stage
                Rectangle {
                    width: 100%;
                    height: 186px;
                    background: transparent;
                    property <length> panel-enter-x: root.panel-direction == "backward" ? -58px : 58px;
                    property <length> panel-exit-x: root.panel-direction == "backward" ? 52px : -52px;
                    property <float> panel-enter-scale: 0.982;
                    property <float> panel-exit-scale: 0.985;

                    // ── HOME PANEL ──
                    HomePanel {
                        visible: root.active-tab == "home" || root.exiting-tab == "home";
                        x: root.active-tab == "home" ? 0px : (root.exiting-tab == "home" ? parent.panel-exit-x : parent.panel-enter-x);
                        opacity: root.active-tab == "home" ? 1.0 : 0.0;
                        animate x { duration: 560ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                        animate opacity { duration: 340ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                        has-media-art: root.has-media-art;
                        album-flip-scale: root.album-flip-scale;
                        media-accent-color: root.media-accent-color;
                        media-art-url: root.media-art-url;
                        media-title: root.media-title;
                        media-artist: root.media-artist;
                        media-album: root.media-album;
                        media-pct: root.media-pct;
                        media-pos-str: root.media-pos-str;
                        media-dur-str: root.media-dur-str;
                        is-playing <=> root.is-playing;
                        show-source: root.media-show-source;
                        media-adaptive-accent: root.media-adaptive-accent;
                        media-full-calendar-on-no-media: root.media-full-calendar-on-no-media;
                        calendar-events: root.calendar-events;
                        calendar-days: root.calendar-days;
                        filtered-calendar-events: root.filtered-calendar-events;
                        selected-day-index: root.selected-day-index;
                        selected-month: root.selected-month;
                        selected-year: root.selected-year;
                        selected-day-label: root.selected-day-label;
                        google-connected: root.google-connected;
                        google-busy: root.google-busy;
                        google-message: root.google-message;
                        premium-locked: root.premium-locked;
                        tab-calendar: root.tab-calendar;
                        has-media-source-icon: root.has-media-source-icon;
                        media-source-icon-url: root.media-source-icon-url;
                        show-mini-calendar: root.show-mini-calendar;
                        picker-mode: root.picker-mode;
                        mini-calendar-view-month <=> root.mini-calendar-view-month;
                        mini-calendar-view-year <=> root.mini-calendar-view-year;
                        mini-calendar-days: root.mini-calendar-days;
                        mini-calendar-years: root.mini-calendar-years;
                        media-sessions: root.media-sessions;

                        prev => { root.prev(); }
                        play-pause => { root.play-pause(); }
                        next => { root.next(); }
                        seek-backward => { root.seek-backward(); }
                        seek-forward => { root.seek-forward(); }
                        switch-media-source(id) => { root.switch-media-source(id); }
                        google-sign-in => { root.google-sign-in(); }
                        buy-license => { root.buy-license(); }
                        select-day(idx) => { root.select-day(idx); }
                        month-year-double-clicked => { root.month-year-double-clicked(); }
                        mini-calendar-change-month-year(m, y) => { root.mini-calendar-change-month-year(m, y); }
                        mini-calendar-select-date(d, m, y) => { root.mini-calendar-select-date(d, m, y); }
                        mini-calendar-close => { root.mini-calendar-close(); }
                    }

                    // ── MEDIA PANEL (Modular anchored overlay architecture) ──
                    LeftMediaPanel {
                        x: (root.active-tab == "media" ? 0px : (root.exiting-tab == "media" ? parent.panel-exit-x : parent.panel-enter-x));
                        y: 0px;
                        width: 344px;
                        height: 186px;
                        visible: root.active-tab == "media" || root.exiting-tab == "media";
                        opacity: root.active-tab == "media" ? 1.0 : 0.0;
                        animate x { duration: 560ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                        animate opacity { duration: 340ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }

                        has-media-art: root.has-media-art;
                        media-art-url: root.media-art-url;
                        media-title: root.media-title;
                        media-artist: root.media-artist;
                        media-album: root.media-album;
                        media-pct: root.media-pct;
                        media-pos-str: root.media-pos-str;
                        media-dur-str: root.media-dur-str;
                        is-playing <=> root.is-playing;
                        media-source: root.media-source;
                        waveform-clock-ms: root.waveform-clock-ms;
                        waveform-active: root.media-waveform-active;
                        show-waveform: root.media-show-waveform;
                        media-sessions: root.media-sessions;

                        prev => { root.prev(); }
                        play-pause => { root.play-pause(); }
                        next => { root.next(); }
                        seek-backward => { root.seek-backward(); }
                        seek-forward => { root.seek-forward(); }
                        cycle-media-source(forward) => { root.cycle-media-source(forward); }
                        switch-media-source(id) => { root.switch-media-source(id); }
                    }

                    Rectangle {
                        x: 386px + (root.active-tab == "media" ? 0px : (root.exiting-tab == "media" ? parent.panel-exit-x : parent.panel-enter-x)); // mathematically centered in the 84px gap
                        y: 0px;
                        width: 1px;
                        height: 186px;
                        background: rgba(255, 255, 255, 0.08);
                        visible: root.active-tab == "media" || root.exiting-tab == "media";
                        opacity: root.active-tab == "media" ? 1.0 : 0.0;
                        animate x { duration: 560ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                        animate opacity { duration: 340ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                    }

                    RightLyricsPanel {
                        x: 428px + (root.active-tab == "media" ? 0px : (root.exiting-tab == "media" ? parent.panel-exit-x : parent.panel-enter-x));
                        y: 0px;
                        width: 260px;
                        height: 186px;
                        visible: root.active-tab == "media" || root.exiting-tab == "media";
                        opacity: root.active-tab == "media" ? 1.0 : 0.0;
                        animate x { duration: 560ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                        animate opacity { duration: 340ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                        lyrics-lines: root.lyrics-lines;
                        active-lyric-index: root.active-lyric-index;
                        has-lyrics: root.has-lyrics;
                        lyrics-status: root.lyrics-status;
                        premium-locked: root.premium-locked;
                        buy-license => { root.buy-license(); }
                    }

                    // ── CLOCK PANEL (Modular anchored overlay architecture) ──
                    MinimalClockPanel {
                        x: (root.active-tab == "clock" ? 0px : (root.exiting-tab == "clock" ? parent.panel-exit-x : parent.panel-enter-x));
                        y: 12px;
                        width: 344px;
                        height: 154px;
                        visible: root.active-tab == "clock" || root.exiting-tab == "clock";
                        opacity: root.active-tab == "clock" ? 1.0 : 0.0;
                        animate x { duration: 560ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                        animate opacity { duration: 340ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }

                        timer-remaining-str: root.timer-remaining-str;
                        timer-running: root.timer-running;
                        stopwatch-str: root.stopwatch-display-str;
                        stopwatch-running: root.stopwatch-running;

                        current-hour: root.current-hour;
                        current-minute: root.current-minute;
                        current-second: root.current-second;
                        current-ampm: root.current-ampm;
                        current-time-str: root.current-time-str;
                        current-second-str: root.current-second-str;

                        show-timer-input-panel <=> root.show-timer-input-panel;
                        input-h <=> root.input-h;
                        input-m <=> root.input-m;
                        input-s <=> root.input-s;

                        timer-toggle => { root.timer-toggle(); }
                        timer-reset => { root.timer-reset(); }
                        stopwatch-toggle => { root.stopwatch-toggle(); }
                        stopwatch-reset => { root.stopwatch-reset(); }
                        timer-text-clicked => { root.timer-text-clicked(); }
                        set-timer-from-input => { root.set-timer-from-input(); }
                        close-timer-input-panel => { root.close-timer-input-panel(); }
                    }

                    Rectangle {
                        x: 386px + (root.active-tab == "clock" ? 0px : (root.exiting-tab == "clock" ? parent.panel-exit-x : parent.panel-enter-x)); // mathematically centered in the 84px gap
                        y: 12px;
                        width: 1px;
                        height: 154px;
                        background: rgba(255, 255, 255, 0.08);
                        visible: root.active-tab == "clock" || root.exiting-tab == "clock";
                        opacity: root.active-tab == "clock" ? 1.0 : 0.0;
                        animate x { duration: 560ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                        animate opacity { duration: 340ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                    }

                    WorldClockPanel {
                        x: 428px + (root.active-tab == "clock" ? 0px : (root.exiting-tab == "clock" ? parent.panel-exit-x : parent.panel-enter-x)); // 344px left + 84px flexible spacer
                        y: 12px;
                        width: 260px;
                        height: 154px;
                        visible: (root.active-tab == "clock" || root.exiting-tab == "clock") && !root.show-focus-panel;
                        opacity: root.active-tab == "clock" && !root.show-focus-panel ? 1.0 : 0.0;
                        animate x { duration: 560ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                        animate opacity { duration: 340ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }

                        current-second: root.current-second;

                        ny-time-str: root.ny-time-str;
                        ny-ampm-str: root.ny-ampm-str;
                        ny-date-str: root.ny-date-str;
                        ny-hand-hour: root.ny-hand-hour;
                        ny-hand-min: root.ny-hand-min;
                        ny-offset-str: root.ny-offset-str;

                        ldn-time-str: root.ldn-time-str;
                        ldn-ampm-str: root.ldn-ampm-str;
                        ldn-date-str: root.ldn-date-str;
                        ldn-hand-hour: root.ldn-hand-hour;
                        ldn-hand-min: root.ldn-hand-min;
                        ldn-offset-str: root.ldn-offset-str;

                        tky-time-str: root.tky-time-str;
                        tky-ampm-str: root.tky-ampm-str;
                        tky-date-str: root.tky-date-str;
                        tky-hand-hour: root.tky-hand-hour;
                        tky-hand-min: root.tky-hand-min;
                        tky-offset-str: root.tky-offset-str;

                        del-time-str: root.del-time-str;
                        del-ampm-str: root.del-ampm-str;
                        del-date-str: root.del-date-str;
                        del-hand-hour: root.del-hand-hour;
                        del-hand-min: root.del-hand-min;
                        del-offset-str: root.del-offset-str;

                        syd-time-str: root.syd-time-str;
                        syd-ampm-str: root.syd-ampm-str;
                        syd-date-str: root.syd-date-str;
                        syd-hand-hour: root.syd-hand-hour;
                        syd-hand-min: root.syd-hand-min;
                        syd-offset-str: root.syd-offset-str;

                        par-time-str: root.par-time-str;
                        par-ampm-str: root.par-ampm-str;
                        par-date-str: root.par-date-str;
                        par-hand-hour: root.par-hand-hour;
                        par-hand-min: root.par-hand-min;
                        par-offset-str: root.par-offset-str;

                        dxb-time-str: root.dxb-time-str;
                        dxb-ampm-str: root.dxb-ampm-str;
                        dxb-date-str: root.dxb-date-str;
                        dxb-hand-hour: root.dxb-hand-hour;
                        dxb-hand-min: root.dxb-hand-min;
                        dxb-offset-str: root.dxb-offset-str;

                        sin-time-str: root.sin-time-str;
                        sin-ampm-str: root.sin-ampm-str;
                        sin-date-str: root.sin-date-str;
                        sin-hand-hour: root.sin-hand-hour;
                        sin-hand-min: root.sin-hand-min;
                        sin-offset-str: root.sin-offset-str;

                        show-ny: root.show-ny;
                        show-ldn: root.show-ldn;
                        show-tky: root.show-tky;
                        show-del: root.show-del;
                        show-syd: root.show-syd;
                        show-par: root.show-par;
                        show-dxb: root.show-dxb;
                        show-sin: root.show-sin;

                        row-right-clicked(city, x, y) => {
                            root.menu-x = x;
                            root.menu-y = y;
                            root.selected-clock-row = city;
                            root.show-clock-row-menu = true;
                            root.show-global-menu = false;
                            root.show-caffeine-menu = false;
                            root.show-timer-menu = false;
                            root.show-clock-add-menu = false;
                            root.show-media-source-menu = false;
                            root.show-drop-action-menu = false;
                        }
                        add-clicked(x, y) => {
                            root.menu-x = x;
                            root.menu-y = y;
                            root.show-clock-add-menu = true;
                            root.show-global-menu = false;
                            root.show-caffeine-menu = false;
                            root.show-timer-menu = false;
                            root.show-clock-row-menu = false;
                            root.show-media-source-menu = false;
                            root.show-drop-action-menu = false;
                        }
                        focus-clicked => {
                            root.show-focus-panel = true;
                        }
                    }

                    FocusSessionPanel {
                        x: 428px + (root.active-tab == "clock" ? 0px : (root.exiting-tab == "clock" ? parent.panel-exit-x : parent.panel-enter-x));
                        y: 12px;
                        width: 260px;
                        height: 154px;
                        visible: (root.active-tab == "clock" || root.exiting-tab == "clock") && root.show-focus-panel;
                        opacity: root.active-tab == "clock" && root.show-focus-panel ? 1.0 : 0.0;
                        animate x { duration: 560ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                        animate opacity { duration: 340ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }

                        focus-state <=> root.focus-session-state;
                        focus-goal <=> root.focus-session-goal;
                        focus-duration-str <=> root.focus-session-duration-str;
                        focus-running: root.focus-session-running;
                        focus-paused: root.focus-session-paused;
                        focus-bar-hidden: root.focus-bar-hidden;
                        focus-remaining-str: root.focus-session-remaining-str;
                        focus-progress: root.focus-session-progress;
                        focus-history: root.focus-session-history;
                        focus-goal-presets: root.focus-goal-presets;
                        premium-locked: root.premium-locked;
                        close-popups-trigger: root.close-popups-trigger;

                        back-clicked => {
                            if root.focus-session-state == "history" {
                                root.focus-session-state = "setup";
                            } else {
                                root.show-focus-panel = false;
                            }
                        }
                        save-goal-preset(goal) => { root.save_focus_goal_preset(goal); }
                        start-session(goal, duration_str) => { root.focus-session-start(goal, duration_str); }
                        stop-session => { root.focus-session-stop(); }
                        toggle-pause => { root.focus-session-toggle-pause(); }
                        toggle-bar-visibility => { root.focus-session-toggle-bar-visibility(); }
                        clear-history => { root.clear-focus-history(); }
                        validate-duration-input(val) => { return root.validate-duration-input(val); }
                        format-numeric-duration(val) => { return root.format-numeric-duration(val); }
                        duration-dropdown-changed(open) => { root.focus-duration-dropdown-changed(open); }
                        buy-license => { root.buy-license(); }
                    }

                    // ── DROP SHELF PANEL ──
                    DropPanel {
                        visible: root.active-tab == "drop" || root.exiting-tab == "drop";
                        x: root.active-tab == "drop" ? 0px : (root.exiting-tab == "drop" ? parent.panel-exit-x : parent.panel-enter-x);
                        opacity: root.active-tab == "drop" ? 1.0 : 0.0;
                        animate x { duration: 560ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                        animate opacity { duration: 340ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                        items: root.shelf-items;
                        share-provider-name: root.share-provider-name;
                        share-provider-id: root.share-provider-id;
                        share-notice: root.share-notice-message;
                        share-notice-state: root.share-notice-state;
                        share-active: root.share-active;
                        keep-active: root.keep-active;

                        item-open(p) => { root.shelf-open-file(p); }
                        item-reveal(p) => { root.shelf-reveal-file(p); }
                        item-copy(p) => { root.shelf-copy-path(p); }
                        item-remove(id) => { root.shelf-remove-item(id); }
                        clear-shelf() => { root.shelf-clear-items(); }
                        share-file(p, prov) => { root.shelf-share-file(p, prov); }
                        select-next-provider() => { root.shelf-select-next-provider(); }
                        shelf-right-clicked(x, y) => {
                            root.menu-x = x;
                            root.menu-y = y;
                            root.selected-drop-item-idx = -1;
                            root.show-drop-action-menu = true;
                            root.show-global-menu = false;
                            root.show-caffeine-menu = false;
                            root.show-timer-menu = false;
                            root.show-clock-add-menu = false;
                            root.show-clock-row-menu = false;
                            root.show-media-source-menu = false;
                        }
                        card-right-clicked(idx, id, path, x, y) => {
                            root.menu-x = 184px + idx * 148px + x;
                            root.menu-y = 32px + y;
                            root.selected-drop-item-id = id;
                            root.selected-drop-item-path = path;
                            root.selected-drop-item-idx = idx;
                            root.show-drop-action-menu = true;
                            root.show-global-menu = false;
                            root.show-caffeine-menu = false;
                            root.show-timer-menu = false;
                            root.show-clock-add-menu = false;
                            root.show-clock-row-menu = false;
                            root.show-media-source-menu = false;
                        }
                    }


                    // ── SYSTEM STATS PANEL ──
                    StatsPanel {
                        visible: root.active-tab == "stats" || root.exiting-tab == "stats";
                        x: root.active-tab == "stats" ? 0px : (root.exiting-tab == "stats" ? parent.panel-exit-x : parent.panel-enter-x);
                        opacity: root.active-tab == "stats" ? 1.0 : 0.0;
                        animate x { duration: 560ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                        animate opacity { duration: 340ms; easing: cubic-bezier(0.16, 1.0, 0.3, 1.0); }
                        cpu-pct: root.cpu-pct;
                        ram-pct: root.ram-pct;
                        gpu-pct: root.gpu-pct;
                        cpu-path-data: root.cpu-path-data;
                        cpu-fill-data: root.cpu-fill-data;
                        ram-path-data: root.ram-path-data;
                        ram-fill-data: root.ram-fill-data;
                        gpu-path-data: root.gpu-path-data;
                        gpu-fill-data: root.gpu-fill-data;
                    }
                }
            }

            // Transparent dismiss overlay when clicking outside
            if (root.show-global-menu || root.show-raven-menu || root.show-caffeine-menu || root.show-timer-menu || root.show-clock-add-menu || root.show-clock-row-menu || root.show-media-source-menu || root.show-drop-action-menu): TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.close-transient-panels();
                }
            }

            // Global Context Menu Overlay
            // ── OLD GLOBAL MENU (right-click anywhere) ──
            if root.show-global-menu: Rectangle {
                x: Math.max(8px, Math.min(root.menu-x, parent.width - 158px));
                y: Math.max(8px, Math.min(root.menu-y, parent.height - 110px));
                width: 150px;
                height: 102px;
                background: root.topbar-panel-surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: root.topbar-panel-border;
                drop-shadow-blur: 30px;
                drop-shadow-color: root.topbar-panel-shadow;

                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;

                    TouchArea {
                        height: 30px;
                        clicked => {
                            root.show-global-menu = false;
                            root.toggle-freeze();
                        }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text {
                                text: root.hover-enabled ? "Freeze Notch" : "Unfreeze Notch";
                                font-size: 11px;
                                font-weight: 700;
                                color: white;
                                x: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    TouchArea {
                        height: 30px;
                        clicked => {
                            root.show-global-menu = false;
                            root.open-settings();
                        }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text {
                                text: "Settings";
                                font-size: 11px;
                                font-weight: 700;
                                color: white;
                                x: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    TouchArea {
                        height: 30px;
                        clicked => {
                            root.show-global-menu = false;
                            root.request-notch-close();
                        }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text {
                                text: "Close Notch";
                                font-size: 11px;
                                font-weight: 700;
                                color: #FF453A;
                                x: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }


            // Caffeine Context Menu Overlay
            if root.show-caffeine-menu: Rectangle {
                x: Math.max(8px, Math.min(root.menu-x, parent.width - 188px));
                y: Math.max(8px, Math.min(root.menu-y, parent.height - 200px));
                width: 180px;
                height: 196px;
                background: root.topbar-panel-surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: root.topbar-panel-border;
                drop-shadow-blur: 30px;
                drop-shadow-color: root.topbar-panel-shadow;

                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;

                    TouchArea {
                        height: 28px;
                        clicked => {
                            root.show-caffeine-menu = false;
                            root.toggle-caffeine(root.caffeine-keep-screen);
                        }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text {
                                text: root.caffeine-enabled ? "Turn Off" : "Keep Awake";
                                font-size: 11px;
                                font-weight: 700;
                                color: root.caffeine-enabled ? #f5c16c : white;
                                x: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    TouchArea {
                        height: 26px;
                        clicked => {
                            root.show-caffeine-menu = false;
                            root.set-caffeine-duration(15, root.caffeine-keep-screen);
                        }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text {
                                text: "15 minutes";
                                font-size: 11px;
                                font-weight: 600;
                                color: white;
                                x: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    TouchArea {
                        height: 26px;
                        clicked => {
                            root.show-caffeine-menu = false;
                            root.set-caffeine-duration(30, root.caffeine-keep-screen);
                        }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text {
                                text: "30 minutes";
                                font-size: 11px;
                                font-weight: 600;
                                color: white;
                                x: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    TouchArea {
                        height: 26px;
                        clicked => {
                            root.show-caffeine-menu = false;
                            root.set-caffeine-duration(60, root.caffeine-keep-screen);
                        }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text {
                                text: "1 hour";
                                font-size: 11px;
                                font-weight: 600;
                                color: white;
                                x: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    TouchArea {
                        height: 26px;
                        clicked => {
                            root.show-caffeine-menu = false;
                            root.set-caffeine-duration(120, root.caffeine-keep-screen);
                        }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text {
                                text: "2 hours";
                                font-size: 11px;
                                font-weight: 600;
                                color: white;
                                x: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.08);
                    }

                    TouchArea {
                        height: 28px;
                        clicked => {
                            root.caffeine-keep-screen = !root.caffeine-keep-screen;
                            root.toggle-caffeine-screen-setting(root.caffeine-keep-screen);
                        }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                alignment: space-between;
                                
                                Text {
                                    text: "Keep Screen Awake Too";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: white;
                                    vertical-alignment: center;
                                }
                                
                                Rectangle {
                                    width: 12px;
                                    height: 12px;
                                    border-radius: 2px;
                                    background: root.caffeine-keep-screen ? #f5c16c : transparent;
                                    border-width: 1px;
                                    border-color: root.caffeine-keep-screen ? #f5c16c : rgba(255, 255, 255, 0.3);
                                    y: (parent.height - self.height) / 2;
                                    
                                    if root.caffeine-keep-screen: Text {
                                        text: "✓";
                                        font-size: 9px;
                                        font-weight: 900;
                                        color: black;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }



            // World Clock Add Menu Overlay
            if root.show-clock-add-menu: Rectangle {
                x: Math.max(8px, Math.min(root.menu-x, parent.width - 158px));
                y: Math.max(8px, Math.min(root.menu-y, parent.height - 120px));
                width: 150px;
                height: (!root.show-ny ? 28px : 0px) + 
                        (!root.show-ldn ? 28px : 0px) + 
                        (!root.show-tky ? 28px : 0px) + 
                        (!root.show-del ? 28px : 0px) + 
                        (!root.show-syd ? 28px : 0px) + 
                        (!root.show-par ? 28px : 0px) + 
                        (!root.show-dxb ? 28px : 0px) + 
                        (!root.show-sin ? 28px : 0px) + 
                        ((root.show-ny && root.show-ldn && root.show-tky && root.show-del && root.show-syd && root.show-par && root.show-dxb && root.show-sin) ? 38px : 12px);
                background: root.topbar-panel-surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: root.topbar-panel-border;
                drop-shadow-blur: 30px;
                drop-shadow-color: root.topbar-panel-shadow;

                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;

                    if root.show-ny && root.show-ldn && root.show-tky && root.show-del && root.show-syd && root.show-par && root.show-dxb && root.show-sin: Rectangle {
                        height: 26px;
                        Text { text: "All clocks active"; font-size: 11px; color: rgba(255,255,255,0.4); x: 12px; vertical-alignment: center; }
                    }

                    if !root.show-ny: TouchArea {
                        height: 26px;
                        clicked => {
                            root.show-clock-add-menu = false;
                            root.show-ny = true;
                        }
                        Rectangle {
                            width: 100%; height: 100%; border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text { text: "Add New York"; font-size: 11px; font-weight: 600; color: white; x: 12px; vertical-alignment: center; }
                        }
                    }

                    if !root.show-ldn: TouchArea {
                        height: 26px;
                        clicked => {
                            root.show-clock-add-menu = false;
                            root.show-ldn = true;
                        }
                        Rectangle {
                            width: 100%; height: 100%; border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text { text: "Add London"; font-size: 11px; font-weight: 600; color: white; x: 12px; vertical-alignment: center; }
                        }
                    }

                    if !root.show-tky: TouchArea {
                        height: 26px;
                        clicked => {
                            root.show-clock-add-menu = false;
                            root.show-tky = true;
                        }
                        Rectangle {
                            width: 100%; height: 100%; border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text { text: "Add Tokyo"; font-size: 11px; font-weight: 600; color: white; x: 12px; vertical-alignment: center; }
                        }
                    }

                    if !root.show-del: TouchArea {
                        height: 26px;
                        clicked => {
                            root.show-clock-add-menu = false;
                            root.show-del = true;
                        }
                        Rectangle {
                            width: 100%; height: 100%; border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text { text: "Add New Delhi"; font-size: 11px; font-weight: 600; color: white; x: 12px; vertical-alignment: center; }
                        }
                    }

                    if !root.show-syd: TouchArea {
                        height: 26px;
                        clicked => {
                            root.show-clock-add-menu = false;
                            root.show-syd = true;
                        }
                        Rectangle {
                            width: 100%; height: 100%; border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text { text: "Add Sydney"; font-size: 11px; font-weight: 600; color: white; x: 12px; vertical-alignment: center; }
                        }
                    }

                    if !root.show-par: TouchArea {
                        height: 26px;
                        clicked => {
                            root.show-clock-add-menu = false;
                            root.show-par = true;
                        }
                        Rectangle {
                            width: 100%; height: 100%; border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text { text: "Add Paris"; font-size: 11px; font-weight: 600; color: white; x: 12px; vertical-alignment: center; }
                        }
                    }

                    if !root.show-dxb: TouchArea {
                        height: 26px;
                        clicked => {
                            root.show-clock-add-menu = false;
                            root.show-dxb = true;
                        }
                        Rectangle {
                            width: 100%; height: 100%; border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text { text: "Add Dubai"; font-size: 11px; font-weight: 600; color: white; x: 12px; vertical-alignment: center; }
                        }
                    }

                    if !root.show-sin: TouchArea {
                        height: 26px;
                        clicked => {
                            root.show-clock-add-menu = false;
                            root.show-sin = true;
                        }
                        Rectangle {
                            width: 100%; height: 100%; border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text { text: "Add Singapore"; font-size: 11px; font-weight: 600; color: white; x: 12px; vertical-alignment: center; }
                        }
                    }
                }
            }

            // World Clock Row Menu Overlay (Remove Clock)
            if root.show-clock-row-menu: Rectangle {
                x: Math.max(8px, Math.min(root.menu-x, parent.width - 158px));
                y: Math.max(8px, Math.min(root.menu-y, parent.height - 48px));
                width: 150px;
                height: 38px;
                background: rgba(18, 18, 18, 0.98);
                border-radius: 8px;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.08);
                drop-shadow-blur: 16px;
                drop-shadow-color: rgba(0, 0, 0, 0.5);

                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;

                    TouchArea {
                        height: 28px;
                        clicked => {
                            root.show-clock-row-menu = false;
                            if root.selected-clock-row == "NY" { root.show-ny = false; }
                            if root.selected-clock-row == "LDN" { root.show-ldn = false; }
                            if root.selected-clock-row == "TKY" { root.show-tky = false; }
                            if root.selected-clock-row == "DEL" { root.show-del = false; }
                            if root.selected-clock-row == "SYD" { root.show-syd = false; }
                            if root.selected-clock-row == "PAR" { root.show-par = false; }
                            if root.selected-clock-row == "DXB" { root.show-dxb = false; }
                            if root.selected-clock-row == "SIN" { root.show-sin = false; }
                        }
                        Rectangle {
                            width: 100%; height: 100%; border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text {
                                text: "Remove timezone";
                                font-size: 11px;
                                font-weight: 700;
                                color: #FF453A;
                                x: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }



            // Drop Action Menu Overlay (File Card Actions & Clear Shelf)
            if root.show-drop-action-menu: Rectangle {
                x: Math.max(8px, Math.min(root.menu-x, parent.width - 158px));
                y: Math.max(8px, Math.min(root.menu-y, parent.height - (root.selected-drop-item-idx >= 0 ? 140px : 48px)));
                width: 150px;
                height: root.selected-drop-item-idx >= 0 ? 132px : 38px;
                background: rgba(18, 18, 18, 0.98);
                border-radius: 8px;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.08);
                drop-shadow-blur: 16px;
                drop-shadow-color: rgba(0, 0, 0, 0.5);

                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;

                    if root.selected-drop-item-idx < 0: TouchArea {
                        height: 28px;
                        clicked => {
                            root.show-drop-action-menu = false;
                            root.shelf-clear-items();
                        }
                        Rectangle {
                            width: 100%; height: 100%; border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text {
                                text: "Clear Shelf";
                                font-size: 11px;
                                font-weight: 700;
                                color: #FF453A;
                                x: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.selected-drop-item-idx >= 0: TouchArea {
                        height: 24px;
                        clicked => {
                            root.show-drop-action-menu = false;
                            root.shelf-open-file(root.selected-drop-item-path);
                        }
                        Rectangle {
                            width: 100%; height: 100%; border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text { text: "Open File"; font-size: 11px; font-weight: 600; color: white; x: 12px; vertical-alignment: center; }
                        }
                    }

                    if root.selected-drop-item-idx >= 0: TouchArea {
                        height: 24px;
                        clicked => {
                            root.show-drop-action-menu = false;
                            root.shelf-reveal-file(root.selected-drop-item-path);
                        }
                        Rectangle {
                            width: 100%; height: 100%; border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text { text: "Reveal in Explorer"; font-size: 11px; font-weight: 600; color: white; x: 12px; vertical-alignment: center; }
                        }
                    }

                    if root.selected-drop-item-idx >= 0: TouchArea {
                        height: 24px;
                        clicked => {
                            root.show-drop-action-menu = false;
                            root.shelf-copy-path(root.selected-drop-item-path);
                        }
                        Rectangle {
                            width: 100%; height: 100%; border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text { text: "Copy Path"; font-size: 11px; font-weight: 600; color: white; x: 12px; vertical-alignment: center; }
                        }
                    }

                    if root.selected-drop-item-idx >= 0: TouchArea {
                        height: 24px;
                        clicked => {
                            root.show-drop-action-menu = false;
                            root.shelf-remove-item(root.selected-drop-item-id);
                        }
                        Rectangle {
                            width: 100%; height: 100%; border-radius: 4px;
                            background: parent.has-hover ? rgba(255, 255, 255, 0.06) : transparent;
                            Text { text: "Remove from Shelf"; font-size: 11px; font-weight: 700; color: #FF453A; x: 12px; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }

    if root.system-hud-kind != "" : Rectangle {
        x: inner-rect.x;
        y: inner-rect.y;
        width: inner-rect.width;
        height: inner-rect.height;
        border-top-left-radius: inner-rect.border-top-left-radius;
        border-top-right-radius: inner-rect.border-top-right-radius;
        border-bottom-left-radius: inner-rect.border-bottom-left-radius;
        border-bottom-right-radius: inner-rect.border-bottom-right-radius;
        background: root.notch-bg-color;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.10);
        opacity: inner-rect.opacity;
        clip: true;

        if root.system-hud-kind == "volume" || root.system-hud-kind == "brightness" : Rectangle {
            x: 30px;
            y: 28px;
            width: parent.width - 60px;
            height: parent.height - 56px;
            background: transparent;

            Rectangle {
                x: 0px;
                y: 10px;
                width: 88px;
                height: 88px;
                border-radius: 44px;
                background: rgba(255, 255, 255, 0.07);
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.11);

                if root.system-hud-kind == "volume" : Path {
                    x: 22px;
                    y: 24px;
                    width: 44px;
                    height: 40px;
                    viewbox-width: 44;
                    viewbox-height: 40;
                    stroke: white;
                    stroke-width: 4px;
                    fill: transparent;
                    commands: root.system-hud-muted ? "M 5 16 L 15 16 L 29 5 L 29 35 L 15 24 L 5 24 Z M 35 14 L 43 26 M 43 14 L 35 26" : "M 5 16 L 15 16 L 29 5 L 29 35 L 15 24 L 5 24 Z M 34 12 Q 42 20 34 28";
                }

                if root.system-hud-kind == "brightness" : Path {
                    x: 20px;
                    y: 20px;
                    width: 48px;
                    height: 48px;
                    viewbox-width: 48;
                    viewbox-height: 48;
                    stroke: white;
                    stroke-width: 4px;
                    fill: transparent;
                    commands: "M 24 15 A 9 9 0 1 1 23.9 15 M 24 1 L 24 9 M 24 39 L 24 47 M 1 24 L 9 24 M 39 24 L 47 24 M 7 7 L 13 13 M 35 35 L 41 41 M 41 7 L 35 13 M 13 35 L 7 41";
                }
            }

            VerticalLayout {
                x: 118px;
                y: 8px;
                width: parent.width - 118px;
                height: 100px;
                spacing: 8px;

                Text {
                    text: root.system-hud-kind == "volume" ? (root.system-hud-muted ? "MUTED" : "VOLUME") : "BRIGHTNESS";
                    color: rgba(255, 255, 255, 0.62);
                    font-size: 12px;
                    font-weight: 800;
                    letter-spacing: 0px;
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Text {
                        text: root.system-hud-value + "%";
                        color: white;
                        font-size: 52px;
                        font-weight: 900;
                        letter-spacing: 0px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.system-hud-kind == "volume" ? "sound" : "display";
                        color: rgba(255, 255, 255, 0.45);
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                x: 0px;
                y: parent.height - 42px;
                width: parent.width;
                height: 30px;
                spacing: 4px;
                alignment: center;

                for segment in root.system-hud-segments : Rectangle {
                    width: 8px;
                    height: 28px;
                    border-radius: 4px;
                    background: segment < round(root.system-hud-value / 100.0 * 24.0) ? white : rgba(255, 255, 255, 0.20);
                }
            }
        }

        if root.system-hud-kind == "charger_in" || root.system-hud-kind == "charger_out" || root.system-hud-kind == "low_battery" : Rectangle {
            x: 34px;
            y: 28px;
            width: parent.width - 68px;
            height: parent.height - 56px;
            background: transparent;

            Rectangle {
                x: 8px;
                y: 21px;
                width: 76px;
                height: 76px;
                border-radius: 38px;
                background: root.system-hud-kind == "charger_in" ? rgba(40, 255, 92, 0.10) : rgba(255, 56, 62, 0.10);
                border-width: 2px;
                border-color: root.system-hud-kind == "charger_in" ? #35f25d : (root.system-hud-kind == "charger_out" ? rgba(235, 235, 235, 0.78) : #ff3840);

                Rectangle {
                    x: 5px;
                    y: 5px;
                    width: 66px;
                    height: 66px;
                    border-radius: 33px;
                    background: root.system-hud-kind == "charger_in" ? rgba(40, 255, 92, 0.06) : rgba(255, 56, 62, 0.06);
                    border-width: 1px;
                    border-color: root.system-hud-kind == "charger_in" ? rgba(53, 242, 93, 0.35) : rgba(255, 56, 64, 0.34);
                }

                if root.system-hud-kind == "charger_in" || root.system-hud-kind == "low_battery" : Path {
                    x: 27px;
                    y: 18px;
                    width: 28px;
                    height: 40px;
                    viewbox-width: 28;
                    viewbox-height: 40;
                    fill: root.system-hud-kind == "charger_in" ? #35f25d : #ff3840;
                    commands: "M 17 0 L 2 22 L 13 22 L 9 40 L 26 16 L 15 16 Z";
                }

                if root.system-hud-kind == "charger_out" : Path {
                    x: 20px;
                    y: 18px;
                    width: 38px;
                    height: 40px;
                    viewbox-width: 38;
                    viewbox-height: 40;
                    stroke: rgba(235, 235, 235, 0.82);
                    stroke-width: 4px;
                    fill: transparent;
                    commands: "M 15 6 L 15 20 M 23 6 L 23 20 M 11 20 L 27 20 L 27 28 Q 27 35 20 35 L 18 35 Q 11 35 11 28 Z M 4 3 L 34 37";
                }
            }

            VerticalLayout {
                x: 105px;
                y: 10px;
                width: 330px;
                height: 110px;
                spacing: 2px;

                Text {
                    text: root.system-hud-kind == "charger_in" ? "Charging" : (root.system-hud-kind == "charger_out" ? "Charger Disconnected" : "Battery Low");
                    color: white;
                    font-size: 26px;
                    font-weight: 850;
                    letter-spacing: 0px;
                }

                Text {
                    text: root.system-hud-value + "%";
                    color: root.system-hud-kind == "charger_in" ? #35f25d : #ff3840;
                    font-size: 58px;
                    font-weight: 900;
                    letter-spacing: 0px;
                }

                Text {
                    text: root.system-hud-kind == "charger_in" ? "Power adapter connected" : (root.system-hud-kind == "charger_out" ? "Not charging" : "Consider charging soon");
                    color: rgba(255, 255, 255, 0.62);
                    font-size: 19px;
                    font-weight: 650;
                    letter-spacing: 0px;
                }
            }

            Rectangle {
                x: parent.width - 196px;
                y: 24px;
                width: 154px;
                height: 78px;
                border-radius: 14px;
                background: root.system-hud-kind == "charger_in" ? rgba(30, 255, 79, 0.08) : rgba(255, 56, 62, 0.08);
                border-width: 3px;
                border-color: root.system-hud-kind == "charger_in" ? #35f25d : #ff3840;

                Rectangle {
                    x: parent.width;
                    y: 22px;
                    width: 13px;
                    height: 34px;
                    border-top-right-radius: 7px;
                    border-bottom-right-radius: 7px;
                    background: root.system-hud-kind == "charger_in" ? #35f25d : #ff3840;
                }

                Rectangle {
                    x: 8px;
                    y: 8px;
                    width: Math.max(18px, (parent.width - 16px) * root.system-hud-value / 100.0);
                    height: parent.height - 16px;
                    border-radius: 7px;
                    background: root.system-hud-kind == "charger_in" ? #35f25d : #ff3840;
                }

                Rectangle {
                    x: 12px;
                    y: 10px;
                    width: parent.width - 24px;
                    height: 1px;
                    background: rgba(255, 255, 255, 0.30);
                }
            }
        }
    }
    // Inverse curve left fill (covers the left vertical border)
    if root.appearance-shape == "curved": Path {
        x: inner-rect.x - 11px;
        y: inner-rect.y + 1px;
        opacity: inner-rect.opacity;
        width: 12px;
        height: 12px;
        fill: root.notch-bg-color;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 12 0 L 12 12 Q 12 0 0 0 Z";
    }
    
    // Inverse curve left stroke
    if root.appearance-shape == "curved": Path {
        x: inner-rect.x - 11px;
        y: inner-rect.y + 1px;
        opacity: inner-rect.opacity;
        width: 12px;
        height: 12px;
        stroke: rgba(255, 255, 255, 0.08);
        stroke-width: 1px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 12 12 Q 12 0 0 0";
    }

    // Inverse curve right fill (covers the right vertical border)
    if root.appearance-shape == "curved": Path {
        x: inner-rect.x + inner-rect.width - 1px;
        y: inner-rect.y + 1px;
        opacity: inner-rect.opacity;
        width: 12px;
        height: 12px;
        fill: root.notch-bg-color;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 0 0 L 0 12 Q 0 0 12 0 Z";
    }

    // Inverse curve right stroke
    if root.appearance-shape == "curved": Path {
        x: inner-rect.x + inner-rect.width - 1px;
        y: inner-rect.y + 1px;
        opacity: inner-rect.opacity;
        width: 12px;
        height: 12px;
        stroke: rgba(255, 255, 255, 0.08);
        stroke-width: 1px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 0 12 Q 0 0 12 0";
    }

    // ── CLICK-OUTSIDE BACKDROP ──
    // Full-window overlay that closes the dropdown when the user clicks outside it.
    // Covers the entire window EXCEPT the active dropdown panel area.
    // Each dropdown panel is defined AFTER this element, so has higher z-order in Slint
    // and receives clicks before this backdrop does.
    if root.show-calendar-dropdown : TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        clicked => {
            root.close-dropdowns-rust();
        }
    }
    if root.show-timer-dropdown : TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        clicked => {
            root.close-dropdowns-rust();
        }
    }
    if root.show-volume-dropdown : TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        clicked => {
            root.close-dropdowns-rust();
        }
    }
    if root.show-wifi-dropdown : TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        clicked => {
            root.close-dropdowns-rust();
        }
    }
    if root.show-topbar-stats-dropdown : TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        clicked => {
            root.close-dropdowns-rust();
        }
    }
    if root.show-clipboard-dropdown : TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        clicked => {
            root.close-dropdowns-rust();
        }
    }
    if root.show-raven-menu : TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        clicked => {
            root.close-dropdowns-rust();
        }
    }

    // ── TOP BAR STATS DROPDOWN PANEL ──
    if root.show-topbar-stats-dropdown : Rectangle {
        x: root.width - 258px;
        y: root.idle-height;
        width: 242px;
        height: 228px;
        background: root.topbar-panel-surface;
        border-radius: 10px;
        border-width: 1px;
        border-color: root.topbar-panel-border;
        drop-shadow-blur: 34px;
        drop-shadow-color: root.topbar-panel-shadow;
        drop-shadow-offset-y: 6px;
        clip: true;

        // Compact ring block, matching the reference card proportions.
        Rectangle {
            x: 14px;
            y: 16px;
            width: 92px;
            height: 92px;
            background: transparent;

            Image {
                source: root.topbar-stats-ring-img;
                width: 92px;
                height: 92px;
            }
            Path {
                width: 36px;
                height: 36px;
                x: 28px;
                y: 28px;
                stroke: #f6b94c;
                stroke-width: 2.3px;
                fill: transparent;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M3 13 H7 L10 6 L14 20 L17 13 H21";
            }
        }

        Text {
            x: 116px;
            y: 18px;
            text: round(root.cpu-pct) + "%";
            font-size: 18px;
            font-weight: 900;
            color: #f6b94c;
        }
        Text {
            x: 116px;
            y: 46px;
            text: round(root.ram-pct) + "%";
            font-size: 18px;
            font-weight: 900;
            color: #d7cfc0;
        }
        Text {
            x: 116px;
            y: 74px;
            text: round(root.gpu-pct) + "%";
            font-size: 18px;
            font-weight: 900;
            color: #d7cfc0;
        }
        Text {
            x: 171px;
            y: 20px;
            width: 48px;
            text: "CPU";
            font-size: 10px;
            font-weight: 900;
            color: #f6b94c;
            horizontal-alignment: right;
        }
        Text {
            x: 171px;
            y: 49px;
            width: 48px;
            text: "RAM";
            font-size: 10px;
            font-weight: 900;
            color: #d7cfc0;
            horizontal-alignment: right;
        }
        Text {
            x: 171px;
            y: 77px;
            width: 48px;
            text: "GPU";
            font-size: 10px;
            font-weight: 900;
            color: #d7cfc0;
            horizontal-alignment: right;
        }
        Text {
            x: 134px;
            y: 106px;
            text: "CPU";
            font-size: 7px;
            font-weight: 900;
            color: rgba(215, 207, 192, 0.48);
        }
        Text {
            x: 166px;
            y: 106px;
            text: "RAM";
            font-size: 7px;
            font-weight: 900;
            color: rgba(215, 207, 192, 0.48);
        }
        Text {
            x: 198px;
            y: 106px;
            text: "GPU";
            font-size: 7px;
            font-weight: 900;
            color: rgba(215, 207, 192, 0.48);
        }

        VerticalLayout {
            x: 16px;
            y: 122px;
            width: 212px;
            height: 98px;
            spacing: 1px;

            for item in root.process-stats: TopBarProcessRow {
                item: item;
            }
        }
    }

    // ── CLIPBOARD HISTORY DROPDOWN PANEL ──
    if root.show-clipboard-dropdown : Rectangle {
        forward-focus: search-clipboard-input;
        x: root.width - 736px;
        y: root.idle-height;
        width: 720px;
        height: 336px;
        background: root.topbar-panel-surface;
        border-radius: 10px;
        border-width: 1px;
        border-color: root.topbar-panel-border;
        drop-shadow-blur: 34px;
        drop-shadow-color: root.topbar-panel-shadow;
        drop-shadow-offset-y: 6px;
        clip: true;

        Rectangle {
            x: 280px;
            y: 56px;
            width: 1px;
            height: 236px;
            background: rgba(255, 255, 255, 0.08);
        }

        Rectangle {
            x: 0px;
            y: 56px;
            width: 100%;
            height: 1px;
            background: rgba(255, 255, 255, 0.07);
        }

        Rectangle {
            x: 0px;
            y: 292px;
            width: 100%;
            height: 1px;
            background: rgba(255, 255, 255, 0.07);
        }

        Rectangle {
            x: 14px;
            y: 12px;
            width: 252px;
            height: 32px;
            border-radius: 8px;
            background: search-clipboard-input.has-focus ? rgba(255, 255, 255, 0.09) : rgba(255, 255, 255, 0.045);
            border-width: 1px;
            border-color: search-clipboard-input.has-focus ? rgba(246, 185, 76, 0.58) : rgba(255, 255, 255, 0.10);

            Path {
                x: 10px;
                y: 9px;
                width: 14px;
                height: 14px;
                viewbox-width: 24;
                viewbox-height: 24;
                stroke: rgba(215, 207, 192, 0.62);
                stroke-width: 2.4px;
                fill: transparent;
                commands: "M10.5 18 C6.36 18 3 14.64 3 10.5 C3 6.36 6.36 3 10.5 3 C14.64 3 18 6.36 18 10.5 C18 12.34 17.34 14.02 16.24 15.32 L21 20.08 L20.08 21 L15.32 16.24 C14.02 17.34 12.34 18 10.5 18 Z";
            }

            search-clipboard-input := TextInput {
                x: 32px;
                y: 0px;
                width: 208px;
                height: 100%;
                text <=> root.clipboard-search-query;
                color: #eee7dc;
                font-size: 12px;
                font-weight: 700;
                single-line: true;
                vertical-alignment: center;
                init => {
                    self.focus();
                }
                property <int> focus-trigger <=> root.focus-clipboard-search-trigger;
                changed focus-trigger => {
                    self.focus();
                }
                key-pressed(event) => {
                    if (event.text == Key.DownArrow) {
                        if (event.modifiers.shift) {
                            if (!root.clipboard-multi-delete-mode) {
                                root.clipboard-multi-delete-mode = true;
                                root.clipboard-item-selected-mod(root.selected-clipboard-index, true, false);
                            }
                            let next-idx = Math.min(root.selected-clipboard-index + 1, root.clipboard-items.length - 1);
                            if (next-idx != root.selected-clipboard-index) {
                                root.selected-clipboard-index = next-idx;
                                root.clipboard-item-selected-mod(next-idx, true, false);
                            }
                        } else {
                            root.clipboard-select-next();
                        }
                        return accept;
                    }
                    if (event.text == Key.UpArrow) {
                        if (event.modifiers.shift) {
                            if (!root.clipboard-multi-delete-mode) {
                                root.clipboard-multi-delete-mode = true;
                                root.clipboard-item-selected-mod(root.selected-clipboard-index, true, false);
                            }
                            let prev-idx = Math.max(root.selected-clipboard-index - 1, 0);
                            if (prev-idx != root.selected-clipboard-index) {
                                root.selected-clipboard-index = prev-idx;
                                root.clipboard-item-selected-mod(prev-idx, true, false);
                            }
                        } else {
                            root.clipboard-select-prev();
                        }
                        return accept;
                    }
                    if (event.text == Key.Delete) {
                        if (root.clipboard-multi-delete-mode) {
                            root.clipboard-delete-multi-selected();
                        } else {
                            root.clipboard-delete-selected();
                        }
                        return accept;
                    }
                    if (event.text == Key.Return) {
                        root.clipboard-item-triggered(root.selected-clipboard-index);
                        return accept;
                    }
                    return reject;
                }
                edited => {
                    root.clipboard-search-changed(self.text);
                }
                accepted => {
                    root.clipboard-item-triggered(root.selected-clipboard-index);
                }

                if self.text == "" : Text {
                    x: 0px;
                    y: 0px;
                    width: 208px;
                    height: 100%;
                    text: "Type to filter entries...";
                    color: rgba(215, 207, 192, 0.46);
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        if root.clipboard-items.length > 0 : ScrollView {
            x: 8px;
            y: 66px;
            width: 264px;
            height: 216px;
            viewport-height: root.clipboard-items.length * 64px;

            Rectangle {
                width: 264px;
                height: root.clipboard-items.length * 64px;
                background: transparent;

                for header[idx] in root.clipboard-items: Text {
                    x: 6px;
                    y: header.row_y * 1px - 22px;
                    width: 250px;
                    height: 16px;
                    text: header.section;
                    color: rgba(215, 207, 192, 0.68);
                    font-size: 10px;
                    font-weight: 800;
                    vertical-alignment: center;
                }

                for item[idx] in root.clipboard-items: ClipboardHistoryRow {
                    x: 0px;
                    y: item.row_y * 1px;
                    item: item;
                    row-index: idx;
                    selected: idx == root.selected-clipboard-index;
                    multi-mode: root.clipboard-multi-delete-mode;
                    row-clicked(index) => {
                        root.selected-clipboard-index = index;
                        if (root.clipboard-multi-delete-mode) {
                            root.clipboard-item-selected-mod(index, false, true);
                        } else {
                            root.clipboard-item-selected-mod(index, false, false);
                        }
                        search-clipboard-input.focus();
                    }
                    row-right-clicked(index, x, y) => {
                        root.selected-clipboard-index = index;
                        root.clipboard-context-x = 8px + x;
                        root.clipboard-context-y = 66px + item.row_y * 1px + y;
                        root.show-clipboard-context-menu = true;
                        root.clipboard-item-context-menu(index, root.clipboard-context-x, root.clipboard-context-y);
                    }
                    row-drag-start(index, x, y) => {
                        root.selected-clipboard-index = index;
                        root.show-clipboard-drag-preview = false;
                        root.clipboard-item-drag-started(index);
                    }
                    row-drag-move(index, x, y) => {
                        root.show-clipboard-drag-preview = false;
                    }
                    row-drag-end(index) => {
                        root.show-clipboard-drag-preview = false;
                    }
                }

                for label[idx] in root.clipboard-items: Text {
                    x: 38px;
                    y: label.row_y * 1px;
                    width: 218px;
                    height: 36px;
