    in property <bool> top-bar-widgets: true;
    in property <bool> top-bar-widget-raven: true;
    in property <bool> top-bar-widget-media: true;
    in property <bool> top-bar-widget-apps: true;
    in property <bool> top-bar-widget-stats: true;
    in property <bool> top-bar-widget-clipboard: true;
    in property <bool> top-bar-widget-volume: true;
    in property <bool> top-bar-widget-wifi: true;
    in property <bool> top-bar-widget-battery: true;
    in property <bool> top-bar-widget-timer: true;
    in property <bool> top-bar-widget-calendar: true;
    in property <[SlintOpenApp]> open-apps: [];

    in-out property <bool> show-calendar-dropdown: false;
    in-out property <bool> show-timer-dropdown: false;
    in-out property <bool> show-volume-dropdown: false;
    in-out property <bool> show-wifi-dropdown: false;
    in-out property <bool> show-topbar-stats-dropdown: false;
    in-out property <bool> show-clipboard-dropdown: false;
    in-out property <int> volume-value: 50;
    in-out property <bool> is-muted: false;
    in-out property <float> timer-progress: 0.0;
    in property <string> long-date-str: "";

    property <bool> show-global-menu: false;
    in-out property <bool> show-raven-menu: false;
    property <bool> show-caffeine-menu: false;
    property <length> menu-x: 0px;
    property <length> menu-y: 0px;

    in-out property <bool> show-timer-input-panel: false;
    in-out property <string> input-h: "0";
    in-out property <string> input-m: "25";
    in-out property <string> input-s: "30";
    in-out property <bool> caffeine-keep-screen: true;

    in-out property <bool> show-timer-menu: false;
    in-out property <bool> show-clock-add-menu: false;
    in-out property <bool> show-clock-row-menu: false;
    in-out property <string> selected-clock-row: ""; // "NY", "LDN", "TKY"
    in-out property <bool> show-media-source-menu: false;
    in-out property <string> media-source: "Spotify";
    in-out property <bool> show-drop-action-menu: false;
    in-out property <int> selected-drop-item-idx: -1;
    in-out property <string> selected-drop-item-id: "";
    in-out property <string> selected-drop-item-path: "";
    property <int> close-popups-trigger: 0;

    in-out property <bool> show-ny: true;
    in-out property <bool> show-ldn: true;
    in-out property <bool> show-tky: true;
    in-out property <bool> show-del: false;
    in-out property <bool> show-syd: false;
    in-out property <bool> show-par: false;
    in-out property <bool> show-dxb: false;
    in-out property <bool> show-sin: false;

    property <[length]> expanded-wave-heights: [
        8px, 10px, 14px, 18px, 12px, 28px, 42px, 26px, 18px, 32px, 24px, 36px, 30px, 46px, 72px, 38px, 24px, 34px,
        44px, 36px, 20px, 28px, 54px, 38px, 24px, 30px, 42px, 26px, 18px, 24px, 52px, 66px, 36px, 28px, 22px, 34px,
        46px, 30px, 24px, 58px, 76px, 44px, 28px, 34px, 26px, 38px, 32px, 24px, 28px, 46px, 36px, 30px, 24px, 18px,
        14px, 12px,
        8px, 10px, 14px, 18px, 12px, 28px, 42px, 26px, 18px, 32px, 24px, 36px, 30px, 46px, 72px, 38px, 24px, 34px,
        44px, 36px, 20px, 28px, 54px, 38px, 24px, 30px, 42px, 26px, 18px, 24px, 52px, 66px, 36px, 28px, 22px, 34px,
        46px, 30px, 24px, 58px, 76px, 44px, 28px, 34px, 26px, 38px, 32px, 24px, 28px, 46px, 36px, 30px, 24px, 18px,
        14px, 12px
    ];

    property <float> wave-time: root.waveform-clock-ms;

    // Premium Color Tokens
    property <color> battery-color: battery-pct <= 20.0 ? #FF3B30 : (battery-pct < 50.0 ? #FFD700 : #00FF88);
    property <color> topbar-panel-surface: rgba(18, 18, 20, 0.88);
    property <color> topbar-panel-border: rgba(255, 255, 255, 0.14);
    property <color> topbar-panel-shadow: rgba(0, 0, 0, 0.54);
    property <color> topbar-panel-inner-surface: rgba(6, 6, 8, 0.40);

    // Dynamic visible dimensions for hit testing
    out property <length> visible-width: inner-rect.opacity > 0.0 ? inner-rect.width : 0px;
    out property <length> visible-height: inner-rect.opacity > 0.0 ? inner-rect.height : 0px;
    out property <length> visible-y: inner-rect.y;

