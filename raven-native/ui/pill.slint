    // Lists & Active Tab Navigation
    in-out property <string> active-tab: "home"; // "home", "media", "clock", "drop", "stats"
    in-out property <string> exiting-tab: "";
    in-out property <string> panel-direction: "forward";
    in property <[SlintCalendarEvent]> calendar-events;
    in property <[SlintCalendarDay]> calendar-days;
