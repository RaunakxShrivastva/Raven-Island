    in-out property <bool> show-mini-calendar: false;
    in-out property <string> picker-mode: "days";
    in-out property <int> mini-calendar-view-month: 1;
    in-out property <int> mini-calendar-view-year: 2026;
    in property <[SlintMiniCalendarDay]> mini-calendar-days: [];
    in property <[int]> mini-calendar-years: [];
    in property <[string]> mini-calendar-months: ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
    in property <string> selected-month: "";
    in property <string> selected-year: "";
